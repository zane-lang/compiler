; Stage 3's input: packages assembled from directories (docs/semantics.md §2,
; step 1 of §7).
;
; `accept` is a build that assembles. Its root package `app` has two files,
; which shows a package is its directory's files together, and a
; subdirectory and a non-source file, which show what is left out. `geometry`
; is a second package, listed after the root.
;
; `relative` is the same build run from inside `app`, naming both directories
; relatively. A package is named for the directory a path leads to, not for
; the path's last component, so `.` is still `app` and `../geometry` still
; `geometry`.
;
; `reject` is one build that fails every way assembly can. Every problem is
; reported in one run rather than the first alone (D4), and the golden file
; is what shows it: a run that stopped early would be a shorter diff.

(rule
 (deps (source_tree fixtures/accept))
 (action
  (with-stdout-to
   accept.packages.actual
   (run
    %{exe:../../bin/compiler/main.exe}
    --package fixtures/accept/app
    --package fixtures/accept/geometry))))

(rule
 (alias runtest)
 (action
  (diff golden/accept.packages accept.packages.actual)))

(rule
 (deps (source_tree fixtures/accept))
 (action
  (with-stdout-to
   relative.packages.actual
   (chdir
    fixtures/accept/app
    (run %{exe:../../bin/compiler/main.exe} --package . --package ../geometry)))))

(rule
 (alias runtest)
 (action
  (diff golden/relative.packages relative.packages.actual)))

(rule
 (deps (source_tree fixtures))
 (action
  (with-stderr-to
   reject.packages.err.actual
   (with-accepted-exit-codes
    1
    (run
    %{exe:../../bin/compiler/main.exe}
    --package fixtures/reject/mismatch
    --package fixtures/reject/missing
    --package fixtures/reject/late
    --package fixtures/reject/twice
    --package fixtures/reject/noSources
    --package fixtures/accept/geometry
    --package fixtures/reject/other/geometry
    --package fixtures/reject/third/geometry
    --package fixtures/reject/broken
    --package fixtures/reject/absent)))))

(rule
 (alias runtest)
 (action
  (diff golden/reject.packages.err reject.packages.err.actual)))

; Stage 3 proper (docs/semantics.md §3). `typed` is a build that checks: the
; root `app`, a second package `shapes` whose methods, operators and implicit
; constructors travel with its types, and the `core` fixture of D3. Its
; `--decls` view is what passes 1 to 4 resolved, and its `--tst` view the whole
; typed tree, generic instances included.
;
; `typing` is one build that fails every way the passes can report: one file
; per area in the root package `bad`, and `lib`, a dependency that reaches for
; `@program$`. As with `reject` above, the golden file is what shows every
; problem was reported in one run.

(rule
 (deps (source_tree fixtures/typed) (source_tree ../core))
 (action
  (with-stdout-to
   typed.decls.actual
   (run
    %{exe:../../bin/compiler/main.exe}
    --decls
    --package fixtures/typed/app
    --package fixtures/typed/shapes
    --package ../core))))

(rule
 (alias runtest)
 (action
  (diff golden/typed.decls typed.decls.actual)))

(rule
 (deps (source_tree fixtures/typed) (source_tree ../core))
 (action
  (with-stdout-to
   typed.tst.actual
   (run
    %{exe:../../bin/compiler/main.exe}
    --tst
    --package fixtures/typed/app
    --package fixtures/typed/shapes
    --package ../core))))

(rule
 (alias runtest)
 (action
  (diff golden/typed.tst typed.tst.actual)))

(rule
 (deps (source_tree fixtures/typing) (source_tree ../core))
 (action
  (with-stderr-to
   typing.err.actual
   (with-accepted-exit-codes
    1
    (run
     %{exe:../../bin/compiler/main.exe}
     --tst
     --package fixtures/typing/reject/bad
     --package fixtures/typing/reject/lib
     --package ../core)))))

(rule
 (alias runtest)
 (action
  (diff golden/typing.err typing.err.actual)))
