package bad;

import core$;

type Engine = #struct { power Int; }

Int same(value Int) => value
Int same(other Int) => other

Unit consume(engine Engine) => Unit()
Unit consume(engine &Engine) => Unit()

/// Neither operand is declared here.
Int +(left Int, right Bool) => left

/// A reference type is not a source a conversion may take.
implicit Int(engine Engine) => Int(1)

/// Neither end is declared here.
implicit Float(value Bool) => Float(0.0)

type Level = enum [ low, high ]

Level.weight Int {
	low = 1;
	middle = 2;
	low = 3;
}

Engine.power Int {
	low = 1;
}

Unit main(argument Int) => Unit()
