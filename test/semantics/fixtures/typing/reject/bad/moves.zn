package bad;

import core$;

type Cup = #struct { size Int; }
type Saucer = #struct { cup Cup; }
type Order = #variant { hot Cup; none Int; }

Cup(size Int) => init{ size; }
Saucer(cup Cup) => init{ cup; }

Unit drink(cup Cup) => Unit()
Unit look(cup &Cup) => Unit()
Cup brew() => Cup(Int(1))
Unit serve(first Cup, second Cup) => Unit()
Unit loop(body @concepts$Block) => Unit()

/// A host moves from a symbol, a verb's result or a case form, and from
/// nothing else (lifetimes.md §1.2).
Unit sources(saucer Saucer, cups List<Cup>, order Order, guest &Cup) {
	a Cup = brew();
	b Cup = saucer.cup;
	c Cup = cups[Int(1)];
	d Cup = guest;
	e Order = Order.hot(Cup(Int(2)));
	drink(order.hot ?? Cup(Int(3)));
	return Unit();
}

/// A symbol moves only in the block that declares it (§1.3).
Unit blocks(cup Cup) {
	outer Cup = Cup(Int(4));
	loop({
		drink(outer);
		inner Cup = Cup(Int(5));
		drink(inner);
	});
	drink(cup);
	return Unit();
}

/// A moved symbol is spent: using it again is an error until a store in its
/// own block refills it (§1.6). Passing to a `T` parameter moves (§1.8), and
/// a `&T` parameter does not.
Unit spent() {
	cup Cup = Cup(Int(6));
	look(cup);
	drink(cup);
	look(cup);
	loop({
		cup = Cup(Int(7));
	});
	cup = Cup(Int(8));
	look(cup);
	both Cup = Cup(Int(9));
	serve(both, both);
	return Unit();
}

/// A method never moves its subject.
Saucer give(this Saucer) => this
