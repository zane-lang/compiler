package bad;

type Port = #struct { n Int; }
type Plug = #struct { port &Port; }
type Frame = #struct { plug Plug; port Port; }
type Bay = #struct { plugs List<Plug>; }

Port(n Int) => init{ n; }
Plug(port &Port) => init{ port; }
Frame(plug Plug, port Port) => init{ plug; port; }
Bay() => init{ plugs = @primitives$List(Plug); }

Unit nest(body @concepts$Block) => Unit()

/// A parameter stored into a place reached from another comes to rest there
/// (lifetimes.md §1.11), and each call compares what it stores.
Unit wire(this Plug, port &Port) mut {
	this.port = port;
	return Unit();
}

/// A call that stores one parameter into another records it too.
Unit relay(this Plug, port &Port) mut {
	this!wire(port);
	return Unit();
}

Unit dock(this Bay, plug Plug) mut {
	this.plugs!push(plug);
	return Unit();
}

Unit leak(this Plug) mut {
	local Port(Int(1));
	this!wire(local);
	return Unit();
}

Unit rest() {
	far Port(Int(2));
	frame Frame(Plug(far), Port(Int(3)));
	frame.plug!wire(frame.port);
	nest({
		near Port(Int(4));
		frame.plug!wire(near);
		frame.plug!relay(near);
		spare Plug(far);
		spare!wire(near);
		frame.plug = spare;
	});
	return Unit();
}

/// `push` keeps its value in the list.
Unit queue() {
	far Port(Int(5));
	plugs List<Plug> = @primitives$List(Plug);
	plugs!push(Plug(far));
	bay Bay();
	nest({
		near Port(Int(6));
		arriving Plug(near);
		plugs!push(arriving);
		docked Plug(near);
		bay!dock(docked);
	});
	return Unit();
}
