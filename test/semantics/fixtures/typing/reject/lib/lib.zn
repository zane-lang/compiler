/// A dependency for the import checks, and the one non-root package: it may
/// not reach `@program$`.
package lib;

alias Int = @primitives$Int
alias Unit = @primitives$Unit
alias String = @primitives$String


type Thing = struct {
	value Int;
}

Int helper(value Int) => value
Int _secret() => Int(1)
Int area(this Thing) => this.value
Int twin(value Int) => value

Unit shout() {
	text String("!");
	@program$console!print(text);
	return Unit();
}
