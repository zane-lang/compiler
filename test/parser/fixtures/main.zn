/// A pocket calculator.
///
/// It builds a small expression tree, evaluates it against an environment of
/// named values, and reports what went wrong when it cannot. The program is
/// also the parser's fixture, so it reaches on purpose for most of the shapes
/// the grammar accepts: enums and the maps hung off them, variants and `match`,
/// value and reference types, the constructor forms and the calls that trail a
/// block into them, methods, operators, subscripts, lambdas, generics both
/// inferred and passed, abort handlers, `spawn`, map literals, the import
/// forms, and the block arguments everything that reads as control flow is
/// built from.
package main;

/// Every import form, since what an import writes after `import` is what the
/// file writes at the use site: the form is chosen per name, not per package.
/// `core` is a dependency like any other -- the whole-package form is what puts
/// `Int` and `Float` in scope below without a qualifier.
import core$;
import std;
import text as fmt;
import math$sqrt;
import math$Vector as Vec;
import math$[floor, ceil];

// ---------------------------------------------------------------------------
// Peers, and the tables hung off them
// ---------------------------------------------------------------------------

/// The operators the calculator understands. Peers carry no payload, so
/// everything an operator knows about itself is attached from the outside.
type Operator = enum [ add, sub, mul, div ]

/// An enum map attaches uniform external data to every member of an enum. It
/// is package-scope, exhaustive, and read field-style off the member.
Operator.symbol String {
	add = "+";
	sub = "-";
	mul = "*";
	div = "/";
}

/// A second map over the same peers: the tables are independent of each other.
Operator.precedence Int {
	add = 1;
	sub = 1;
	mul = 2;
	div = 2;
}

/// The value an operator leaves its operand untouched by, used when a fold
/// runs out of arguments.
Operator.identity Float {
	add = Float(0);
	sub = Float(0);
	mul = Float(1);
	div = Float(1);
}

/// A map may carry a verb type. Its entry list used to share a bracket with
/// the `[ ]` suffixes of the property's own type, so which one a group opened
/// could only be told after its closing bracket; the `{ }` body settles it at
/// the opening one. The entries are lambdas, since a verb has no value form.
Operator.fold Float[Float, Float] {
	add = Float(a Float, b Float) => a + b;
	sub = Float(a Float, b Float) => a - b;
	mul = Float(a Float, b Float) => a * b;
	div = Float(a Float, b Float) => a / b;
}

/// How loud a diagnostic is.
type Severity = enum [ note, warning, failure ]

Severity.label String {
	note = "note";
	warning = "warning";
	failure = "failure";
}

Severity.exitCode Int {
	note = 0;
	warning = 0;
	failure = 1;
}

// ---------------------------------------------------------------------------
// Spans and reports: value types, and the constructor forms
// ---------------------------------------------------------------------------

/// A raw type declaration names a distinct type; an alias names the same one.
/// A `Column` is its own type and does not stand in for an `Int`, while an
/// `Offset` is another spelling of one.
type Column = Int
alias Offset = Int

/// Where in the source something was written.
type Span = struct {
	start Offset;
	length Int;
}

/// A named constructor: declared and called as `Span.point(...)`, and yielding
/// the base type either way.
Span.point(start Offset) => init{ start; length = Int(1); }

/// A field constructor names its inputs and may default them.
Span{ start Offset; length Int = Int(1); } => init{ start; length; }

/// An implicit constructor is positional and takes exactly one parameter; it
/// lets a bare offset stand in wherever a `Span` is wanted.
implicit Span(start Offset) => init{ start; length = Int(1); }

/// A value subject is a mutable borrow when the method is `mut`, so this
/// writes to the caller's own span.
Unit widen(this Span, extra Int) mut {
	this.length = this.length + extra;
	return Unit();
}

/// A diagnostic, ready to be printed.
type Report = struct {
	severity Severity;
	message String;
	span Span;
}

/// A field-constructor entry may default through a constructor call.
Report{
	severity Severity;
	message String;
	span Span.point(0);
} => init{ severity; message; span; }

/// A field whose type is a verb type holds a lambda rather than a verb.
type Formatter = #struct {
	render String[Float];
}

/// An entry of a `{ }` body is terminated whatever its value looks like, so
/// the lambda's closing brace does not stand in for the `;`. This is where the
/// brace rule stops: it ends a statement, never an entry.
Formatter.plain() => init{
	render = String(value Float) {
		return String(value);
	};
}

/// Reading `.label` off `this.severity` is an enum-map access through a value
/// rather than through the member name.
String render(this Report) => this.severity.label + ": " + this.message

// ---------------------------------------------------------------------------
// The expression tree: a sum mould that leads back to itself
// ---------------------------------------------------------------------------

/// Two children and the operator between them. The children lead back to the
/// enclosing type, so the compiler boxes them; nothing is written for that.
type Operation = #struct {
	left Expr;
	right Expr;
	op Operator;
}

Operation(left Expr, right Expr, op Operator) => init{ left; right; op; }

/// A value of a variant holds exactly one of its cases at a time.
type Expr = #variant {
	number Float;
	name String;
	operation Operation;
	negation Expr;
}

// ---------------------------------------------------------------------------
// The environment: a reference type, mutated in place and lent out as a guest
// ---------------------------------------------------------------------------

/// Four named slots. `_count` is private, so only a method — a verb whose
/// first parameter is `this` — can read it.
type Environment = #struct {
	names Array<String, 4>;
	values Array<Float, 4>;
	_count Int;
}

/// Three of the four pairs start live. The last slot is left empty on
/// purpose: it is the room `bind` fills in below, so the arrays are handed
/// over with a placeholder in it.
Environment.of(names Array<String, 4>, values Array<Float, 4>) => init{
	names;
	values;
	_count = Int(3);
}

/// A subscript projects a place inside the subject and writes no return type.
(this Environment)[index Int] => this.values[index]

/// A read-only method, called with `:`. It aborts rather than returning a
/// sentinel, so every caller has to say what an unknown name means.
///
/// Counted repetition is a `mut` method on the counter handed a block, not a
/// construct: the counter is an ordinary local the block captures, and the
/// range it walks is inclusive from the first position, which is 1.
Float?String lookup(this Environment, wanted String) {
	index Int = Int(1);
	index!to(this._count) {
		// `if` is a call too: its block is the one trailing its arguments.
		if(this.names[index] == wanted) {
			return this.values[index];
		}
	}

	abort "unknown name: " + wanted;
}

/// A mutating method, declared `mut` and called with `!`.
Unit bind(this Environment, wanted String, value Float) mut {
	if(4 <= this._count) {
		std$print("environment is full");
		return Unit();
	}

	// Positions run 1 through the size, so the slot after the last live one
	// is `_count + 1`.
	this.names[this._count + 1] = wanted;
	this.values[this._count + 1] = value;
	this._count = this._count + 1;
	return Unit();
}

/// A cursor borrows the environment it walks: `&` marks a guest field, which
/// hosts nothing and must outlive nothing. The position is what the subscript
/// above is indexed by, so it carries that declaration's `Int`.
type Cursor = #struct {
	env &Environment;
	position Int;
}

Cursor(env &Environment) => init{ env; position = Int(1); }

/// Reading through a guest is ordinary access; the subscript above resolves
/// the same way it does on a host.
Float peek(this Cursor) => this.env[this.position]

// ---------------------------------------------------------------------------
// Evaluation
// ---------------------------------------------------------------------------

/// One arm per case, no default. Abort flows through a `match`, so handling
/// an arm's abort is the caller's job rather than this block's.
Float?String evaluate(node Expr, env &Environment) {
	return match (node) {
		value number => value;
		wanted name => env:lookup(wanted) ? missing {
			abort missing;
		};
		inner negation {
			value Float = evaluate(inner, env) ? missing {
				abort missing;
			}
			return ~value;
		}
		call operation {
			left Float = evaluate(call.left, env) ? missing {
				abort missing;
			}
			right Float = evaluate(call.right, env) ? missing {
				abort missing;
			}
			return apply(call.op, left, right) ? refused {
				abort refused;
			}
		}
	}
}

/// An enum scrutinee matches the same way a variant does, minus the binders.
Float?String apply(op Operator, left Float, right Float) {
	empty Bool = right == Float(0);
	if(empty '* Operator.div == op) {
		abort "division by zero";
	}

	return match (op) {
		add => left + right;
		sub => left - right;
		mul => left * right;
		div => left / right;
	}
}

/// Several scrutinees are a `,` list inside the scrutinee parentheses, and a
/// `[ ]` selector shares one arm between cases. Every combination has to be
/// covered.
Severity worst(left Severity, right Severity) => match (left, right) {
	failure, [note, warning, failure] => Severity.failure;
	[note, warning], failure => Severity.failure;
	warning, [note, warning] => Severity.warning;
	note, warning => Severity.warning;
	note, note => Severity.note;
}

/// A map read through a variable: the peer arrives as an ordinary parameter,
/// and `.symbol` finds its entry all the same.
String describe(op Operator) => "the " + op.symbol + " operator"

// ---------------------------------------------------------------------------
// Generics
// ---------------------------------------------------------------------------

/// A parameterized type declares its parameters in a `<>` header.
type Pair<T Type> = struct {
	left T;
	right T;
}

/// A constructor for one carries the applied return type instead, and picks
/// its parameter up from the first value parameter that marks it.
Pair<T>(left T Type, right T) => init{ left; right; }

/// An operator definition is a package-scope verb named after a token. It
/// never takes `this`, so it is not a method.
Pair<T> +(a Pair<T Type>, b Pair<T>) => Pair(a.left + b.left, a.right + b.right)

/// The prefix operator takes one parameter, and flips a composite one
/// component at a time.
Pair<T> ~(value Pair<T Type>) => Pair(~value.left, ~value.right)

/// A verb introduces a number parameter the same way, inside a parameter's
/// own type.
T first(values Array<T Type, n Number>) => values[1]

/// A concept-typed parameter accepts a source literal and lowers it.
String quote(text @concepts$Text) => "\"" + String(text) + "\""

/// A map literal carries `@concepts$Map<K, V>` the way an array literal
/// carries `@concepts$Array<T, n>`, and is lowered by whatever consumes it.
Unit record(entries @concepts$Map<String, Float>) {
	return Unit();
}

/// A type parameter reaches a verb one of two ways. Every generic above uses
/// the inferred one, where the parameter rides on a value parameter's type and
/// the arguments fix it. This is the other: the parameter *is* the value
/// parameter, of concept type `Type`, so the call writes a type where a value
/// goes. Types are compile-time values, which is what makes that an ordinary
/// argument rather than a second kind of bracket at the call.
type Slots<T Type, n Number> = struct {
	items Array<T, n>;
}

Slots<T, n>(T Type, n Number) => init{ items = Array(T, n); }

// ---------------------------------------------------------------------------
// Retrying: constructors that take the last argument after the `)`
// ---------------------------------------------------------------------------

/// A verb declaring a `@concepts$Block` parameter is how a package that is not
/// `core` writes control flow of its own. A constructor may declare one too,
/// since a constructor is an ordinary call -- so its last argument trails the
/// `)` the way a function call's does.
type Retry = struct {
	attempts Int;
}

Retry(attempts Int, body @concepts$Block) {
	@controlflow$repeat(attempts, body);
	return init{ attempts; }
}

/// A named constructor takes one on the same terms.
Retry.upTo(limit Int, body @concepts$Block) {
	@controlflow$repeat(limit, body);
	return init{ attempts = limit; }
}

/// The other `{ }` that may trail a call is a map literal, so a constructor
/// whose last parameter is a map takes one there.
type Snapshot = #struct {
	label String;
	taken Map<String, Float>;
}

Snapshot(label String, taken @concepts$Map<String, Float>) => init{ label; taken; }

// ---------------------------------------------------------------------------
// Reporting
// ---------------------------------------------------------------------------

/// A branching chain. Nothing here is grammar: `guard` is a verb over the exit
/// intrinsic, and `if`, `elif` and `else` are verbs taking a block. The chain
/// is held together by the `Bool` the first one returns and the later ones
/// read, so it is a run of ordinary calls rather than one construct.
///
/// The `elif` condition is written as a block, which picks the overload that
/// defers it: it runs only if no earlier branch matched.
Unit announce(entry Report) {
	guard(entry.span.length < 1);

	ran Bool = if(Severity.failure == entry.severity) {
		std$print("stopped: " + entry:render());
	}
	ran!elif({ resolve Severity.warning == entry.severity; }) {
		std$print("carrying on: " + entry:render());
	}
	ran:else() {
		std$print(entry:render());
	}

	return Unit();
}

// ---------------------------------------------------------------------------
// The program
// ---------------------------------------------------------------------------

Unit main() {
	// The instantiation shorthand: a declaration that is its own initializer.
	env Environment.of(
		Array(["x", "y", "z", ""]),
		Array([Float(3), Float(4), Float(0), Float(0)])
	);

	// `!` calls a mutating method, `:` a read-only one.
	env!bind("answer", Float(42));

	// Construction nests: naming a case takes its payload whole, so a whole
	// tree is one expression. This one reads `x + y * 2`.
	program Expr = Expr.operation(Operation(
		Expr.name("x"),
		Expr.operation(Operation(Expr.name("y"), Expr.number(Float(2)), Operator.mul)),
		Operator.add
	));

	// An abortable call is handled where it is made, and every path out of
	// the handler is a `resolve`, a `return`, or an `abort`.
	result Float = evaluate(program, &env) ? failure {
		entry Report{ severity = Severity.failure; message = failure; }
		announce(entry);
		resolve Float(0);
	}

	// `??` is the resolve-only shorthand for the same thing.
	answer Float = env:lookup("answer") ?? Float(0);

	// Reading a variant's member can fail too, since the case may not be the
	// live one, so it takes a handler the same way.
	literal Float = program.number ?? Float(0);

	// A lambda-variable is an ordinary symbol whose type is a function type.
	blend Float[Float, Float] = Float(a Float, b Float) => (a + b) / Float(2);

	// The same declaration, in the shorthand that drops the `= literal`.
	double Float(value Float) => value * Float(2);

	// The same shorthand with a block body. It is a declaration either way, so
	// what decides the terminator is the shape of the body, not the form.
	clamp Float(value Float) {
		return value;
	}

	middle Float = double(blend(result, answer));

	reading String = describe(Operator.mul);

	// A map literal is a `{ }` body of `;`-terminated `key, value` entries. It
	// carries no introducing token, so what tells it from a block argument is
	// the mark after its first expression.
	labels Map<String, Float> = {
		"x", Float(3);
		"y", Float(4);
	}

	// The same literal in argument position, and again trailing the call.
	record({ "z", Float(0); });
	record() {
		"answer", answer;
	}

	// A constructor call trails its last argument the way any other call does,
	// and the instantiation shorthand writes the symbol in front of the same
	// call. A named constructor takes one on the same terms.
	retried Retry(2) {
		std$print("retrying");
	}
	capped Retry.upTo(3) {
		std$print("capped at " + String(retried.attempts));
	}

	// The same call written in full. It ends on the `)` rather than a `}`, so
	// this spelling is the one that carries the terminator.
	direct Retry(1, { std$print("once"); });

	// A bare call statement trails one too, and the map literal is the other
	// `{ }` that may take the position.
	Retry(1) {
		std$print("dropped");
	}
	taken Snapshot("final") {
		"x", Float(3);
		"y", Float(4);
	}

	// What may not trail is an argument list with nothing left inside it:
	// `Retry() { ... }` is a lambda literal returning a `Retry`, which is what
	// the next line declares.
	make Retry() {
		return Retry(1, { std$print("made"); });
	}

	// `Int` is written where a value goes, and `4` beside it: the explicit
	// half of the generic parameters, passed rather than inferred.
	room Slots(Int, 4);

	// Both maps again, in a context that wants an `Int` rather than a String.
	spread Int = Operator.mul.precedence - Operator.add.precedence;

	// A subscript expression reaches through the declaration above, and the
	// counted repetition is inclusive at both ends, and starts at 1.
	total Float = Float(0);
	index Int = Int(1);
	index!to(4) {
		total = total + env[index];
	}

	// A guest of the environment, walked without ever hosting it.
	walker Cursor(&env);

	// Comparisons are ordinary calls, and `Bool` joins them with the same
	// operators every other type uses: `*` for conjunction, `+` for disjunction.
	// The loose forms let the comparisons close first, so `'*` binds tighter
	// than `'+` exactly as `*` does than `+`.
	settled Bool = Float(0) < middle '* middle < Float(100) '+ answer == Float(42);

	// An implicit constructor covers the `span` field from a bare offset.
	summary Report{ severity = Severity.note; message = "read four slots"; span = Int(3); }
	loudest Severity = worst(summary.severity, Severity.warning);

	// An assignment ends in a brace too, and takes no terminator for the same
	// reason a declaration does not.
	total = match (loudest) {
		note => total;
		warning => total;
		failure => Float(0);
	}
	announce(summary);

	// A value type is mutated through the caller's own slot.
	mark Span.point(12);
	mark!widen(spread);

	// Both operator definitions above, on one expression.
	shifted Pair<Int> = ~Pair(spread, mark.length) + Pair(1, 1);

	// The compiler namespaces are reachable where a machine type is meant.
	bits @primitives$I64(loudest.exitCode);

	head String = first(Array(["x", "y", "z", ""]));
	std$print(quote(head));
	std$print(reading);
	std$print(walker:peek());
	std$print(shifted.left);
	std$print(bits);
	std$print(capped.attempts);
	std$print(direct.attempts);
	std$print(taken.label);
	std$print(make().attempts);
	std$print(room.items[1]);

	// The other way into a map: straight off the member name.
	std$print(Operator.add.identity);

	// `spawn` starts a call concurrently; an abortable one still handles here.
	spawn std$print(total);
	spawn evaluate(program, &env) ?? Float(0);

	if(settled) {
		std$print("settled");
		return Unit();
	}

	std$print("unsettled");
	return Unit();
}
