; Every node's span, read back out of the source it points at.
;
; `span_dump --cst` prints one line per node: the node's kind and the text
; between its span's two positions. `span_dump --sst` does the same over the
; desugared tree and prints each node's variant as well, so its expectations
; show the rewrites of docs/desugaring.md having happened and not merely that
; spans survived them.
;
; What these are for: a span is only ever wrong by pointing somewhere, and the
; rest of the suite cannot see where. The acceptance tests ask whether a file
; parses, and the grouping tests ask which shape it parsed to -- neither reads
; a position. So a grammar change that widens a span to swallow a binder, or
; narrows one past its own bracket, passes everything and is noticed only in
; review, if at all.
;
; A failing diff is not by itself a bug: a change to the grammar, the fixture
; or the lowering is expected to move these. Read the diff, satisfy yourself
; that each moved span still covers what its node stands for and that each
; rewrite still produces the shape it should, and promote it with
; `dune promote`.
;
; Three fixtures. `main.zn` is the one the parser suite already reaches for,
; and it covers the breadth of the grammar. `fixtures/utf8.zn` covers the one input
; class it does not: spans are byte offsets, and while a file is ASCII a
; code-point offset is indistinguishable from a byte one. They diverge at the
; first multibyte character and every span after it shifts -- which is exactly
; the bug found on #86, after the suite had been green through it.
;
; `fixtures/desugar.zn` is the third, and unlike the other two it was written for these
; tests: every rewrite in docs/desugaring.md 2 appears in it at least once.
; The other two do not manage that -- `main.zn` reaches only two of the five
; derived operators, so three of them had no expectation anywhere.

(rule
 (with-stdout-to
  main.cst.spans.actual
  (run %{exe:../../tools/parser/span_dump.exe} --cst %{dep:fixtures/main.zn})))

(rule
 (alias runtest)
 (action
  (diff golden/main.cst.spans main.cst.spans.actual)))

(rule
 (with-stdout-to
  utf8.cst.spans.actual
  (run %{exe:../../tools/parser/span_dump.exe} --cst %{dep:fixtures/utf8.zn})))

(rule
 (alias runtest)
 (action
  (diff golden/utf8.cst.spans utf8.cst.spans.actual)))

(rule
 (with-stdout-to
  desugar.cst.spans.actual
  (run %{exe:../../tools/parser/span_dump.exe} --cst %{dep:fixtures/desugar.zn})))

(rule
 (alias runtest)
 (action
  (diff golden/desugar.cst.spans desugar.cst.spans.actual)))

(rule
 (with-stdout-to
  main.sst.spans.actual
  (run %{exe:../../tools/parser/span_dump.exe} --sst %{dep:fixtures/main.zn})))

(rule
 (alias runtest)
 (action
  (diff golden/main.sst.spans main.sst.spans.actual)))

(rule
 (with-stdout-to
  utf8.sst.spans.actual
  (run %{exe:../../tools/parser/span_dump.exe} --sst %{dep:fixtures/utf8.zn})))

(rule
 (alias runtest)
 (action
  (diff golden/utf8.sst.spans utf8.sst.spans.actual)))

(rule
 (with-stdout-to
  desugar.sst.spans.actual
  (run %{exe:../../tools/parser/span_dump.exe} --sst %{dep:fixtures/desugar.zn})))

(rule
 (alias runtest)
 (action
  (diff golden/desugar.sst.spans desugar.sst.spans.actual)))

; The two structure renderings, which name every field rather than printing a
; span. `lib/cst/to_tree_graph.ml` had no test of any kind before this -- five
; hundred lines reached only by the compiler binary -- and its SST counterpart
; would have inherited that. Rendering one fixture through each covers both.
;
; Reading them side by side is also the clearest statement of what the
; desugaring does: the SST rendering is the CST one with `parenthized`,
; `ret_shorthand`, `var_decl_shorthand`, `trailing` and one of the two call
; groups gone.

(rule
 (with-stdout-to
  desugar.cst.tree.actual
  (run %{exe:../../bin/compiler/main.exe} --cst %{dep:fixtures/desugar.zn})))

(rule
 (alias runtest)
 (action
  (diff golden/desugar.cst.tree desugar.cst.tree.actual)))

(rule
 (with-stdout-to
  desugar.sst.tree.actual
  (run %{exe:../../bin/compiler/main.exe} --sst %{dep:fixtures/desugar.zn})))

(rule
 (alias runtest)
 (action
  (diff golden/desugar.sst.tree desugar.sst.tree.actual)))

; The conflict census of docs/ambiguity/proof-obligations.md, read from the
; explanations file the parser's own build writes. That file is the shipped
; parser's: Menhir in `--GLR` mode rewrites the grammar before building the
; automaton, so a stock `menhir --explain` counts a different set of states.
;
; A grammar change that adds, removes or moves a conflict state moves this, and
; a moved census is a ledger change: update the table and the counts in
; proof-obligations.md to match, then promote with `dune promote`.

(rule
 (with-stdout-to
  parser.conflicts.census.actual
  (run
   python3
   %{dep:../../tools/ambiguity/conflict_census.py}
   %{dep:../../lib/cst/parser.conflicts})))

(rule
 (alias runtest)
 (action
  (diff golden/parser.conflicts.census parser.conflicts.census.actual)))

; The same census of the stock automaton -- the grammar as written, with no
; `--GLR` rewrite -- which is the one `just explain` and the ambiguity tools
; read, and the one the ledger's family table is tallied on.

(rule
 (copy ../../lib/cst/parser.mly stock.mly))

(rule
 (targets stock.conflicts)
 (action
  (run %{bin:menhir} --no-code-generation --explain %{dep:stock.mly})))

(rule
 (with-stdout-to
  stock.conflicts.census.actual
  (run
   python3
   %{dep:../../tools/ambiguity/conflict_census.py}
   %{dep:stock.conflicts})))

(rule
 (alias runtest)
 (action
  (diff golden/stock.conflicts.census stock.conflicts.census.actual)))
