/// Scalars and calls: `Int`, `Float` and `Bool` arithmetic, verbs calling
/// verbs, and block-taking verbs -- `if`, `elif`, `else` and `to`, declared
/// here -- expanded where they are called.
package counting;

alias Int = @primitives$Int
alias Float = @primitives$Float
alias Bool = @primitives$Bool
alias Unit = @primitives$Unit
alias String = @primitives$String

/// Runs the block when the condition holds, and reports whether it did.
Bool if(condition Bool, body @concepts$Block) {
	@controlflow$branch(condition, body);
	return condition;
}

/// Runs when no earlier branch of the chain has, and records whether it did.
Unit elif(this Bool, condition Bool, body @concepts$Block) mut {
	@controlflow$branch(~this * condition, body);
	this = this + condition;
	return Unit();
}

Unit else(this Bool, body @concepts$Block) {
	@controlflow$branch(~this, body);
	return Unit();
}

/// Advances the counter through the inclusive range, running the block once
/// per step.
Unit to(this Int, end Int, body @concepts$Block) mut {
	@controlflow$repeat(end + ~this + Int(1), {
		@controlflow$branch(true, body);
		this = this + Int(1);
	});
	return Unit();
}

/// The sum of 1 through `n`, counted with `to`.
Int triangle(n Int) {
	total Int(0);
	i Int(1);
	i!to(n) {
		total = total + i;
	}
	return total;
}

/// Leaves the verb from inside a block argument.
Int smallest(a Int, b Int) {
	if(a < b) {
		return a;
	}
	return b;
}

Int factorial(n Int) {
	if(n < Int(2)) {
		return Int(1);
	}
	return n * factorial(n + ~Int(1));
}

Unit main() {
	yes String("yes\n");
	no String("no\n");
	dot String(".");
	line String("\n");

	// Arithmetic on each scalar.
	ran Bool = if(triangle(Int(10)) == Int(55)) {
		@program$console!print(yes);
	}
	ran:else() {
		@program$console!print(no);
	}
	if(factorial(Int(10)) == Int(3628800)) {
		@program$console!print(yes);
	}
	if((Int(7) / Int(2) == Int(3)) * (Int(2) < Int(3))) {
		@program$console!print(yes);
	}
	if(Float(1.5) + Float(2.25) == Float(3.75)) {
		@program$console!print(yes);
	}
	if(~(Float(1.0) / Float(4.0) < Float(0.25))) {
		@program$console!print(yes);
	}

	// A chain: only the first branch that holds runs.
	chain Bool = if(smallest(Int(4), Int(9)) == Int(9)) {
		@program$console!print(no);
	}
	chain!elif(smallest(Int(4), Int(9)) == Int(4)) {
		@program$console!print(yes);
	}
	chain!elif(true) {
		@program$console!print(no);
	}
	chain:else() {
		@program$console!print(no);
	}

	// Nested counting: three rows of four dots.
	row Int(1);
	row!to(Int(3)) {
		column Int(1);
		column!to(Int(4)) {
			@program$console!print(dot);
		}
		@program$console!print(line);
	}
	return Unit();
}
