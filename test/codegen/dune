; Stages 4 and 6: lowering and codegen (docs/lowering.md).
;
; `hello` is lowered and printed as its code-generation tree, then built into
; an executable and run: the golden files hold the tree and what the program
; wrote. The module's own text is not a golden file, since it is LLVM's to
; print and changes with the LLVM release.

(rule
 (deps (source_tree fixtures/hello))
 (action
  (with-stdout-to
   hello.cgt.actual
   (run %{exe:../../bin/compiler/main.exe} --cgt --package fixtures/hello))))

(rule
 (alias runtest)
 (action
  (diff golden/hello.cgt hello.cgt.actual)))

(rule
 (deps (source_tree fixtures/hello))
 (targets hello.exe)
 (action
  (run %{exe:../../bin/compiler/main.exe} --build hello.exe --package fixtures/hello)))

(rule
 (action
  (with-stdout-to
   hello.out.actual
   (run ./hello.exe))))

(rule
 (alias runtest)
 (action
  (diff golden/hello.out hello.out.actual)))

; `temporary` is hello written without storing the view first. Semantics
; rejects it before lowering starts.

(rule
 (deps (source_tree fixtures/temporary))
 (action
  (with-stderr-to
   temporary.err.actual
   (with-accepted-exit-codes
    1
    (run %{exe:../../bin/compiler/main.exe} --build temporary.exe --package fixtures/temporary)))))

(rule
 (alias runtest)
 (action
  (diff golden/temporary.err temporary.err.actual)))

; `counting` is step 2 of docs/lowering.md §8: `core`'s scalars, verbs that
; call verbs, and `if`, `elif`, `else` and `to` expanded where they are
; called. Every check it makes prints `yes` when it holds.

(rule
 (deps (source_tree fixtures/counting) (source_tree ../core))
 (action
  (with-stdout-to
   counting.cgt.actual
   (run
    %{exe:../../bin/compiler/main.exe}
    --cgt
    --package fixtures/counting
    --package ../core))))

(rule
 (alias runtest)
 (action
  (diff golden/counting.cgt counting.cgt.actual)))

(rule
 (deps (source_tree fixtures/counting) (source_tree ../core))
 (targets counting.exe)
 (action
  (run
   %{exe:../../bin/compiler/main.exe}
   --build
   counting.exe
   --package fixtures/counting
   --package ../core)))

(rule
 (action
  (with-stdout-to
   counting.out.actual
   (run ./counting.exe))))

(rule
 (alias runtest)
 (action
  (diff golden/counting.out counting.out.actual)))

; `zero` divides by zero: the program stops with status 1 after what it
; wrote so far, and says why on stderr.

(rule
 (deps (source_tree fixtures/zero) (source_tree ../core))
 (targets zero.exe)
 (action
  (run
   %{exe:../../bin/compiler/main.exe}
   --build
   zero.exe
   --package fixtures/zero
   --package ../core)))

(rule
 (action
  (with-outputs-to
   zero.out.actual
   (with-accepted-exit-codes
    1
    (run ./zero.exe)))))

(rule
 (alias runtest)
 (action
  (diff golden/zero.out zero.out.actual)))
