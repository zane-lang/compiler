; The runtime on its own (docs/lowering.md L17): `arenas.c`, `anchors.c`,
; `texts.c` and `blocks.c` include it and exercise the scope arenas, the
; anchors, the strings, and the lists and boxes directly, and the golden files
; hold what each printed.

(rule
 (deps arenas.c ../../runtime/zane.c)
 (targets arenas.exe)
 (action
  (run clang -std=c11 -Wall -Wextra -Werror -O2 -o arenas.exe arenas.c)))

(rule
 (action
  (with-stdout-to
   arenas.out.actual
   (run ./arenas.exe))))

(rule
 (alias runtest)
 (action
  (diff arenas.out arenas.out.actual)))

