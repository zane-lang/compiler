/// `Bool`, over `@primitives$Bool`. It implements the three operators of a
/// Boolean algebra and equality, and nothing else (operators.md §2.4).
package core;

type Bool = struct {
	raw @primitives$Bool;
}

/// `true` and `false` are storage primitives, so this is how they become a
/// `Bool` at a coercion site.
implicit Bool(raw @primitives$Bool) => init{ raw; }

/// What carries a condition into `@controlflow$branch` (types.md §4.4).
implicit @primitives$Bool(value Bool) => value.raw

Bool *(left Bool, right Bool) => Bool(left.raw * right.raw)
Bool +(left Bool, right Bool) => Bool(left.raw + right.raw)
Bool ==(left Bool, right Bool) => Bool(left.raw == right.raw)
Bool ~(value Bool) => Bool(~value.raw)
