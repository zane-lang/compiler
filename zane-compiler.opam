# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Compiler and CLI for the Zane programming language"
description: """
The Zane compiler, zanec: a sedlex lexer and a Menhir GLR grammar producing
a concrete syntax tree, desugaring into the SST, semantic analysis into the
typed TST, lowering into the CGT, LLVM code generation, and the C runtime
linked into every program. Also the developer tooling used to keep the grammar
unambiguous."""
maintainer: ["Manuel Stieger"]
authors: ["Manuel Stieger"]
license: "GPL-3.0-only"
tags: ["compiler" "zane" "parser" "menhir" "ocaml"]
homepage: "https://github.com/zane-lang/compiler"
bug-reports: "https://github.com/zane-lang/compiler/issues"
depends: [
  "dune" {>= "3.21"}
  "ocaml" {>= "5.1"}
  "menhir" {>= "20260122"}
  "menhirGLR"
  "sedlex"
  "llvm"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/zane-lang/compiler.git"
x-maintenance-intent: ["(latest)"]
