#!/usr/bin/env bash
# Idempotently provision the OCaml packages the project builds with.
#
# The environment (pixi's, through `pixi run setup`, or devbox's shell)
# supplies opam and the system OCaml compiler; dune, menhir, sedlex, uucp
# and uuseg are opam packages, installed here into a switch in the
# repository's directory, so a fresh environment has none of them on PATH
# until this script has run once. LLVM's OCaml bindings are built from
# vendor/llvm-ocaml with the compiler (lib/llvm), so they are not among
# them.
#
# Versions are pinned here rather than resolved freshly on every run: an
# unpinned `opam install` lets a repository update silently change parser
# generation. Bump these deliberately.
set -euo pipefail

DUNE_VERSION="3.24.2"
MENHIR_VERSION="20260209"
SEDLEX_VERSION="3.8.1"
# Unicode properties and grapheme segmentation, which the diagnostic renderer
# measures a source line's width with (lib/diagnostic/render.ml). Each uuseg
# release requires the uucp of the same Unicode version, so the two move
# together.
UUCP_VERSION="18.0.0"
UUSEG_VERSION="18.0.0"

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
export OPAMYES=1

# menhirGLR ships inside the menhir package, so it needs no separate pin.
packages=(
	"dune.$DUNE_VERSION"
	"menhir.$MENHIR_VERSION"
	"sedlex.$SEDLEX_VERSION"
	"uucp.$UUCP_VERSION"
	"uuseg.$UUSEG_VERSION"
)

case "$(uname -s)" in
MINGW* | MSYS* | CYGWIN*) windows=1 ;;
*) windows=0 ;;
esac

if ! command -v opam >/dev/null 2>&1; then
	echo "bootstrap-toolchain: opam is not on PATH; run this through \`pixi run setup\`" >&2
	exit 1
fi

if [[ $windows == 1 ]]; then
	# OCaml's MSVC build links through MSVC's link.exe, which coreutils'
	# `link` (Git Bash's /usr/bin, opam's Cygwin) shadows.
	if ! cl=$(command -v cl); then
		echo "bootstrap-toolchain: MSVC's cl is not on PATH; install Visual Studio's C++ tools" >&2
		exit 1
	fi
	PATH="$(dirname "$cl"):$PATH"
fi

if [[ ! -d "${OPAMROOT:-$HOME/.opam}" ]]; then
	init=(--bare --disable-sandboxing -y)
	# On Windows opam runs its packages' build commands in a Cygwin of its
	# own.
	if [[ $windows == 1 ]]; then init+=(--cygwin-internal-install); fi
	opam init "${init[@]}"
fi

# On Windows, opam's conf-msvc64 searches for Visual Studio with
# msvs-detect, which may find none even where MSVC is set up; the
# repository's own conf-msvc64 and ocaml-env-msvc64 (dev/setup/opam-repo)
# take the environment's MSVC as it is, and its repository comes first.
repos=(default)
if [[ $windows == 1 ]]; then
	opam repository add zane "$ROOT/dev/setup/opam-repo" --dont-select ||
		opam repository set-url zane "$ROOT/dev/setup/opam-repo"
	repos=(zane default)
fi

# `--no-install` keeps a local switch from installing the repository's own opam
# package. That would resolve the newest dune rather than the pin below and
# build the compiler as an opam package, only for the pins to be installed over
# it -- the whole toolchain built twice on a cold switch.
if ! opam switch list --short | grep -Fxq "$ROOT"; then
	opam switch create "$ROOT" ocaml-system --repos="$(IFS=,; echo "${repos[*]}")" --no-install -y
fi

# On Windows opam env writes PATH in Windows' form, which Git Bash does not
# read: the switch's bin directory goes on PATH directly, and the rest of
# what opam env sets is taken as it is.
if [[ $windows == 1 ]]; then
	export OPAMSWITCH="$ROOT"
	eval "$(opam env --switch="$ROOT" --shell=sh | grep -v '^PATH=')"
	PATH="$(cygpath -u "$(opam var bin)"):$PATH"
	export PATH
else
	eval "$(opam env --switch="$ROOT" --set-switch)"
fi

# Only reinstall when a pinned package is missing or at the wrong version, so
# entering the shell stays fast once the switch is warm. `--no-depexts`
# because the environment, not the system's package manager, supplies what
# the packages build with.
needed=()
for package in "${packages[@]}"; do
	name="${package%%.*}"
	version="${package#*.}"
	if [[ "$(opam show --field=installed-version "$name" 2>/dev/null)" != "$version" ]]; then
		needed+=("$package")
	fi
done

if ((${#needed[@]} > 0)); then
	opam install -y --no-depexts "${needed[@]}"
fi
