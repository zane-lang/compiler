#!/usr/bin/env bash
# Check a release archive on the platform it is for, with nothing of the
# environment that built it: extract it, move it to a path with spaces, and
# build and run a program with it plain, optimized and tiered, for the host.
# Every platform's release is checked by this script alike (compiler-dist.yml);
# Linux's runs in a bare container, which also keeps the build machine's
# loader, LLVM and C toolchain from it.
set -euo pipefail
# A failing check names itself; most of them print nothing on their own.
trap 'echo "check-archive: line $LINENO failed: $BASH_COMMAND" >&2' ERR
archive=${1:?usage: check-archive ARCHIVE OUTPUT SOURCE}
out=${2:?usage: check-archive ARCHIVE OUTPUT SOURCE}
source=${3:?usage: check-archive ARCHIVE OUTPUT SOURCE}
golden="$source/tests/codegen/golden/hello.out"
case "$(uname -s)" in
MINGW* | MSYS* | CYGWIN*) exe=.exe library=.dll ;;
Darwin) exe= library=.dylib ;;
*) exe= library=.so ;;
esac
mkdir -p "$out"
tar -xzf "$archive" -C "$out"
root=$(find "$out" -mindepth 1 -maxdepth 1 -type d -name 'zane-compiler-*')
test -n "$root"
# Exercise relocation and spaces in the compiler path, not the build checkout.
mv "$root" "$out/toolchain with spaces"
root="$out/toolchain with spaces"
zanec="$root/bin/zanec$exe"
test -f "$zanec"
cp -R "$source/tests/codegen/fixtures/hello" "$out/hello"
# Every build below links a runtime the release bundles with the linker
# command and files the release bundles for it, so no C compiler runs: nothing
# is compiled into the cache, nor asked for, and Zig never makes its cache.
# The cache holds only the tier-1 libraries a tiered build keeps
# (docs/design/tiers.md). Neither ZANE_CC nor ZIG is set, so the compiler
# takes the archive's own toolchain.
unset ZANE_CC ZIG ZANE_RUNTIME_OBJECTS
export ZANE_CACHE_DIR="$out/cache" ZIG_GLOBAL_CACHE_DIR="$out/zig-cache" ZIG_LOCAL_CACHE_DIR="$out/zig-cache"
test "$(find "$root/share/runtime" -maxdepth 1 -name '*.o' | wc -l)" -eq 12
# The optimized runtime's bitcode for each target, which an optimized build
# links whole into its module (docs/design/lowering.md §7).
test "$(find "$root/share/runtime" -maxdepth 1 -name '*.bc' -size +0 | wc -l)" -eq 6
# A program's link for each target and level, and an optimized shared
# library's for each target, tier 1's.
test "$(find "$root/share/runtime/link" -maxdepth 1 -type f | wc -l)" -eq 18
for optimization in plain optimized; do
	# macOS's bash 3.2 takes an empty array for unset, so the flag goes in
	# the positional parameters, which may be empty.
	set --
	[[ "$optimization" != optimized ]] || set -- --optimize
	"$zanec" "$@" --build "$out/hello-$optimization$exe" --package "$out/hello"
	"$out/hello-$optimization$exe" | tr -d '\r' > "$out/hello-$optimization.out"
	cmp "$golden" "$out/hello-$optimization.out"
done
# Tiered: tier 0 and tier 1, tier 1 loaded before `main`.
"$zanec" --build "$out/hello-tiered$exe" --tiered --package "$out/hello"
"$zanec" --tier-up "$out/hello-tiered.tier1$library" --package "$out/hello"
ZANE_TIER_UP="$out/hello-tiered.tier1$library" ZANE_TIER_WAIT=1 ZANE_TIER_LOG=1 "$out/hello-tiered$exe" \
	2> "$out/hello-tiered.log" | tr -d '\r' > "$out/hello-tiered.out"
cmp "$golden" "$out/hello-tiered.out"
# The output alone does not show tier 1 ran: tier 0 prints the same.
# Every function is tier 1's: `runs N of N`. The numbers are compared in
# the shell, since a backreference in an extended pattern is GNU's alone.
said=$(sed -n 's/^zane: tier 1 runs \([0-9][0-9]*\) of \([0-9][0-9]*\) functions.*$/\1 \2/p' "$out/hello-tiered.log" | tr -d '\r')
[[ -n "$said" && "${said% *}" == "${said#* }" ]] || { cat "$out/hello-tiered.log" >&2; false; }
unexpected=$(find "$ZANE_CACHE_DIR" -mindepth 1 -maxdepth 1 ! -name tier)
[[ -z "$unexpected" ]] || { printf 'check-archive: the cache holds %s\n' "$unexpected" >&2; false; }
test ! -e "$out/zig-cache"
echo "Relocated compiler built and ran plain, optimized and tiered programs with its bundled runtimes and links, running no C compiler"
