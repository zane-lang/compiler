#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

# `__engine` is the private entry point tools/ambiguity/cli.py re-enters to reach
# the engine with the machine configuration loaded and the executable built. It
# is not part of the command-line interface; use the subcommands instead.
if [[ "${1:-}" == "__engine" ]]; then
	shift
	# shellcheck source=../lib/ambiguity-config.sh
	. "$ROOT/dev/lib/ambiguity-config.sh"
	dune build --root "$ROOT" tools/ambiguity/ambiguity_search.exe
	exec "$ROOT/_build/default/tools/ambiguity/ambiguity_search.exe" \
		"$ROOT/lib/cst/parser.mly" \
		"$@"
fi

exec python3 "$ROOT/tools/ambiguity/cli.py" "$@"
