#!/usr/bin/env bash
set -euo pipefail

# Print a random concrete sentence the grammar accepts, as a starting point for
# a hand-written parser case.
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
# shellcheck source=../lib/menhir.sh
. "$ROOT/dev/lib/menhir.sh"

exec "$MENHIR" "$ROOT/lib/cst/parser.mly" \
	--random-sentence-concrete package \
	--random-seed 1 \
	--random-sentence-length 16 \
	"$@"
