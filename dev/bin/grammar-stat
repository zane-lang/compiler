#!/usr/bin/env bash
set -euo pipefail

# Report statistics for the grammar.
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
# shellcheck source=../lib/ambiguity-config.sh
. "$ROOT/dev/lib/ambiguity-config.sh"

exec "$AMBIGUITY_MENHIR" "$ROOT/lib/cst/parser.mly" \
	--no-code-generation \
	--infer \
	"$@"
