#!/usr/bin/env bash
set -euo pipefail

# Find a concrete sentence that reaches a grammar conflict.
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
# shellcheck source=../lib/ambiguity-config.sh
. "$ROOT/dev/lib/ambiguity-config.sh"

exec "$AMBIGUITY_MENHIR" "$ROOT/lib/cst/parser.mly" \
	--random-sentence-concrete package \
	--random-seed 1 \
	--random-sentence-length 16 \
	"$@"
