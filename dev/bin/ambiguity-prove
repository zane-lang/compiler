#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
# shellcheck source=../lib/ambiguity-config.sh
. "$ROOT/dev/lib/ambiguity-config.sh"

dune build --root "$ROOT" tools/ambiguity_search.exe
exec "$ROOT/_build/default/tools/ambiguity_search.exe" \
	"$ROOT/lib/cst/parser.mly" \
	--prove 2 \
	--max-tokens 12 \
	--timeout 120 \
	"$@"
