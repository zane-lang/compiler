#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
CALLER="$PWD"

# Dune runs from the project root, so a relative path would otherwise be
# resolved against the root rather than the directory the caller is in. Every
# argument that names a file or directory is expanded against the caller's
# directory before changing to the root, whether or not it exists: a path that
# does not exist has to reach the compiler as the caller wrote it, so the error
# names the file they meant rather than one that happens to sit at the root.
# Everything else (option names, targets, sizes, stamps, package names) passes
# through unchanged. Which argument is which follows zanec's own parser
# (bin/zanec/zanec.ml, `arguments`).

# One path, made absolute against the caller's directory.
expand() {
	case "$1" in
		/* | '') printf '%s' "$1" ;;
		*) printf '%s' "$CALLER/$1" ;;
	esac
}

# `--package [[STAMP]PATH=]DIR`: only DIR is a path. What comes before the
# first `=` names the package only when zanec would read it as a package id
# (`package_id` in bin/zanec/zanec.ml): an optional stamp, then lower-case
# identifiers joined by `.`, none of them a keyword. Otherwise the `=` is part
# of a directory name and the whole argument is a path. The keywords are the
# word spellings of the lexicon's literal tokens, read from the file the lexer
# is generated from.
segment='_?[[:lower:]][[:alpha:][:digit:]]*'
package_id="^([A-Za-z0-9._+-]*%[0-9a-f]{16}%)?${segment}(\\.${segment})*\$"
keywords=" $(awk '/^literal_tokens/ { inside = 1; next } inside && /^\]/ { exit } inside && ++row > 1 && $2 ~ /^[a-z]+$/ { printf "%s ", $2 }' "$ROOT/grammar/lexicon.coda") "
is_package_id() {
	local id="$1" part
	[[ "$id" =~ $package_id ]] || return 1
	local -a parts
	IFS=. read -r -a parts <<<"${id##*%}"
	for part in "${parts[@]}"; do
		[[ "$keywords" == *" $part "* ]] && return 1
	done
	return 0
}
package() {
	local argument="$1"
	if [[ "$argument" == *=* ]]; then
		local name="${argument%%=*}" dir="${argument#*=}"
		if is_package_id "$name"; then
			printf '%s=%s' "$name" "$(expand "$dir")"
			return
		fi
	fi
	expand "$argument"
}

arguments=()
case "${1-}" in
	# The fetching and remapping steps: STAMP, FROM and TO are not paths.
	--rewrite)
		arguments=("${@:1:2}")
		for argument in "${@:3}"; do arguments+=("$(expand "$argument")"); done
		;;
	--remap)
		arguments=("${@:1:3}")
		for argument in "${@:4}"; do arguments+=("$(expand "$argument")"); done
		;;
	*)
		next=''
		for argument in "$@"; do
			# A value never starts with `-`; zanec reports the missing value.
			if [[ -n "$next" && "$argument" != -* ]]; then
				case "$next" in
					path) arguments+=("$(expand "$argument")") ;;
					package) arguments+=("$(package "$argument")") ;;
					*) arguments+=("$argument") ;;
				esac
				next=''
				continue
			fi
			next=''
			case "$argument" in
				--build | --object | --tier-up | --compile-commands | --link | --c-hashes | --bundle-runtime)
					next=path ;;
				--package)
					next=package ;;
				--target | --stamp | --import | --fixed-region | --spawned-fixed-region)
					next=value ;;
				# `-` is standard input, and a leading `-` otherwise marks an option.
				-*) ;;
				# A source file given alone.
				*) argument="$(expand "$argument")" ;;
			esac
			arguments+=("$argument")
		done
		;;
esac

cd "$ROOT"
exec dune exec bin/zanec/zanec.exe -- ${arguments[@]+"${arguments[@]}"}
