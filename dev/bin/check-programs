#!/usr/bin/env bash
set -uo pipefail

# Run every program in DIR, NAME.exe or NAME beside a NAME.status, with the
# arguments NAME.args holds a line each when it is there, and hold it to
# NAME.out and NAME.status, as `windows-programs` wrote them. A program expected to exit 0 is held to its
# stdout; one expected to fail is held to everything it wrote, as
# tests/codegen/ holds it. RUNNER, when set, runs each program, so the same
# check runs Windows programs under Wine elsewhere: `RUNNER=wine64`.
#
# Each program runs twice, as tests/codegen/ runs it: with its drains
# checked (ZANE_CHECK=1), where a block still out in a region when its scope
# drains stops the program, and unchecked (ZANE_CHECK=0), where a scope with
# nothing to wait for drains in line, by code lowering emits. Both runs are
# held to the same output, and a mismatch names the mode it came from.
#
# Every program runs, and each mismatch is reported, before the check fails.

DIR="${1:?usage: check-programs DIR}"
read -r -a runner <<<"${RUNNER:-}"
failed=0
count=0

for status in "$DIR"/*.status; do
	# With no programs the pattern stays as written, and names no file.
	[[ -f "$status" ]] || continue
	name="$(basename "$status" .status)"
	program="$DIR/$name.exe"
	[[ -f "$program" ]] || program="$DIR/$name"
	expected="$(tr -d '[:space:]' <"$DIR/$name.status")"
	args=()
	if [[ -f "$DIR/$name.args" ]]; then
		while IFS= read -r arg || [[ -n "$arg" ]]; do args+=("$arg"); done <"$DIR/$name.args"
	fi
	for check in 1 0; do
		mode="ZANE_CHECK=$check"
		actual_out="$(mktemp)"
		if [[ "$expected" == 0 ]]; then
			ZANE_CHECK="$check" ${runner[@]+"${runner[@]}"} "$program" ${args[@]+"${args[@]}"} >"$actual_out"
		else
			ZANE_CHECK="$check" ${runner[@]+"${runner[@]}"} "$program" ${args[@]+"${args[@]}"} >"$actual_out" 2>&1
		fi
		status=$?
		count=$((count + 1))
		if [[ "$status" != "$expected" ]]; then
			echo "FAIL $name ($mode): exited $status, expected $expected"
			failed=1
		elif ! diff "$DIR/$name.out" "$actual_out" >/dev/null; then
			echo "FAIL $name ($mode): output differs from $name.out"
			diff "$DIR/$name.out" "$actual_out" | head -20
			failed=1
		else
			echo "ok   $name ($mode)"
		fi
		rm -f "$actual_out"
	done
done

if [[ "$count" == 0 ]]; then
	echo "check-programs: no programs in $DIR"
	exit 1
fi
exit "$failed"
