opam-version: "2.0"
synopsis: "The OCaml bindings distributed with LLVM (toolchain spike)"
description: "opam's llvm.19-static recipe, pointed at LLVM 21.1.8 from the environment."
maintainer: "zane-lang"
authors: ["The LLVM team"]
license: "Apache-2.0 WITH LLVM-exception"
homepage: "https://llvm.org"
bug-reports: "https://github.com/llvm/llvm-project/issues"
build: [
  # The documentation dumps need ocamldoc, which conda-forge's Intel macOS
  # OCaml lacks, and nothing installs them.
  ["sed" "-i.orig"
   "s|ALL DEPENDS ${ocaml_outputs} \"${bin}/${name}.odoc\")|ALL DEPENDS ${ocaml_outputs})|"
   "llvm/cmake/modules/AddOCaml.cmake"]
  ["bash" "-ex" "install.sh" "build" "--llvm-config" "llvm-config" "--libdir" lib
   "--cmake" "cmake" "--make" make "--link-mode" "static"]
]
install: [
  ["bash" "-ex" "install.sh" "install" "--llvm-config" "llvm-config" "--libdir" lib
   "--cmake" "cmake" "--make" make "--link-mode" "static"]
]
depends: [
  "ocaml" {>= "4.00.0"}
  "ctypes" {>= "0.4"}
  "ocamlfind" {build}
]
patches: ["AddOCaml.cmake.patch"]
url {
  src: "https://github.com/llvm/llvm-project/releases/download/llvmorg-21.1.8/llvm-project-21.1.8.src.tar.xz"
  checksum: "sha256=4633a23617fa31a3ea51242586ea7fb1da7140e426bd62fc164261fe036aa142"
}
