#!/usr/bin/env bash
# Toolchain spike: one stage of building and testing zanec in the pixi
# environment, as its activation sets it up (dev/setup/activate.*), after
# `pixi run setup`. Usage: dev/spike/toolchain STAGE, through `pixi run`.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$root"

case "$(uname -s)" in
MINGW* | MSYS* | CYGWIN*) windows=1 ;;
*) windows=0 ;;
esac

case "${1:?stage}" in
versions)
	uname -a
	env | grep -E '^(OPAM|ZANE_|ZIG=|LLVM_CONFIG|AR=|STRIP=|VSINSTALLDIR)' | sort
	ocamlopt -config | grep -E '^(version|architecture|system|ccomp_type|c_compiler|native_c_compiler):' || true
	opam --version
	llvm-config --version --shared-mode
	command -v ocamlfind dune menhir ld.lld clang llvm-config cl link 2>/dev/null || true
	zig version || x86_64-w64-mingw32-zig version || echo 'zig: not on PATH'
	just --version
	;;
build)
	dune build bin/zanec/zanec.exe
	ls -la _build/default/bin/zanec/zanec.exe
	;;
hello)
	out="$root/_build/spike-hello"
	if [[ $windows == 1 ]]; then out="$out.exe"; fi
	_build/default/bin/zanec/zanec.exe --build "$out" --package tests/codegen/fixtures/hello
	"$out" | tee "$root/_build/spike-hello.out"
	diff -u --strip-trailing-cr tests/codegen/golden/hello.out "$root/_build/spike-hello.out"
	;;
test)
	just test-compiler
	;;
*)
	echo "unknown stage $1" >&2
	exit 2
	;;
esac
