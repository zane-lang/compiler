#!/usr/bin/env bash
# Toolchain spike: one stage of building and testing zanec in the pixi
# environment, as its activation sets it up (dev/setup/activate.*), after
# `pixi run setup`. Usage: dev/spike/toolchain STAGE, through `pixi run`.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$root"

case "$(uname -s)" in
MINGW* | MSYS* | CYGWIN*) windows=1 ;;
*) windows=0 ;;
esac

case "${1:?stage}" in
versions)
	uname -a
	echo "PATH as bash reads it:"; echo "$PATH" | tr ':' '\n'
	if [[ $windows == 1 ]]; then
		echo "Path variables in the environment:"; env | grep -i '^path=' | cut -c1-300
		cmd //c "echo %PATH%" | tr ';' '\n'
		echo "LIB: ${LIB:-}" | tr ';' '\n'
		vs=$(cygpath -u "${VSINSTALLDIR:-C:/nonexistent}")
		ls -d "$vs"/VC/Tools/MSVC/*/ATLMFC/lib/x64/atls.lib 2>/dev/null || echo 'atls.lib: in no toolset'
		echo "VCToolsInstallDir: ${VCToolsInstallDir:-}"
	fi
	env | grep -E '^(OPAM|ZANE_|ZIG=|LLVM_CONFIG|AR=|STRIP=|VSINSTALLDIR)' | sort
	ocamlopt -config 2>/dev/null | grep -E '^(version|architecture|system|ccomp_type|c_compiler|native_c_compiler):' || true
	opam --version || true
	llvm-config --version --shared-mode || true
	command -v ocamlfind dune menhir ld.lld clang llvm-config cl link 2>/dev/null || true
	zig version || x86_64-w64-mingw32-zig version || echo 'zig: not on PATH'
	just --version
	;;
build)
	dune build bin/zanec/zanec.exe
	ls -la _build/default/bin/zanec/zanec.exe
	;;
hello)
	out="$root/_build/spike-hello"
	if [[ $windows == 1 ]]; then out="$out.exe"; fi
	_build/default/bin/zanec/zanec.exe --build "$out" --package tests/codegen/fixtures/hello
	"$out" | tee "$root/_build/spike-hello.out"
	diff -u --strip-trailing-cr tests/codegen/golden/hello.out "$root/_build/spike-hello.out"
	;;
probe)
	# One memory probe built plain and optimized, and what each writes to a
	# file and to a pipe.
	z="$root/_build/default/bin/zanec/zanec.exe"
	out="$root/_build/spike-probe"; rm -rf "$out"; mkdir -p "$out"
	"$z" --build "$out/aborts.exe" --package tests/memory-probes/aborts
	"$z" --build "$out/aborts.opt.exe" --optimize --package tests/memory-probes/aborts
	for exe in aborts aborts.opt; do
		"$out/$exe.exe" >"$out/$exe.txt" 2>&1; code=$?
		echo "-- $exe to a file: exit $code, $(wc -c <"$out/$exe.txt") bytes"; od -c "$out/$exe.txt" | head -4
		echo "-- $exe to a pipe: $("$out/$exe.exe" 2>&1 | wc -c) bytes"
	done
	;;
retained)
	# The retained C's calls with no cache to write the headers into, and
	# with a cache of its own that starts empty, one build at a time.
	cd tests/ffi
	z="$root/_build/default/bin/zanec/zanec.exe"
	echo "-- no cache:"
	ZANE_CACHE_DIR=//nonexistent/zane sh released --calls "$z" fixtures/retained || true
	echo "-- an empty cache:"
	rm -rf "$root/_build/spike-cache"
	ZANE_CACHE_DIR="$root/_build/spike-cache" sh released --calls "$z" fixtures/retained || true
	;;
cheaders)
	# Where the compiler's own clang finds its builtin headers: the build
	# writes them into the cache's foreign/resource-*/include.
	cache="$root/_build/spike-cache"
	rm -rf "$cache"
	ZANE_CACHE_DIR="$cache" _build/default/bin/zanec/zanec.exe --cgt --package tests/ffi/fixtures/folding >/dev/null || true
	find "$cache" -maxdepth 3 -type d | sed "s#^$cache#cache#"
	for d in "$cache"/foreign/resource-*/include; do
		echo "$d: $(ls "$d" | wc -l) files; stdbool.h: $(test -f "$d/stdbool.h" && echo yes || echo no)"
	done
	echo "clang's resource directories beside LLVM:"
	ls -d "$(dirname "$(dirname "$(command -v ld.lld)")")"/lib/clang/*/include 2>&1 | head
	echo "zig cc's search list:"
	"$ZANE_CC" --target=x86_64-windows-gnu -E -v -x c - </dev/null 2>&1 | sed -n '/search starts here/,/End of search/p'
	;;
test)
	just test-compiler
	;;
*)
	echo "unknown stage $1" >&2
	exit 2
	;;
esac
