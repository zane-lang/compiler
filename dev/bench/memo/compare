#!/usr/bin/env python3
"""compare ZANEC FIRST LAST: the programs `generate` makes for the seeds
FIRST to LAST, each built plain, optimized and tiered (tier 1 loaded before
`main`), with `--no-memoize` and without it, and run. Prints how many got a table and lists each seed whose
builds printed differently, leaving out a build that ran past 30 seconds.
Writes the details to results-FIRST-LAST.json in the current directory."""
import os, subprocess, sys, time, json, tempfile
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

HERE = Path(__file__).resolve().parent
Z, first, last = sys.argv[1], int(sys.argv[2]), int(sys.argv[3])
W = Path(tempfile.mkdtemp())
BUILDS = {"plain": [], "optimized": ["--optimize"], "tiered": ["--tiered"]}

def one(seed):
    d = W / f"s{seed}"
    subprocess.run([sys.executable, HERE / "generate", str(seed), d], check=True)
    res = {}
    for build, given in BUILDS.items():
        for memo in (False, True):
            exe = d / f"{build}.{memo}"
            flags = given + ([] if memo else ["--no-memoize"])
            b = subprocess.run([Z, "--build", exe, *flags, "--package", d], capture_output=True, text=True)
            if b.returncode:
                return seed, {"compile_error": b.stderr[-300:]}
            env = None
            if build == "tiered":
                library = d / f"{build}.{memo}.tier1"
                b = subprocess.run([Z, "--tier-up", library, *flags[1:], "--package", d], capture_output=True, text=True)
                if b.returncode:
                    return seed, {"compile_error": b.stderr[-300:]}
                env = {**os.environ, "ZANE_TIER_UP": str(library), "ZANE_TIER_WAIT": "1"}
            nm = subprocess.run(["nm", exe], capture_output=True, text=True).stdout
            tables = sum(1 for l in nm.splitlines() if l.endswith(".memo.state"))
            t = time.perf_counter()
            try:
                r = subprocess.run([exe], capture_output=True, text=True, timeout=30, env=env)
                out = (r.returncode, r.stdout, r.stderr)
            except subprocess.TimeoutExpired:
                out = ("timeout", "", "")
            res[(build, memo)] = (out, tables, time.perf_counter() - t)
    outs = {k: v[0] for k, v in res.items()}
    base = outs[("plain", False)]
    return seed, {
        "same": all(o == base for o in outs.values()),
        "timeout": any(o[0] == "timeout" for o in outs.values()),
        "exit": base[0],
        "tables": {f"{b}": res[(b, True)][1] for b in BUILDS},
        "times": {f"{b}.{m}": round(res[(b, m)][2], 4) for (b, m) in res},
        "outs": None if all(o == base for o in outs.values()) else {f"{k}": [o[0], o[1][-500:], o[2][-300:]] for k, o in outs.items()},
    }

with ThreadPoolExecutor(8) as ex:
    results = dict(ex.map(one, range(first, last + 1)))
(Path.cwd() / f"results-{first}-{last}.json").write_text(json.dumps(results, indent=1))
errs = [s for s, r in results.items() if "compile_error" in r]
def differs(r):
    """Whether two builds that finished printed differently."""
    return len({(code, out) for code, out, _ in r["outs"].values() if code != "timeout"}) > 1

diff = [s for s, r in results.items() if "same" in r and not r["same"] and differs(r)]
tos = [s for s, r in results.items() if r.get("timeout")]
withtab = [s for s, r in results.items() if "tables" in r and r["tables"]["plain"]]
print(f"programs {len(results)}, compile errors {len(errs)}, timeouts {len(tos)}, with tables {len(withtab)}, differing {len(diff)}: {diff}")
for s in errs[:3]: print(s, results[s]["compile_error"])
