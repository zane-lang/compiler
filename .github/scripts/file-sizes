#!/usr/bin/env bash
# Hold every hand-written source file to a size someone can still read whole.
#
# A file past 2,000 lines fails the check. One past 1,500 gets a warning, the
# size one recursive walk was accepted at (docs/refactoring-proposal.md SZ4), so
# a file that is growing is noticed in the pull request that grows it, well
# before it fails.
#
# Generated files are not held to it: a file whose first line says it was
# generated or written by a tool is skipped, and so are test fixtures and
# golden outputs, which are as long as what they test.
set -euo pipefail

warn=1500
limit=2000

cd "$(git rev-parse --show-toplevel)"

failed=0
while IFS= read -r file; do
	case "$file" in
		fixtures/* | */fixtures/* | golden/* | */golden/*) continue ;;
	esac
	first_line=
	read -r first_line <"$file" || :
	if [[ "$first_line" == *"Generated by"* || "$first_line" == *"Written by"* ]]; then
		continue
	fi
	# Arithmetic expansion drops the padding BSD's wc puts before the count.
	lines=$(($(wc -l <"$file")))
	if ((lines > limit)); then
		echo "::error file=$file::$file is $lines lines, past the limit of $limit; split it into files that each hold one part"
		failed=1
	elif ((lines > warn)); then
		echo "::warning file=$file::$file is $lines lines, past $warn; split out what does not belong with the rest before it reaches $limit"
	fi
done < <(git ls-files -- \
	'*.ml' '*.mli' '*.mly' '*.mll' '*.py' '*.lean' '*.c' '*.h' '*.sh' \
	'*.js' '*.lua' '*.zn' '*.coda' justfile \
	'dev/bin/*' 'dev/setup/*' '.github/scripts/*')

exit "$failed"
