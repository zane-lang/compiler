#!/usr/bin/env bash
# Assembles the standalone Neovim plugin (TheLazyCat00/zane-nvim) in DEST:
# editors/neovim at the top, and under tree-sitter-zane/ the generated grammar
# nvim-treesitter builds the parser from, with the shared query it links.
# Everything in DEST except .git and LICENSE is replaced.
#
# usage: assemble-neovim-plugin DEST
set -euo pipefail
root=$(cd "$(dirname "$0")/../.." && pwd)
dest=${1:?usage: assemble-neovim-plugin DEST}
grammar=$root/editors/tree-sitter-zane

mkdir -p "$dest"
find "$dest" -mindepth 1 -maxdepth 1 ! -name .git ! -name LICENSE -exec rm -rf {} +
# Only tracked files: a local checkout may hold build products beside them.
git -C "$root/editors/neovim" ls-files -z | while IFS= read -r -d '' file; do
  mkdir -p "$dest/$(dirname "$file")"
  cp "$root/editors/neovim/$file" "$dest/$file"
done
mkdir -p "$dest/tree-sitter-zane/queries"
cp "$grammar/grammar.js" "$grammar/tree-sitter.json" "$dest/tree-sitter-zane/"
cp "$grammar/queries/highlights.scm" "$dest/tree-sitter-zane/queries/"
# nvim-treesitter generates and compiles inside the plugin's checkout.
printf '%s\n' '/tree-sitter-zane/src/' '/tree-sitter-zane/*.so' > "$dest/.gitignore"
