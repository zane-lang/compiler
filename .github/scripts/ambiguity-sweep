#!/usr/bin/env bash
# Sweep the prover's abstraction level over one grammar, from the parameters in
# the environment.
#
# `devbox run` shell-quotes each argument it is given and then `eval`s the
# reassembled command line, so every argument is re-parsed by a shell before
# the command sees it. Workflow inputs therefore must not be passed as
# arguments: this script reads them from the environment, and the workflow
# invokes it with no arguments at all.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

: "${GRAMMAR:?must be set}"
: "${LEVELS:?must be set}"
: "${LEVEL_TIMEOUT:?must be set}"
: "${SWEEP_BUDGET:?must be set}"
: "${REPORT:?must be set}"

if [[ ! -f "$ROOT/$GRAMMAR" ]]; then
	echo "ambiguity-sweep: no grammar at $GRAMMAR" >&2
	exit 2
fi

# Created here as well as by --output, so the artifact upload finds a directory
# even when the run dies before the first level finishes.
mkdir -p "$(dirname "$REPORT")"

# The sweep reports a verdict in its exit status the way proof mode does: 0 the
# blind spot closed at some level, 1 a concrete ambiguous sentence, 3 it did
# not close. Reaching any of those means the sweep did its job, so the job
# result is decided below from what the table actually says.
status=0
python3 "$ROOT/tools/ambiguity/precision_sweep.py" \
	"$ROOT/$GRAMMAR" \
	--levels "$LEVELS" \
	--timeout "$LEVEL_TIMEOUT" \
	--max-tokens "${SWEEP_TOKENS:-12}" \
	--budget "$SWEEP_BUDGET" \
	--output "$REPORT" || status=$?

case "$status" in
	0 | 1 | 3) ;;
	*) exit "$status" ;;
esac

announce() {
	printf '%s\n' "$1"
	if [[ -n "${GITHUB_STEP_SUMMARY:-}" ]]; then
		printf '%s\n\n' "$1" >>"$GITHUB_STEP_SUMMARY"
	fi
}

# The table is the artifact worth reading, so it goes into the job summary
# whole rather than being summarized away.
if [[ -n "${GITHUB_STEP_SUMMARY:-}" ]]; then
	{
		printf '### Precision sweep of `%s`\n\n' "$GRAMMAR"
		printf '```\n'
		cat "$REPORT"
		printf '```\n\n'
	} >>"$GITHUB_STEP_SUMMARY"
fi

# Read the verdict from the report rather than the status, for the reason
# `ambiguity-verdict` does: text is the signal that survives a tool whose exit
# statuses change, and an unrecognized report must stop the job loudly instead
# of passing as a sweep that found nothing.
if grep -q '^BROKEN:' "$REPORT"; then
	announce "A level reached no verdict, so this run went wrong rather than the grammar being unproven. The engine's output is in the report."
	exit 2
fi

if grep -q '^AMBIGUOUS:' "$REPORT"; then
	announce "A concrete ambiguous sentence was found. This is a bug in the grammar, not a limit of the abstraction, and no level will ever prove it."
	exit 1
fi

if grep -q '^BOUNDED:' "$REPORT"; then
	announce "Bounded blind spot: it closes once the retained stack is wide enough, so refining the abstraction - globally, or only along a counterexample's chain - would prove this grammar."
	exit 0
fi

if grep -q '^FLAT:' "$REPORT"; then
	announce "Unbounded blind spot: the accepting-pair count held flat at every level with every walk complete, so no level will ever close it and the conflict belongs in a written transience argument."
	exit 0
fi

if grep -q '^INCONCLUSIVE:\|^FALLING:' "$REPORT"; then
	announce "Inconclusive: the sweep did not reach a level that settles the question. Widen LEVELS, or raise the per-level timeout so the cut-short walks finish."
	exit 0
fi

echo "ambiguity-sweep: no recognized reading in $REPORT" >&2
exit 2
