#!/usr/bin/env bash
# Download the architecture-specific Zig release pinned by its manifest.
set -euo pipefail
: "${GITHUB_ENV:?must be set}"
manifest=${1:?usage: install-zig-macos MANIFEST}
metadata=$(python3 - "$manifest" <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as source:
    manifest = json.load(source)
for key in ("version", "url", "sha256"):
    if key not in manifest:
        raise SystemExit(f"Zig manifest is missing {key!r}")
    print(manifest[key])
PY
)
version=$(printf '%s\n' "$metadata" | sed -n '1p')
url=$(printf '%s\n' "$metadata" | sed -n '2p')
sha256=$(printf '%s\n' "$metadata" | sed -n '3p')
archive="$RUNNER_TEMP/zig-macos.tar.xz"
destination="$RUNNER_TEMP/zig-macos"

curl -fSL "$url" -o "$archive"
printf '%s  %s\n' "$sha256" "$archive" | shasum -a 256 --check --status
mkdir -p "$destination"
tar -xJf "$archive" --strip-components=1 -C "$destination"
test "$("$destination/zig" version)" = "$version"
echo "ZIG=$destination/zig" >> "$GITHUB_ENV"
