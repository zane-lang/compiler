#!/usr/bin/env bash
# Run one profiled ambiguity search from the parameters in the environment.
#
# Workflow inputs are not passed as arguments, where a shell would parse
# them: this script reads them from the environment, and the workflow invokes
# it with no arguments at all.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

: "${PROFILE:?must be set}"
: "${SEARCH_TIMEOUT:?must be set}"
: "${WITNESSES:?must be set}"
: "${REPORT:?must be set}"

args=(
	search "$PROFILE"
	--timeout "$SEARCH_TIMEOUT"
	--witnesses "$WITNESSES"
	--output "$REPORT"
)

# An empty token range means "keep the profile's own range".
if [[ -n "${TOKENS:-}" ]]; then
	args+=(--tokens "$TOKENS")
fi

# The report directory is created here as well as by --output, so the artifact
# upload finds a directory even when the search dies before its first write.
mkdir -p "$(dirname "$REPORT")"

exec "$ROOT/dev/bin/ambiguity" "${args[@]}"
