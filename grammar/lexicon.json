{
  "version": 1,
  "language": "zane",
  "extensions": [
    "zn",
    "zane"
  ],
  "expressions": {
    "digit": {
      "range": [
        "0",
        "9"
      ]
    },
    "digits": {
      "plus": {
        "ref": "digit"
      }
    },
    "int_lit": {
      "seq": [
        {
          "ref": "digits"
        },
        {
          "star": {
            "seq": [
              "'",
              {
                "ref": "digits"
              }
            ]
          }
        }
      ]
    },
    "decimal_lit": {
      "seq": [
        {
          "ref": "int_lit"
        },
        ".",
        {
          "ref": "digits"
        }
      ]
    },
    "str_char": {
      "choice": [
        {
          "not": [
            "\"",
            "\\"
          ]
        },
        {
          "seq": [
            "\\",
            {
              "any": true
            }
          ]
        }
      ]
    },
    "string_lit": {
      "seq": [
        "\"",
        {
          "star": {
            "ref": "str_char"
          }
        },
        "\""
      ]
    },
    "line_char": {
      "not": [
        "\n",
        "\r"
      ]
    },
    "ident_char": {
      "choice": [
        {
          "unicode": "alphabetic"
        },
        {
          "ref": "digit"
        }
      ]
    },
    "lower_ident": {
      "seq": [
        {
          "choice": [
            {
              "unicode": "lowercase"
            },
            {
              "seq": [
                "_",
                {
                  "unicode": "lowercase"
                }
              ]
            }
          ]
        },
        {
          "star": {
            "ref": "ident_char"
          }
        }
      ]
    },
    "upper_ident": {
      "seq": [
        {
          "choice": [
            {
              "unicode": "uppercase"
            },
            {
              "seq": [
                "_",
                {
                  "unicode": "uppercase"
                }
              ]
            }
          ]
        },
        {
          "star": {
            "ref": "ident_char"
          }
        }
      ]
    }
  },
  "trivia": [
    {
      "name": "whitespace",
      "pattern": {
        "plus": {
          "choice": [
            " ",
            "\t",
            "\r",
            "\n"
          ]
        }
      }
    },
    {
      "name": "doc_comment",
      "pattern": {
        "seq": [
          "///",
          {
            "star": {
              "ref": "line_char"
            }
          }
        ]
      },
      "capture": "comment.documentation",
      "scope": "comment.line.documentation"
    },
    {
      "name": "comment",
      "pattern": {
        "seq": [
          "//",
          {
            "star": {
              "ref": "line_char"
            }
          }
        ]
      },
      "capture": "comment",
      "scope": "comment.line.double-slash"
    }
  ],
  "tokens": [
    {
      "name": "INT",
      "example": "43",
      "type": "string",
      "pattern": {
        "ref": "int_lit"
      },
      "node": "integer_literal",
      "capture": "number",
      "scope": "constant.numeric.integer"
    },
    {
      "name": "DECIMAL",
      "example": "8.647",
      "type": "string",
      "pattern": {
        "ref": "decimal_lit"
      },
      "node": "decimal_literal",
      "capture": "number.float",
      "scope": "constant.numeric.float",
      "highlight_priority": 1
    },
    {
      "name": "STRING",
      "example": "\"john\"",
      "type": "string",
      "pattern": {
        "ref": "string_lit"
      },
      "node": "string_literal",
      "capture": "string",
      "scope": "string.quoted.double",
      "value": "unquote"
    },
    {
      "name": "LIDENT",
      "example": "length",
      "type": "string",
      "pattern": {
        "ref": "lower_ident"
      },
      "node": "identifier",
      "capture": "variable",
      "scope": "variable.other"
    },
    {
      "name": "UIDENT",
      "example": "Int",
      "type": "string",
      "pattern": {
        "ref": "upper_ident"
      },
      "node": "type_identifier",
      "capture": "type",
      "scope": "entity.name.type"
    },
    {
      "name": "LPAREN",
      "literal": "(",
      "capture": "punctuation.bracket",
      "scope": "punctuation.section"
    },
    {
      "name": "RPAREN",
      "literal": ")",
      "capture": "punctuation.bracket",
      "scope": "punctuation.section"
    },
    {
      "name": "COMMA",
      "literal": ",",
      "capture": "punctuation.delimiter",
      "scope": "punctuation.separator"
    },
    {
      "name": "LCURLY",
      "literal": "{",
      "capture": "punctuation.bracket",
      "scope": "punctuation.section"
    },
    {
      "name": "RCURLY",
      "literal": "}",
      "capture": "punctuation.bracket",
      "scope": "punctuation.section"
    },
    {
      "name": "LBRACKET",
      "literal": "[",
      "capture": "punctuation.bracket",
      "scope": "punctuation.section"
    },
    {
      "name": "RBRACKET",
      "literal": "]",
      "capture": "punctuation.bracket",
      "scope": "punctuation.section"
    },
    {
      "name": "COLON",
      "literal": ":",
      "capture": "operator",
      "scope": "keyword.operator"
    },
    {
      "name": "SEMICOLON",
      "literal": ";",
      "capture": "punctuation.delimiter",
      "scope": "punctuation.separator"
    },
    {
      "name": "DOT",
      "literal": ".",
      "capture": "punctuation.delimiter",
      "scope": "punctuation.separator"
    },
    {
      "name": "EQUAL",
      "literal": "=",
      "capture": "operator",
      "scope": "keyword.operator"
    },
    {
      "name": "PLUS",
      "literal": "+",
      "capture": "operator",
      "scope": "keyword.operator"
    },
    {
      "name": "MINUS",
      "literal": "-",
      "capture": "operator",
      "scope": "keyword.operator"
    },
    {
      "name": "STAR",
      "literal": "*",
      "capture": "operator",
      "scope": "keyword.operator"
    },
    {
      "name": "SLASH",
      "literal": "/",
      "capture": "operator",
      "scope": "keyword.operator"
    },
    {
      "name": "DOLLAR",
      "literal": "$",
      "capture": "operator",
      "scope": "keyword.operator"
    },
    {
      "name": "HASH",
      "literal": "#",
      "capture": "operator",
      "scope": "keyword.operator"
    },
    {
      "name": "AMPERSAND",
      "literal": "&",
      "capture": "operator",
      "scope": "keyword.operator"
    },
    {
      "name": "AT",
      "literal": "@",
      "capture": "operator",
      "scope": "keyword.operator"
    },
    {
      "name": "EXCL",
      "literal": "!",
      "capture": "operator",
      "scope": "keyword.operator"
    },
    {
      "name": "QSTNMARK",
      "literal": "?",
      "capture": "operator",
      "scope": "keyword.operator"
    },
    {
      "name": "QSTNQSTN",
      "literal": "??",
      "capture": "operator",
      "scope": "keyword.operator"
    },
    {
      "name": "TILDE",
      "literal": "~",
      "capture": "operator",
      "scope": "keyword.operator"
    },
    {
      "name": "THICK_ARROW",
      "literal": "=>",
      "capture": "operator",
      "scope": "keyword.operator"
    },
    {
      "name": "EQEQ",
      "literal": "==",
      "capture": "operator",
      "scope": "keyword.operator"
    },
    {
      "name": "NOTEQ",
      "literal": "~=",
      "capture": "operator",
      "scope": "keyword.operator"
    },
    {
      "name": "LESSEQ",
      "literal": "<=",
      "capture": "operator",
      "scope": "keyword.operator"
    },
    {
      "name": "MOREEQ",
      "literal": ">=",
      "capture": "operator",
      "scope": "keyword.operator"
    },
    {
      "name": "LESS",
      "literal": "<",
      "capture": "operator",
      "scope": "keyword.operator"
    },
    {
      "name": "MORE",
      "literal": ">",
      "capture": "operator",
      "scope": "keyword.operator"
    },
    {
      "name": "LOOSE_STAR",
      "literal": "'*",
      "capture": "operator",
      "scope": "keyword.operator"
    },
    {
      "name": "LOOSE_SLASH",
      "literal": "'/",
      "capture": "operator",
      "scope": "keyword.operator"
    },
    {
      "name": "LOOSE_PLUS",
      "literal": "'+",
      "capture": "operator",
      "scope": "keyword.operator"
    },
    {
      "name": "LOOSE_MINUS",
      "literal": "'-",
      "capture": "operator",
      "scope": "keyword.operator"
    },
    {
      "name": "LOOSE_EQEQ",
      "literal": "'==",
      "capture": "operator",
      "scope": "keyword.operator"
    },
    {
      "name": "LOOSE_NOTEQ",
      "literal": "'~=",
      "capture": "operator",
      "scope": "keyword.operator"
    },
    {
      "name": "LOOSE_LESSEQ",
      "literal": "'<=",
      "capture": "operator",
      "scope": "keyword.operator"
    },
    {
      "name": "LOOSE_MOREEQ",
      "literal": "'>=",
      "capture": "operator",
      "scope": "keyword.operator"
    },
    {
      "name": "LOOSE_LESS",
      "literal": "'<",
      "capture": "operator",
      "scope": "keyword.operator"
    },
    {
      "name": "LOOSE_MORE",
      "literal": "'>",
      "capture": "operator",
      "scope": "keyword.operator"
    },
    {
      "name": "LTYPE",
      "literal": "type",
      "capture": "keyword",
      "scope": "keyword.control"
    },
    {
      "name": "ALIAS",
      "literal": "alias",
      "capture": "keyword",
      "scope": "keyword.control"
    },
    {
      "name": "UTYPE",
      "literal": "Type",
      "capture": "type.builtin",
      "scope": "support.type"
    },
    {
      "name": "STRUCT",
      "literal": "struct",
      "capture": "keyword",
      "scope": "keyword.control"
    },
    {
      "name": "VARIANT",
      "literal": "variant",
      "capture": "keyword",
      "scope": "keyword.control"
    },
    {
      "name": "ENUM",
      "literal": "enum",
      "capture": "keyword",
      "scope": "keyword.control"
    },
    {
      "name": "PACKAGE",
      "literal": "package",
      "capture": "keyword",
      "scope": "keyword.control"
    },
    {
      "name": "IMPORT",
      "literal": "import",
      "capture": "keyword",
      "scope": "keyword.control"
    },
    {
      "name": "AS",
      "literal": "as",
      "capture": "keyword",
      "scope": "keyword.control"
    },
    {
      "name": "IMPLICIT",
      "literal": "implicit",
      "capture": "keyword",
      "scope": "keyword.control"
    },
    {
      "name": "INIT",
      "literal": "init",
      "capture": "keyword",
      "scope": "keyword.control"
    },
    {
      "name": "MATCH",
      "literal": "match",
      "capture": "keyword",
      "scope": "keyword.control"
    },
    {
      "name": "SPAWN",
      "literal": "spawn",
      "capture": "keyword",
      "scope": "keyword.control"
    },
    {
      "name": "TRUE",
      "literal": "true",
      "capture": "boolean",
      "scope": "constant.language.boolean"
    },
    {
      "name": "FALSE",
      "literal": "false",
      "capture": "boolean",
      "scope": "constant.language.boolean"
    },
    {
      "name": "THIS",
      "literal": "this",
      "capture": "variable.builtin",
      "scope": "variable.language"
    },
    {
      "name": "MUT",
      "literal": "mut",
      "capture": "keyword",
      "scope": "keyword.control"
    },
    {
      "name": "ABORT",
      "literal": "abort",
      "capture": "keyword",
      "scope": "keyword.control"
    },
    {
      "name": "RETURN",
      "literal": "return",
      "capture": "keyword",
      "scope": "keyword.control"
    },
    {
      "name": "RESOLVE",
      "literal": "resolve",
      "capture": "keyword",
      "scope": "keyword.control"
    },
    {
      "name": "EOF",
      "eof": true
    }
  ]
}
