# Editor tree shape and contextual captures. Conflicts are discovered, never authored.
version 1
public_rules [
  top_decl
  type_expr
  map_lit
  import_decl
  header_decl
  block_decl
  simple_decl
  simple_decl_braced
  fields_var_shorthand
  trailing_var_shorthand
  enum_map_decl
  block_body
  shorthand_body
  body
  shorthand_body_braced
  body_braced
  ret_type
  abort_ret_type
  unbraced_verb_call
  braced_verb_call
  block_call
  primary
  primary_braced
  func_callee
  app
  expr
  abort_handle
  expr_braced
  app_braced
  abort_handle_braced
  stat
]
# %inline rules the editor tree keeps as nodes of their own, so queries can
# name parameters, qualified names and fields rather than guess them from
# their neighbours. The compiler grammar still inlines them.
kept_inline_rules [
  param
  constructor_field
  name_expr
  name_type
  import_member
  body_field
  field_arg
  constructor_field_arg
]
# Rules whose first named child binds a name. The Neovim predicate zane-bound?
# (in the zane-nvim plugin) marks a reference bound when one of its ancestors
# has a binder of that name as a child. The generator passes these, and the
# node types that can hold one, to each zane-bound? call as arguments.
binders [
  param
  constructor_field
]
# A declared verb name is the identifier right after the return type and right
# before `(`: anchors skip anonymous tokens, so without the `(` an operator's or
# a lambda's first parameter would be taken for the name.
#
# An intrinsic (`@primitives$Unit`, `@program$console`) is the qualified name
# whose text starts with `@`. Anchors skip the anonymous `@` too, so the
# patterns for ordinary namespaces and calls capture the whole name as
# `@_name` and refuse one that starts with `@` with #not-match?. The pattern
# spells `@` as `[@]` because Neovim reads it as a very-magic Vim regex, where a
# bare `@` is an operator. Neovim draws no capture that starts with `_`. An intrinsic's name is a builtin constant
# unless it is called or is a type; the call patterns follow it, and the later
# pattern wins, as `@function.call` wins over `@variable`.
highlights [
  "((name_expr (identifier) @module \"$\") @_name (#not-match? @_name \"^[@]\"))"
  "((name_type (identifier) @module \"$\") @_name (#not-match? @_name \"^[@]\"))"
  "(header_decl \"package\" (identifier) @module)"
  "(import_decl (identifier) @module)"
  "(func_callee \".\" (identifier) @variable.member)"
  "(app (name_type) \".\" (identifier) @variable.member)"
  "(body_field . (identifier) @variable.member)"
  "(field_arg . (identifier) @variable.member)"
  "(constructor_field_arg . (identifier) @variable.member)"
  "[(unbraced_verb_call (func_callee (primary ((name_expr (identifier) @function.call .) @_name (#not-match? @_name \"^[@]\"))))) (block_call (func_callee (primary ((name_expr (identifier) @function.call .) @_name (#not-match? @_name \"^[@]\")))))]"
  "[(unbraced_verb_call (primary ((name_expr (identifier) @function.method.call .) @_name (#not-match? @_name \"^[@]\")))) (block_call (primary ((name_expr (identifier) @function.method.call .) @_name (#not-match? @_name \"^[@]\"))))]"
  "[(unbraced_verb_call (func_callee \".\" (identifier) @function.method.call)) (block_call (func_callee \".\" (identifier) @function.method.call))]"
  "(block_decl (ret_type) . (identifier) @function . \"(\")"
  "(simple_decl (ret_type) . (identifier) @function . \"(\")"
  "(simple_decl_braced (ret_type) . (identifier) @function . \"(\")"
  "(param . (identifier) @variable.parameter)"
  "(constructor_field . (identifier) @variable.parameter)"
  "(name_expr \"@\" (identifier) @module.builtin \"$\")"
  "(name_type \"@\" (identifier) @module.builtin \"$\")"
  "(name_type \"@\" \"$\" (type_identifier) @type.builtin)"
  "(name_expr \"@\" \"$\" (identifier) @constant.builtin)"
  "[(unbraced_verb_call (func_callee (primary (name_expr \"@\" \"$\" (identifier) @function.builtin .)))) (block_call (func_callee (primary (name_expr \"@\" \"$\" (identifier) @function.builtin .))))]"
  "[(unbraced_verb_call (primary (name_expr \"@\" \"$\" (identifier) @function.builtin .))) (block_call (primary (name_expr \"@\" \"$\" (identifier) @function.builtin .)))]"
]
# Neovim-only captures, appended to the shared query in
# editors/neovim/queries/highlights.scm, which nvim-treesitter installs. A
# parameter's uses need zane-bound?, which the zane-nvim plugin defines; a
# consumer that skipped the predicate would take every reference for a parameter.
neovim_highlights [
  "((name_expr . (identifier) @variable.parameter .) (#zane-bound? @variable.parameter))"
  "((field_arg . (identifier) @variable.parameter .) (#zane-bound? @variable.parameter))"
]
