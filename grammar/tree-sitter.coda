# Editor tree shape and contextual captures. Conflicts are discovered, never authored.
version 1
public_rules [
  top_decl
  type_expr
  map_lit
  import_decl
  header_decl
  block_decl
  simple_decl
  simple_decl_braced
  fields_var_shorthand
  trailing_var_shorthand
  enum_map_decl
  block_body
  shorthand_body
  body
  shorthand_body_braced
  body_braced
  ret_type
  abort_ret_type
  unbraced_verb_call
  braced_verb_call
  block_call
  primary
  primary_braced
  func_callee
  app
  expr
  ref_target
  abort_handle
  expr_braced
  app_braced
  ref_target_braced
  abort_handle_braced
  stat
]
# %inline rules the editor tree keeps as nodes of their own, so queries can
# name parameters, qualified names and fields rather than guess them from
# their neighbours. The compiler grammar still inlines them.
kept_inline_rules [
  param
  constructor_field
  name_expr
  name_type
  import_member
  body_field
  field_arg
  constructor_field_arg
]
# Rules whose first named child binds a name. The Neovim predicate zane-bound?
# (tools/grammar/neovim.lua) marks a reference bound when one of its ancestors
# has a binder of that name as a child.
binders [
  param
  constructor_field
]
# A declared verb name is the identifier right after the return type and right
# before `(`: anchors skip anonymous tokens, so without the `(` an operator's or
# a lambda's first parameter would be taken for the name.
highlights [
  "(name_expr (identifier) @module \"$\")"
  "(name_type (identifier) @module \"$\")"
  "(header_decl \"package\" (identifier) @module)"
  "(import_decl (identifier) @module)"
  "(func_callee \".\" (identifier) @variable.member)"
  "(app (name_type) \".\" (identifier) @variable.member)"
  "(body_field . (identifier) @variable.member)"
  "(field_arg . (identifier) @variable.member)"
  "(constructor_field_arg . (identifier) @variable.member)"
  "[(unbraced_verb_call (func_callee (primary (name_expr (identifier) @function.call .)))) (block_call (func_callee (primary (name_expr (identifier) @function.call .))))]"
  "[(unbraced_verb_call (primary (name_expr (identifier) @function.method.call .))) (block_call (primary (name_expr (identifier) @function.method.call .)))]"
  "[(unbraced_verb_call (func_callee \".\" (identifier) @function.method.call)) (block_call (func_callee \".\" (identifier) @function.method.call))]"
  "(block_decl (ret_type) . (identifier) @function . \"(\")"
  "(simple_decl (ret_type) . (identifier) @function . \"(\")"
  "(simple_decl_braced (ret_type) . (identifier) @function . \"(\")"
  "(param . (identifier) @variable.parameter)"
  "(constructor_field . (identifier) @variable.parameter)"
]
# Neovim-only captures, generated into editors/neovim/queries/zane/highlights.scm
# as an extension of the shared query. A parameter's uses need zane-bound?,
# which only the generated zane.lua defines; a consumer that skipped the
# predicate would take every reference for a parameter.
neovim_highlights [
  "((name_expr . (identifier) @variable.parameter .) (#zane-bound? @variable.parameter))"
  "((field_arg . (identifier) @variable.parameter .) (#zane-bound? @variable.parameter))"
]
