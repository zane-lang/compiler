/// A program that depends on the second version of geometry, by the key
/// `geo`, and on atlas, which depends on the first. Both versions are linked
/// side by side. Every check prints `yes` when it holds and `no` when it does
/// not.
package app;

import geo;
import atlas;

alias Int = @primitives$I64
alias Bool = @primitives$Bool
alias Unit = @primitives$Unit
alias String = @primitives$String

Unit check(ok Bool) {
	yes String("yes\n");
	no String("no\n");
	@controlflow$branch(ok, {
		@program$console!print(yes);
	});
	@controlflow$branch(@operators$not(ok), {
		@program$console!print(no);
	});
	return Unit();
}

Unit main() {
	check(@operators$equal(geo$version(), Int(2)));
	check(@operators$equal(atlas$legacy(), Int(1)));
	check(@operators$equal(geo$Point(Int(1), Int(2), Int(3)):size(), Int(6)));
	check(@operators$equal(atlas$measure(), Int(3)));
	check(@operators$equal(geo$same(Int(4)), Int(4)));
	check(@operators$equal(atlas$echo(Int(5)), Int(5)));
	return Unit();
}
