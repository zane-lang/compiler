/// A program that uses geometry from objects geometry was built into on its
/// own: geometry's verbs whose body is one expression are written out here
/// and the rest called, the instances of its generic that survey needs are
/// made here, and the program links with geometry's object. Every check prints `yes` when it holds and `no` when it does not.
package survey;

import geometry;

alias Int = @primitives$I64
alias Bool = @primitives$Bool
alias Unit = @primitives$Unit
alias String = @primitives$String

type Plot = struct {
	side Int;
}

Plot(side Int) => init{ side; }

Unit check(ok Bool) {
	yes String("yes\n");
	no String("no\n");
	@controlflow$branch(ok, {
		@program$console!print(yes);
	});
	@controlflow$branch(@operators$not(ok), {
		@program$console!print(no);
	});
	return Unit();
}

Unit main() {
	check(@operators$equal(geometry$area(Int(3), Int(4)), Int(12)));
	check(@operators$equal(geometry$twice(Int(5)), Int(10)));
	check(@operators$equal(geometry$Point(Int(1), Int(2)):sum(), Int(3)));
	check(@operators$equal(geometry$double(Int(7)), Int(14)));
	check(@operators$equal(geometry$scaled(geometry$unit), Int(100)));
	check(@operators$equal(geometry$same(Plot(Int(6))).side, Int(6)));
	check(@operators$equal(geometry$shifted(geometry$Point(Int(1), Int(2)), Int(1)):sum(), Int(5)));
	return Unit();
}
