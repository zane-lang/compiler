/// A program that uses geometry from objects geometry was built into on its
/// own: geometry's verbs are only declared here, the instance of its generic
/// at survey's own type is made here, and the program links with geometry's
/// object. Every check prints `yes` when it holds and `no` when it does not.
package survey;

import geometry;

alias Int = @primitives$Int
alias Bool = @primitives$Bool
alias Unit = @primitives$Unit
alias String = @primitives$String

type Plot = struct {
	side Int;
}

Plot(side Int) => init{ side; }

Unit check(ok Bool) {
	yes String("yes\n");
	no String("no\n");
	@controlflow$branch(ok, {
		@program$console!print(yes);
	});
	@controlflow$branch(~ok, {
		@program$console!print(no);
	});
	return Unit();
}

Unit main() {
	check(geometry$area(Int(3), Int(4)) == Int(12));
	check(geometry$twice(Int(5)) == Int(10));
	check(geometry$Point(Int(1), Int(2)):sum() == Int(3));
	check(geometry$double(Int(7)) == Int(14));
	check(geometry$scaled(geometry$unit) == Int(100));
	check(geometry$same(Plot(Int(6))).side == Int(6));
	return Unit();
}
