	@program$console!print(@operators$concat(copied.value, String.escaped(" ")));
	@program$console!print(@operators$concat(kept, String.escaped(" ")));
	@program$console!print(@operators$concat(made.value, String.escaped(" ")));
	@program$console!print(@operators$concat(held.value, String.escaped("\n")));
