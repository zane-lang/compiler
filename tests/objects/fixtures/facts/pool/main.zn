/// A library that spawns a call that writes an Int back into an owner.
package pool;

type Tally = #struct {
	n @primitives$I64;
}

Tally(n @primitives$I64) => init{ n; }

@primitives$Unit twice(this @primitives$I64) mut {
	this = @operators$add(this, this);
	return @primitives$Unit();
}

@primitives$Unit start(this Tally) mut {
	spawn this.n!twice();
	return @primitives$Unit();
}

@primitives$I64 doubled(n @primitives$I64) {
	tally Tally(n);
	tally!start();
	return tally.n;
}
