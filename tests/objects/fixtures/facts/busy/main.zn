/// quiet, and one spawned call, so a spawned call may write back while
/// another thread reads.
package busy;

import cells$;

Int twice(n Int) => @operators$add(n, n)

Unit main() {
	args List<String> = @program$runtime:arguments();
	n Int = args[Int(1)]:parseI64() ?? Int(0);
	m Int = spawn twice(n);
	grid Grid();
	grid!fill(m);
	total Int = grid!sweep();
	@program$console!print(@operators$concat(String(total), String(" ")));
	@program$console!print(@operators$concat(String(grid!drop()), String("\n")));
	return Unit();
}
