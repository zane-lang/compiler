/// quiet, and one spawned call that writes an Int back into an owner, so a
/// spawned call may write back while another thread reads.
package busy;

import cells$;

type Tally = #struct {
	n Int;
}

Tally(n Int) => init{ n; }

Unit twice(this Int) mut {
	this = @operators$add(this, this);
	return Unit();
}

Unit start(this Tally) mut {
	spawn this.n!twice();
	return Unit();
}

Unit main() {
	args @primitives$List<String> = @program$runtime:arguments();
	tally Tally(args[Int(1)]:parseI64() ?? Int(0));
	tally!start();
	m Int = tally.n;
	grid Grid();
	grid!fill(m);
	total Int = grid!sweep();
	@program$console!print(@operators$concat(String(total), String(" ")));
	@program$console!print(@operators$concat(String(grid!drop()), String.escaped("\n")));
	return Unit();
}
