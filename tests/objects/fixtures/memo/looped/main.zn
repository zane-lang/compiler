/// Calls in a loop that do not recurse: a heavy one gets a table, a light
/// one does not, nor one of many cases each light, nor a heavy one called
/// outside any loop and in a loop that never runs.
package looped;


alias Int = @primitives$I64
alias Float = @primitives$F64
alias Bool = @primitives$Bool
alias Unit = @primitives$Unit
alias String = @primitives$String
alias List<T Type> = @primitives$List<T>

/// Advances the counter through the inclusive range, running the block once
/// per step.
Unit to(this Int, end Int, body @concepts$Block) mut {
	@controlflow$repeat(@operators$add(@operators$add(end, @operators$negate(this)), Int(1)), {
		@controlflow$branch(true, body);
		this = @operators$add(this, Int(1));
	});
	return Unit();
}

/// The size the program was started with: its first argument, or
/// `fallback` when it has none or the first spells no integer.
Int size(fallback Int) {
	args List<String> = @program$runtime:arguments();
	@controlflow$branch(@operators$lessThan(args:size(), Int(1)), {
		return fallback;
	});
	return args[Int(1)]:parseI64() ?? fallback;
}

Unit say(text String) {
	@program$console!print(@operators$concat(text, String("\n")));
	return Unit();
}

Int rem(a Int, b Int) => @operators$add(a, @operators$negate(@operators$multiply(@operators$divide(a, b), b)))

Int mix(k Int) => rem(@operators$add(@operators$multiply(k, Int(6364136223846793005)), Int(1442695040888963407)), Int(1000000007))

Int heavy(k Int) {
	x Int = k;
	@controlflow$repeat(Int(50), {
		x = mix(x);
	});
	return x;
}

Int light(k Int) {
	return @operators$add(mix(k), Int(1));
}

type Pick = variant {
	p1 Int;
	p2 Int;
	p3 Int;
	p4 Int;
	p5 Int;
	p6 Int;
	p7 Int;
	p8 Int;
}

/// Each case does less than a lookup; only one runs.
Int spread(p Pick) => match (p) {
	v p1 => mix(mix(@operators$add(v, Int(1))));
	v p2 => mix(mix(@operators$add(v, Int(2))));
	v p3 => mix(mix(@operators$add(v, Int(3))));
	v p4 => mix(mix(@operators$add(v, Int(4))));
	v p5 => mix(mix(@operators$add(v, Int(5))));
	v p6 => mix(mix(@operators$add(v, Int(6))));
	v p7 => mix(mix(@operators$add(v, Int(7))));
	v p8 => mix(mix(@operators$add(v, Int(8))));
}

Int alone(k Int) {
	x Int = k;
	@controlflow$repeat(Int(50), {
		x = mix(x);
	});
	return x;
}

Unit main() {
	n Int = size(Int(10));
	total Int = alone(n);
	i Int(1);
	i!to(n) {
		total = @operators$add(total, heavy(rem(i, Int(4))));
		total = @operators$add(total, light(rem(i, Int(4))));
		total = @operators$add(total, spread(Pick.p3(rem(i, Int(4)))));
		@controlflow$repeat(Int(0), {
			total = @operators$add(total, alone(rem(i, Int(4))));
		});
	}
	say(String(total));
	return Unit();
}
