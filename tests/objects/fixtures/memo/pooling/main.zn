/// A program that spawns nothing but makes a worker pool, whose two workers'
/// steps run `fib` on two threads at once: both threads use `fib`'s one
/// table. The funnel adds the two results and prints the sum.
package pooling;


alias Int = @primitives$I64;
alias Float = @primitives$F64;
alias Bool = @primitives$Bool;
alias Unit = @primitives$Unit;
alias String = @primitives$String;
alias ListRef<T Type> = @primitives$ListRef<T>;

/// Advances the counter through the inclusive range, running the block once
/// per step.
Unit to(this Int, end Int, body @concepts$Block) mut {
	@controlflow$repeat(@operators$add(@operators$add(end, @operators$negate(this)), Int(1)), {
		@controlflow$branch(true, body);
		this = @operators$add(this, Int(1));
	});
	return Unit();
}

/// The size the program was started with: its first argument, or
/// `fallback` when it has none or the first spells no integer.
Int size(fallback Int) {
	args @primitives$List<String> = @program$runtime:arguments();
	@controlflow$branch(@operators$lessThan(args:size(), Int(1)), {
		return fallback;
	});
	return args[Int(1)]:parseI64() ?? fallback;
}

Unit say(text String) {
	@program$console!print(@operators$concat(text, String.escaped("\n")));
	return Unit();
}


Int fib(n Int) {
	@controlflow$branch(@operators$lessThan(n, Int(2)), {
		return n;
	});
	return @operators$add(fib(@operators$add(n, @operators$negate(Int(1)))), fib(@operators$add(n, @operators$negate(Int(2)))));
}

type Task = struct {
	n Int;
}
Task(n Int) => init{ n; }

type Total = struct {
	sum Int;
	count Int;
}
Total() => init{ sum = Int(0); count = Int(0); }

Unit main() {
	n Int = size(Int(15));
	@controlflow$branch(true, {
		pool @primitives$WorkerPool<Task, Total, Int> = @primitives$WorkerPool(Task, Total(), Unit(this Total, result Int) mut {
			this.sum = @operators$add(this.sum, result);
			this.count = @operators$add(this.count, Int(1));
			@controlflow$branch(@operators$equal(this.count, Int(2)), {
				say(String(this.sum));
			});
			return Unit();
		});
		step Bool[this Task, Total, Unit[Int]] mut = Bool(this Task, total Total, publish Unit[Int]) mut {
			publish(fib(this.n));
			return false;
		}
		pool!start(Task(n), step);
		pool!start(Task(@operators$add(n, @operators$negate(Int(1)))), step);
	});
	return Unit();
}
