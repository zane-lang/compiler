/// A library of verbs that take and return values of one to four
/// pieces (docs/design/lowering.md §9), whose signatures `abi_test.py`
/// reads: a library exports each, so each keeps its function however its
/// callers inline it.
package crossing;

alias I32 = @primitives$I32
alias Int = @primitives$I64
alias Float = @primitives$F64

type Pair = struct {
	x Int;
	y Int;
}

Pair(x Int, y Int) => init{ x; y; }

type Triple = struct {
	x Int;
	y Int;
	z Int;
}

Triple(x Int, y Int, z Int) => init{ x; y; z; }

type Quad = struct {
	w Int;
	x Int;
	y Int;
	z Int;
}

Quad(w Int, x Int, y Int, z Int) => init{ w; x; y; z; }

/// Three pieces, all floating-point: one more than x86-64 returns in
/// registers.
type Point = struct {
	x Float;
	y Float;
	z Float;
}

Point(x Float, y Float, z Float) => init{ x; y; z; }

/// Three pieces in 12 bytes: by address unless packed into two words.
type Small = struct {
	a I32;
	b I32;
	c I32;
}

Small(a I32, b I32, c I32) => init{ a; b; c; }

type Light = enum [ red, green ]

Pair swapped(p Pair) => Pair(p.y, p.x)

Triple rotated(t Triple) => Triple(t.y, t.z, t.x)

Quad turned(q Quad) => Quad(q.z, q.w, q.x, q.y)

Point mirrored(p Point) => Point(p.z, p.y, p.x)

Small reversed(s Small) => Small(s.c, s.b, s.a)

Light flipped(l Light) => match (l) {
	red => Light.green;
	green => Light.red;
}
