; Two versions of geometry in one program: atlas depends on the first, and
; the program on the second, under the key `geo`. Each package is named by
; its stamp, each one's imports go through its own keys, and the program
; links both versions' objects side by side
; (docs/design/separate-compilation.md C10).

(rule
 (deps (source_tree fixtures/versions))
 (targets versions.geometry1.o versions.geometry2.o versions.atlas.o)
 (action
  (progn
   (run %{exe:../../bin/zanec/zanec.exe} --kind library --object versions.geometry1.o --package v1.0%0123456789abcdef%geometry=fixtures/versions/geometry1)
   (run %{exe:../../bin/zanec/zanec.exe} --kind library --object versions.geometry2.o --package v2.0%0123456789abcdef%geometry=fixtures/versions/geometry2)
   (run %{exe:../../bin/zanec/zanec.exe} --kind library --object versions.atlas.o --package v1.0%fedcba9876543210%atlas=fixtures/versions/atlas --package v1.0%0123456789abcdef%geometry=fixtures/versions/geometry1))))

(rule
 (deps (source_tree fixtures/versions))
 (targets versions.exe)
 (action
  (run
   %{exe:../../bin/zanec/zanec.exe}
   --build versions.exe
   --package app=fixtures/versions/app
   --package v2.0%0123456789abcdef%geometry=fixtures/versions/geometry2
   --package v1.0%fedcba9876543210%atlas=fixtures/versions/atlas
   --package v1.0%0123456789abcdef%geometry=fixtures/versions/geometry1
   --import app:geo=v2.0%0123456789abcdef%geometry
   --import app:atlas=v1.0%fedcba9876543210%atlas
   --import v1.0%fedcba9876543210%atlas:geometry=v1.0%0123456789abcdef%geometry
   --link %{dep:versions.geometry1.o}
   --link %{dep:versions.geometry2.o}
   --link %{dep:versions.atlas.o})))

(rule
 (action
  (with-stdout-to
   versions.out.actual
   (run ./versions.exe))))

(rule
 (alias runtest)
 (action
  (diff golden/versions.out versions.out.actual)))

