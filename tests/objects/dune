  (diff golden/versions.ambiguous versions.ambiguous.actual)))

; atlas's object, built against geometry v1.0, remapped onto v1.1 as
; remapping does (docs/design/separate-compilation.md C11): no reference to
; v1.0 is left in it, and a program links it with v1.1 alone.

(rule
 (deps (source_tree fixtures/versions))
 (targets versions.geometry11.o)
 (action
  (run %{exe:../../bin/zanec/zanec.exe} --kind library --object versions.geometry11.o --package v1.1%0123456789abcdef%geometry=fixtures/versions/geometry11)))

(rule
 (targets versions.atlas.remapped.o)
 (action
  (run
   %{exe:../../bin/zanec/zanec.exe}
   --remap
   v1.0%0123456789abcdef%
   v1.1%0123456789abcdef%
   %{dep:versions.atlas.o}
   versions.atlas.remapped.o)))

(rule
 (action
  (with-stdout-to
   versions.atlas.remapped.left
   (system "nm %{dep:versions.atlas.remapped.o} > versions.atlas.remapped.nm && { grep -c 'v1[.]0%0123456789abcdef%' versions.atlas.remapped.nm; test $? -le 1; }"))))

(rule
 (alias runtest)
 (action
  (diff golden/versions.atlas.remapped.left versions.atlas.remapped.left)))

(rule
 (deps (source_tree fixtures/versions))
 (targets remapped.exe)
 (action
  (run
   %{exe:../../bin/zanec/zanec.exe}
   --build remapped.exe
   --package remapped=fixtures/versions/remapped
   --package v1.1%0123456789abcdef%geometry=fixtures/versions/geometry11
   --package v1.0%fedcba9876543210%atlas=fixtures/versions/atlas
   --link %{dep:versions.geometry11.o}
   --link %{dep:versions.atlas.remapped.o})))

(rule
 (action
  (with-stdout-to
   remapped.out.actual
   (run ./remapped.exe))))

(rule
 (alias runtest)
 (action
  (diff golden/remapped.out remapped.out.actual)))

