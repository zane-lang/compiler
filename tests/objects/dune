; Libraries built into objects of their own
; (docs/design/separate-compilation.md). README.md says what each fixture is
; for. A library's code-generation tree shows each function's linkage, and
; its object's defined symbols are listed by `nm`, without their addresses.

(rule
 (deps (source_tree fixtures/geometry))
 (action
  (with-stdout-to
   geometry.cgt.actual
   (run %{exe:../../bin/zanec/zanec.exe} --kind library --cgt --package fixtures/geometry))))

(rule
 (alias runtest)
 (action
  (diff golden/geometry.cgt geometry.cgt.actual)))

(rule
 (deps (source_tree fixtures/geometry))
 (targets geometry.o)
 (action
  (run %{exe:../../bin/zanec/zanec.exe} --kind library --object geometry.o --package fixtures/geometry)))

(rule
 (deps (source_tree fixtures/atlas) (source_tree fixtures/geometry))
 (targets atlas.o)
 (action
  (run
   %{exe:../../bin/zanec/zanec.exe}
   --kind
   library
   --object
   atlas.o
   --package
   fixtures/atlas
   --package
   fixtures/geometry)))

(rule
 (action
  (with-stdout-to
   geometry.symbols.actual
   (system "nm --defined-only %{dep:geometry.o} | sed 's/^[0-9a-f]* //' | LC_ALL=C sort"))))

(rule
 (alias runtest)
 (action
  (diff golden/geometry.symbols geometry.symbols.actual)))

(rule
 (action
  (with-stdout-to
   atlas.symbols.actual
   (system "nm --defined-only %{dep:atlas.o} | sed 's/^[0-9a-f]* //' | LC_ALL=C sort"))))

(rule
 (alias runtest)
 (action
  (diff golden/atlas.symbols atlas.symbols.actual)))

; geometry built on its own with its stamp, as a dependency compiled from
; source is, and survey built against it: survey's object declares
; geometry's verbs and makes the instance it needs, and the program links
; with geometry's object.

(rule
 (deps (source_tree fixtures/geometry))
 (targets geometry.stamped.o)
 (action
  (run
   %{exe:../../bin/zanec/zanec.exe}
   --kind
   library
   --stamp
   geometry=v1.0.1%3f9a1c02b7e4d6a8%
   --object
   geometry.stamped.o
   --package
   fixtures/geometry)))

(rule
 (deps (source_tree fixtures/survey) (source_tree fixtures/geometry))
 (targets survey.o)
 (action
  (run
   %{exe:../../bin/zanec/zanec.exe}
   --stamp
   geometry=v1.0.1%3f9a1c02b7e4d6a8%
   --object
   survey.o
   --package
   fixtures/survey
   --package
   fixtures/geometry)))

(rule
 (action
  (with-stdout-to
   survey.symbols.actual
   (system "nm %{dep:survey.o} | sed 's/^ *[0-9a-f]* //' | grep -v ' [.]L' | LC_ALL=C sort"))))

(rule
 (alias runtest)
 (action
  (diff golden/survey.symbols survey.symbols.actual)))

(rule
 (deps (source_tree fixtures/survey) (source_tree fixtures/geometry))
 (targets survey.exe)
 (action
  (run
   %{exe:../../bin/zanec/zanec.exe}
   --stamp
   geometry=v1.0.1%3f9a1c02b7e4d6a8%
   --link
   %{dep:geometry.stamped.o}
   --build
   survey.exe
   --package
   fixtures/survey
   --package
   fixtures/geometry)))

(rule
 (action
  (with-stdout-to
   survey.out.actual
   (run ./survey.exe))))

(rule
 (alias runtest)
 (action
  (diff golden/survey.out survey.out.actual)))

; geometry's placeholder object rewritten as fetching rewrites a release's
; (docs/design/separate-compilation.md C9). It defines exactly what the
; object built from source with the same stamp does, and survey links with
; it as with that one.

(rule
 (targets geometry.rewritten.o)
 (action
  (run
   %{exe:../../bin/zanec/zanec.exe}
   --rewrite
   v1.0.1%3f9a1c02b7e4d6a8%
   %{dep:geometry.o}
   geometry.rewritten.o)))

(rule
 (action
  (with-stdout-to
   geometry.rewritten.symbols
   (system "nm --defined-only %{dep:geometry.rewritten.o} | sed 's/^[0-9a-f]* //' | LC_ALL=C sort"))))

(rule
 (action
  (with-stdout-to
   geometry.stamped.symbols
   (system "nm --defined-only %{dep:geometry.stamped.o} | sed 's/^[0-9a-f]* //' | LC_ALL=C sort"))))

(rule
 (alias runtest)
 (action
  (diff geometry.stamped.symbols geometry.rewritten.symbols)))

(rule
 (deps (source_tree fixtures/survey) (source_tree fixtures/geometry))
 (targets survey.rewritten.exe)
 (action
  (run
   %{exe:../../bin/zanec/zanec.exe}
   --stamp
   geometry=v1.0.1%3f9a1c02b7e4d6a8%
   --link
   %{dep:geometry.rewritten.o}
   --build
   survey.rewritten.exe
   --package
   fixtures/survey
   --package
   fixtures/geometry)))

(rule
 (action
  (with-stdout-to
   survey.rewritten.out
   (run ./survey.rewritten.exe))))

(rule
 (alias runtest)
 (action
  (diff golden/survey.out survey.rewritten.out)))

; geometry rewritten for macOS (Mach-O) and Windows (COFF) objects, each
; held to the object built from source with the same stamp for that target.
; `llvm-nm` reads both formats, where GNU `nm` reads neither everywhere, and
; `-m` spells out a Mach-O symbol's kind. The x86-64 listings are also
; golden: a shared instance is a `weak external` on Mach-O, and on COFF a
; function in a COMDAT, which `llvm-nm` lists as `T` with no `.weak.` alias
; beside it.

(rule
 (deps (source_tree fixtures/geometry))
 (targets geometry.macos-x86_64.o geometry.macos-x86_64.stamped.o)
 (action
  (progn
   (run %{exe:../../bin/zanec/zanec.exe} --kind library --target x86_64-apple-macosx11.0.0 --object geometry.macos-x86_64.o --package fixtures/geometry)
   (run %{exe:../../bin/zanec/zanec.exe} --kind library --target x86_64-apple-macosx11.0.0 --stamp geometry=v1.0.1%3f9a1c02b7e4d6a8% --object geometry.macos-x86_64.stamped.o --package fixtures/geometry))))

(rule
 (targets geometry.macos-x86_64.rewritten.o)
 (action
  (run %{exe:../../bin/zanec/zanec.exe} --rewrite v1.0.1%3f9a1c02b7e4d6a8% %{dep:geometry.macos-x86_64.o} geometry.macos-x86_64.rewritten.o)))

(rule
 (action
  (with-stdout-to geometry.macos-x86_64.rewritten.symbols
   (system "llvm-nm -m %{dep:geometry.macos-x86_64.rewritten.o} | LC_ALL=C sort"))))

(rule
 (action
  (with-stdout-to geometry.macos-x86_64.stamped.symbols
   (system "llvm-nm -m %{dep:geometry.macos-x86_64.stamped.o} | LC_ALL=C sort"))))

(rule
 (alias runtest)
 (action (diff geometry.macos-x86_64.stamped.symbols geometry.macos-x86_64.rewritten.symbols)))

(rule
 (alias runtest)
 (action (diff golden/geometry.macos-x86_64.symbols geometry.macos-x86_64.rewritten.symbols)))

(rule
 (deps (source_tree fixtures/geometry))
 (targets geometry.macos-arm64.o geometry.macos-arm64.stamped.o)
 (action
  (progn
   (run %{exe:../../bin/zanec/zanec.exe} --kind library --target arm64-apple-macosx11.0.0 --object geometry.macos-arm64.o --package fixtures/geometry)
   (run %{exe:../../bin/zanec/zanec.exe} --kind library --target arm64-apple-macosx11.0.0 --stamp geometry=v1.0.1%3f9a1c02b7e4d6a8% --object geometry.macos-arm64.stamped.o --package fixtures/geometry))))

(rule
 (targets geometry.macos-arm64.rewritten.o)
 (action
  (run %{exe:../../bin/zanec/zanec.exe} --rewrite v1.0.1%3f9a1c02b7e4d6a8% %{dep:geometry.macos-arm64.o} geometry.macos-arm64.rewritten.o)))

(rule
 (action
  (with-stdout-to geometry.macos-arm64.rewritten.symbols
   (system "llvm-nm -m %{dep:geometry.macos-arm64.rewritten.o} | LC_ALL=C sort"))))

(rule
 (action
  (with-stdout-to geometry.macos-arm64.stamped.symbols
   (system "llvm-nm -m %{dep:geometry.macos-arm64.stamped.o} | LC_ALL=C sort"))))

(rule
 (alias runtest)
 (action (diff geometry.macos-arm64.stamped.symbols geometry.macos-arm64.rewritten.symbols)))

(rule
