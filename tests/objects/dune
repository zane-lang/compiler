(rule
 (deps (source_tree fixtures/geometry))
 (targets geometry.windows-arm64.o geometry.windows-arm64.stamped.o)
 (action
  (progn
   (run %{exe:../../bin/zanec/zanec.exe} --kind library --target aarch64-pc-windows-msvc --object geometry.windows-arm64.o --package fixtures/geometry)
