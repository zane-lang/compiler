(rule
 (action
  (with-stdout-to geometry.windows-arm64.rewritten.symbols
   (system "llvm-nm %{dep:geometry.windows-arm64.rewritten.o} | LC_ALL=C sort"))))

(rule
 (action
  (with-stdout-to geometry.windows-arm64.stamped.symbols
   (system "llvm-nm %{dep:geometry.windows-arm64.stamped.o} | LC_ALL=C sort"))))

(rule
 (alias runtest)
 (action (diff geometry.windows-arm64.stamped.symbols geometry.windows-arm64.rewritten.symbols)))
