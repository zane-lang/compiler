; geometry rewritten for macOS (Mach-O) and Windows (COFF) objects, each
; held to the object built from source with the same stamp for that target.
; `llvm-nm` reads both formats, where GNU `nm` reads neither everywhere, and
; `-m` spells out a Mach-O symbol's kind. The x86-64 listings are also
; golden: a shared instance is a `weak external` on Mach-O, and on COFF a
; function in a COMDAT, which `llvm-nm` lists as `T` with no `.weak.` alias
; beside it.

(rule
 (deps (source_tree fixtures/geometry))
 (targets geometry.macos-x86_64.o geometry.macos-x86_64.stamped.o)
 (action
  (progn
   (run %{exe:../../bin/zanec/zanec.exe} --kind library --target x86_64-apple-macosx11.0.0 --object geometry.macos-x86_64.o --package fixtures/geometry)
   (run %{exe:../../bin/zanec/zanec.exe} --kind library --target x86_64-apple-macosx11.0.0 --stamp geometry=v1.0.1%3f9a1c02b7e4d6a8% --object geometry.macos-x86_64.stamped.o --package fixtures/geometry))))

(rule
 (targets geometry.macos-x86_64.rewritten.o)
 (action
  (run %{exe:../../bin/zanec/zanec.exe} --rewrite v1.0.1%3f9a1c02b7e4d6a8% %{dep:geometry.macos-x86_64.o} geometry.macos-x86_64.rewritten.o)))

(rule
 (action
  (with-stdout-to geometry.macos-x86_64.rewritten.symbols
   (system "llvm-nm -m %{dep:geometry.macos-x86_64.rewritten.o} | LC_ALL=C sort"))))

(rule
 (action
  (with-stdout-to geometry.macos-x86_64.stamped.symbols
   (system "llvm-nm -m %{dep:geometry.macos-x86_64.stamped.o} | LC_ALL=C sort"))))

(rule
 (alias runtest)
 (action (diff geometry.macos-x86_64.stamped.symbols geometry.macos-x86_64.rewritten.symbols)))

(rule
 (alias runtest)
 (action (diff golden/geometry.macos-x86_64.symbols geometry.macos-x86_64.rewritten.symbols)))

(rule
 (deps (source_tree fixtures/geometry))
 (targets geometry.macos-arm64.o geometry.macos-arm64.stamped.o)
 (action
  (progn
   (run %{exe:../../bin/zanec/zanec.exe} --kind library --target arm64-apple-macosx11.0.0 --object geometry.macos-arm64.o --package fixtures/geometry)
   (run %{exe:../../bin/zanec/zanec.exe} --kind library --target arm64-apple-macosx11.0.0 --stamp geometry=v1.0.1%3f9a1c02b7e4d6a8% --object geometry.macos-arm64.stamped.o --package fixtures/geometry))))

