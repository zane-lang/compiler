; Writes the repetitive rules of the test directories beside it; see the
; comment at the top of gen_rules.ml. fixture_pairing.ml pairs each golden
; file with its fixture, and tests/unit/ tests fixture_pairing.ml alone.
(library
 (name fixture_pairing)
 (modules fixture_pairing))

(executable
 (name gen_rules)
 (modules gen_rules)
 (libraries fixture_pairing))

