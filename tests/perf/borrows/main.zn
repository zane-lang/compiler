/// Two lists behind an `&` reference, read by a recursive function that
/// stays out of line: one list on every pass of its loop, the other only
/// on the passes a comparison picks. The function is told the reference's
/// whole slot is there, so it reads both lists' counts and blocks once,
/// before the loop.
package borrows;

alias Int = @primitives$I64
alias Float = @primitives$F64
alias Unit = @primitives$Unit
alias String = @primitives$String
alias List<T Type> = @primitives$List<T>

/// Advances the counter through the inclusive range, running the block once
/// per step.
Unit to(this Int, end Int, body @concepts$Block) mut {
	@controlflow$repeat(@operators$add(@operators$add(end, @operators$negate(this)), Int(1)), {
		@controlflow$branch(true, body);
		this = @operators$add(this, Int(1));
	});
	return Unit();
}

/// The size the program was started with: its first argument, or
/// `fallback` when it has none or the first spells no integer.
Int size(fallback Int) {
	args List<String> = @program$runtime:arguments();
	@controlflow$branch(@operators$lessThan(args:size(), Int(1)), {
		return fallback;
	});
	return args[Int(1)]:parseI64() ?? fallback;
}

Unit say(text String) {
	@program$console!print(@operators$concat(text, String("\n")));
	return Unit();
}

type Field = #struct {
	xs List<Float>;
	ys List<Float>;
}

Field(xs ^List<Float>, ys ^List<Float>) => init{ xs; ys; }

/// The sum of each `ys` whose `xs` is below `wall`, over the first `n`
/// points, once for this depth and once for each below it.
Float scan(field &Field, n Int, wall Float, depth Int) {
	acc Float(0.0);
	@controlflow$branch(@operators$lessThan(Int(0), depth), {
		acc = scan(field, n, wall, @operators$add(depth, @operators$negate(Int(1))));
	});
	j Int(1);
	j!to(n) {
		@controlflow$branch(@operators$lessThan(field.xs[j], wall), {
			acc = @operators$add(acc, field.ys[j]);
		});
	}
	return acc;
}

Unit main() {
	n Int(20000);
	passes Int = size(Int(150));
	xs ^List<Float> = @primitives$List(Float);
	ys ^List<Float> = @primitives$List(Float);
	i Int(1);
	i!to(n) {
		q Int = @operators$multiply(i, Int(37));
		xs!push(@primitives$F64.round(@operators$add(q, @operators$negate(@operators$multiply(@operators$divide(q, Int(800)), Int(800))))));
		ys!push(@primitives$F64.round(i));
	}
	field Field(xs, ys);
	acc Float(0.0);
	f Int(1);
	f!to(passes) {
		acc = @operators$add(acc, scan(field, n, @primitives$F64.round(@operators$add(Int(300), f)), Int(1)));
	}
	say(String(@primitives$I64.truncate(acc)));
	return Unit();
}
