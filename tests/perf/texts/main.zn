/// Strings built, joined and compared: every number up to N written as
/// text and joined onto two growing lines, built in different orders and
/// compared after each number, then started over every hundred numbers.
package texts;

alias Int = @primitives$I64;
alias Float = @primitives$F64;
alias Bool = @primitives$Bool;
alias Unit = @primitives$Unit;
alias String = @primitives$String;
alias ListRef<T Type> = @primitives$ListRef<T>;

/// Advances the counter through the inclusive range, running the block once
/// per step.
Unit to(this Int, end Int, body @concepts$Block) mut {
	@controlflow$repeat(@operators$add(@operators$add(end, @operators$negate(this)), Int(1)), {
		@controlflow$branch(true, body);
		this = @operators$add(this, Int(1));
	});
	return Unit();
}

/// The size the program was started with: its first argument, or
/// `fallback` when it has none or the first spells no integer.
Int size(fallback Int) {
	args @primitives$List<String> = @program$runtime:arguments();
	@controlflow$branch(@operators$lessThan(args:size(), Int(1)), {
		return fallback;
	});
	return args[Int(1)]:parseI64() ?? fallback;
}

Unit say(text String) {
	@program$console!print(@operators$concat(text, String.escaped("\n")));
	return Unit();
}


Unit main() {
	n Int = size(Int(100));
	same Int(0);
	resets Int(0);
	line String("");
	other String("");
	i Int(1);
	i!to(n) {
		digits String = String(i);
		line = @operators$concat(@operators$concat(line, digits), String(","));
		other = @operators$concat(other, @operators$concat(digits, String(",")));
		@controlflow$branch(@operators$equal(line, other), {
			same = @operators$add(same, Int(1));
		});
		@controlflow$branch(@operators$equal(@operators$multiply(@operators$divide(i, Int(100)), Int(100)), i), {
			resets = @operators$add(resets, Int(1));
			line = String("");
			other = String("");
		});
	}
	say(@operators$concat(@operators$concat(String(same), String(" ")), String(resets)));
	return Unit();
}
