/// A tape machine whose state is a struct local, as a worker's subject
/// must be (control-flow.md §3.7): the tape, the program, its jumps and the
/// counter are the struct's fields, and the program and jumps are lists
/// copied into it, so the struct's frame slot holds each list's count and
/// room stored as one pair. The machine runs its program once as a worker
/// and once as a counted loop over the same fields, each pass testing the
/// counter against the program's count, which stays in a register across
/// the loop rather than being loaded from the frame again each pass.
package subjects;

alias Int = @primitives$I64;
alias Bool = @primitives$Bool;
alias Unit = @primitives$Unit;
alias String = @primitives$String;
alias List<T Type> = @primitives$List<T>;

/// Advances the counter through the inclusive range, running the block once
/// per step.
Unit to(this Int, end Int, body @concepts$Block) mut {
	@controlflow$repeat(@operators$add(@operators$add(end, @operators$negate(this)), Int(1)), {
		@controlflow$branch(true, body);
		this = @operators$add(this, Int(1));
	});
	return Unit();
}

Unit work(this S Type, step Bool[this S] mut) mut {
	this!@controlflow$work(step);
	return Unit();
}

/// The size the program was started with: its first argument, or
/// `fallback` when it has none or the first spells no integer.
Int size(fallback Int) {
	args List<String> = @program$runtime:arguments();
	@controlflow$branch(@operators$lessThan(args:size(), Int(1)), {
		return fallback;
	});
	return args[Int(1)]:parseI64() ?? fallback;
}

Int plus(a Int, b Int) => @operators$add(a, b);
Int minus(a Int, b Int) => @operators$add(a, @operators$negate(b));
Int times(a Int, b Int) => @operators$multiply(a, b);
Int over(a Int, b Int) => @operators$divide(a, b);
Int modulo(a Int, b Int) => minus(a, times(over(a, b), b));
Bool below(a Int, b Int) => @operators$lessThan(a, b);
Bool atMost(a Int, b Int) => below(a, plus(b, Int(1)));
Bool same(a Int, b Int) => @operators$equal(a, b);

/// The linear congruential generator langbench uses.
type Rng = #struct {
	state Int;
}

Rng(seed Int) => init{ state = seed; }

Int next(this Rng) mut {
	this.state = @math$bitAnd(plus(times(this.state, Int(1103515245)), Int(12345)), Int(2147483647));
	return this.state;
}

/// A number below `bound`, from the generator's high bits.
Int pick(this Rng, bound Int) mut => modulo(over(this!next(), Int(65536)), bound);

type Tape = #struct {
	cells List<Int>;
	at Int;
	total Int;
}

Tape() {
	cells List<Int> = @primitives$List(Int);
	cells!push(Int(0));
	return init{ cells; at = Int(1); total = Int(0); }
}

/// The worker's copy of `run`, so each copy has one caller and is
/// inlined into its loop, as LangArena's Brainfuck runners are. One operation: 0 moves right, growing the tape by a push past its end,
/// which is rare; 1 moves left; 2 steps the cell; 3 adds the cell to the
/// total.
Unit runWorked(this Tape, op Int) mut {
	@controlflow$branch(same(op, Int(0)), {
		this.at = plus(this.at, Int(1));
		@controlflow$branch(below(this.cells:size(), this.at), {
			this.cells!push(Int(0));
		});
	});
	@controlflow$branch(same(op, Int(1)), {
		@controlflow$branch(below(Int(1), this.at), {
			this.at = minus(this.at, Int(1));
		});
	});
	@controlflow$branch(same(op, Int(2)), {
		this.cells[this.at] = @math$bitAnd(plus(this.cells[this.at], Int(1)), Int(255));
	});
	@controlflow$branch(same(op, Int(3)), {
		this.total = @math$bitAnd(plus(this.total, this.cells[this.at]), Int(1048575));
	});
	return Unit();
}

/// The counted loop's copy. One operation: 0 moves right, growing the tape by a push past its end,
/// which is rare; 1 moves left; 2 steps the cell; 3 adds the cell to the
/// total.
Unit runCounted(this Tape, op Int) mut {
	@controlflow$branch(same(op, Int(0)), {
		this.at = plus(this.at, Int(1));
		@controlflow$branch(below(this.cells:size(), this.at), {
			this.cells!push(Int(0));
		});
	});
	@controlflow$branch(same(op, Int(1)), {
		@controlflow$branch(below(Int(1), this.at), {
			this.at = minus(this.at, Int(1));
		});
	});
	@controlflow$branch(same(op, Int(2)), {
		this.cells[this.at] = @math$bitAnd(plus(this.cells[this.at], Int(1)), Int(255));
	});
	@controlflow$branch(same(op, Int(3)), {
		this.total = @math$bitAnd(plus(this.total, this.cells[this.at]), Int(1048575));
	});
	return Unit();
}

/// The machine: its tape, the program, where each skip lands, and the
/// counter. An operation 4 skips to its landing when the cell is odd.
type Machine = #struct {
	tape Tape;
	ops List<Int>;
	jumps List<Int>;
	pc Int;
}

Machine(ops List<Int>, jumps List<Int>) => init{ tape = Tape(); ops; jumps; pc = Int(1); }

/// The program run as a worker, its machine a local of this function.
Int worked(ops List<Int>, jumps List<Int>) {
	m Machine = Machine(ops, jumps);
	m!work(Bool(this Machine) mut {
		op Int = this.ops[this.pc];
		@controlflow$branch(same(op, Int(4)), {
			@controlflow$branch(same(@math$bitAnd(this.tape.cells[this.tape.at], Int(1)), Int(1)), {
				this.pc = this.jumps[this.pc];
			});
		});
		this.tape!runWorked(op);
		this.pc = plus(this.pc, Int(1));
		return atMost(this.pc, this.ops:size());
	});
	return plus(m.tape.total, m.tape.cells:size());
}

/// The program run as a counted loop over the machine's fields, which
/// returns once the counter passes the last operation.
Int counted(ops List<Int>, jumps List<Int>) {
	m Machine = Machine(ops, jumps);
	k Int(1);
	k!to(Int(9223372036854775807)) {
		@controlflow$branch(below(m.ops:size(), m.pc), {
			return plus(m.tape.total, m.tape.cells:size());
		});
		op Int = m.ops[m.pc];
		@controlflow$branch(same(op, Int(4)), {
			@controlflow$branch(same(@math$bitAnd(m.tape.cells[m.tape.at], Int(1)), Int(1)), {
				m.pc = m.jumps[m.pc];
			});
		});
		m.tape!runCounted(op);
		m.pc = plus(m.pc, Int(1));
	}
	return Int(0);
}

Unit main() {
	rounds Int = size(Int(10));
	ops List<Int> = @primitives$List(Int);
	jumps List<Int> = @primitives$List(Int);
	rng Rng(Int(41));
	n Int(1);
	n!to(Int(4000)) {
		ops!push(rng!pick(Int(5)));
		jumps!push(plus(n, Int(2)));
	}
	total Int(0);
	@controlflow$repeat(rounds, {
		total = @math$bitAnd(plus(total, plus(worked(ops, jumps), counted(ops, jumps))), Int(1048575));
	});
	@program$console!print(@operators$concat(String(total), String.escaped("\n")));
	return Unit();
}
