/// An entity table with optional components: a list of value structs whose
/// position, velocity and health are each a variant that is empty or holds
/// a value. Three systems run over the list every frame and act only on the
/// entities that have the components they need: movement needs a position
/// and a velocity, damage needs a health and a position, and a sweep
/// removes the velocity from the entities that have left the arena.
package entities;

alias Int = @primitives$I64;
alias Float = @primitives$F64;
alias Bool = @primitives$Bool;
alias Unit = @primitives$Unit;
alias String = @primitives$String;
alias ListRef<T Type> = @primitives$ListRef<T>;

/// Advances the counter through the inclusive range, running the block once
/// per step.
Unit to(this Int, end Int, body @concepts$Block) mut {
	@controlflow$repeat(@operators$add(@operators$add(end, @operators$negate(this)), Int(1)), {
		@controlflow$branch(true, body);
		this = @operators$add(this, Int(1));
	});
	return Unit();
}

/// The size the program was started with: its first argument, or
/// `fallback` when it has none or the first spells no integer.
Int size(fallback Int) {
	args @primitives$List<String> = @program$runtime:arguments();
	@controlflow$branch(@operators$lessThan(args:size(), Int(1)), {
		return fallback;
	});
	return args[Int(1)]:parseI64() ?? fallback;
}

Unit say(text String) {
	@program$console!print(@operators$concat(text, String.escaped("\n")));
	return Unit();
}

Int plus(a Int, b Int) => @operators$add(a, b);
Int minus(a Int, b Int) => @operators$add(a, @operators$negate(b));
Int times(a Int, b Int) => @operators$multiply(a, b);
Int over(a Int, b Int) => @operators$divide(a, b);
Int modulo(a Int, b Int) => minus(a, times(over(a, b), b));
Bool below(a Int, b Int) => @operators$lessThan(a, b);
Float real(v Int) => @primitives$F64.round(v);

/// The linear congruential generator langbench uses.
type Rng = #struct {
	state Int;
}

Rng(seed Int) => init{ state = seed; }

Int next(this Rng) mut {
	this.state = @math$bitAnd(plus(times(this.state, Int(1103515245)), Int(12345)), Int(2147483647));
	return this.state;
}

/// A float in [0, 1) from the generator.
Float unit(this Rng) mut => @operators$divide(real(modulo(this!next(), Int(10000))), Float(10000.0));

type Position = struct {
	x Int;
	y Int;
}

Position(x Int, y Int) => init{ x; y; }

type MaybePosition = variant {
	none Unit;
	some Position;
}

type Velocity = struct {
	dx Int;
	dy Int;
}

Velocity(dx Int, dy Int) => init{ dx; dy; }

type MaybeVelocity = variant {
	none Unit;
	some Velocity;
}

type MaybeHealth = variant {
	none Unit;
	some Int;
}

type Entity = struct {
	id Int;
	position MaybePosition;
	velocity MaybeVelocity;
	health MaybeHealth;
}

Entity(id Int, position MaybePosition, velocity MaybeVelocity, health MaybeHealth) => init{ id; position; velocity; health; }

/// Which components entity `id` has is chosen from the generator, each
/// present about two times in three.
Entity make(this Rng, id Int) mut {
	position MaybePosition = MaybePosition.none(Unit());
	velocity MaybeVelocity = MaybeVelocity.none(Unit());
	health MaybeHealth = MaybeHealth.none(Unit());
	@controlflow$branch(below(modulo(this!next(), Int(3)), Int(2)), {
		position = MaybePosition.some(Position(modulo(this!next(), Int(1000)), modulo(this!next(), Int(1000))));
	});
	@controlflow$branch(below(modulo(this!next(), Int(3)), Int(2)), {
		velocity = MaybeVelocity.some(Velocity(minus(modulo(this!next(), Int(21)), Int(10)), minus(modulo(this!next(), Int(21)), Int(10))));
	});
	@controlflow$branch(below(modulo(this!next(), Int(3)), Int(2)), {
		health = MaybeHealth.some(plus(Int(50), modulo(this!next(), Int(50))));
	});
	return Entity(id, position, velocity, health);
}

/// The position moved by the velocity, when there are both.
MaybePosition shifted(position MaybePosition, velocity MaybeVelocity) => match (velocity) {
	v some => match (position) {
		p some => MaybePosition.some(Position(plus(p.x, v.dx), plus(p.y, v.dy)));
		none => position;
	};
	none => position;
}

/// One when the entity has the components movement needs.
Int mobile(position MaybePosition, velocity MaybeVelocity) => match (velocity) {
	v some => match (position) {
		p some => Int(1);
		none => Int(0);
	};
	none => Int(0);
}

/// The damage dealt to an entity with health and a position: more the
/// nearer the left edge it is.
Int harm(health MaybeHealth, position MaybePosition) => match (health) {
	h some => match (position) {
		p some => over(minus(Int(1100), p.x), Int(300));
		none => Int(0);
	};
	none => Int(0);
}

MaybeHealth hurt(health MaybeHealth, damage Int) => match (health) {
	h some => MaybeHealth.some(minus(h, damage));
	none => health;
}

/// Health that ran out is dropped.
MaybeHealth culled(health MaybeHealth) => match (health) {
	h some {
		@controlflow$branch(below(h, Int(1)), {
			return MaybeHealth.none(Unit());
		});
		return health;
	}
	none => health;
}

Int dead(health MaybeHealth) => match (health) {
	h some {
		@controlflow$branch(below(h, Int(1)), {
			return Int(1);
		});
		return Int(0);
	}
	none => Int(0);
}

/// The velocity of an entity that has left the arena is dropped.
MaybeVelocity grounded(velocity MaybeVelocity, position MaybePosition) => match (position) {
	p some {
		@controlflow$branch(@operators$not(below(p.x, Int(1000))), {
			return MaybeVelocity.none(Unit());
		});
		@controlflow$branch(below(p.x, Int(0)), {
			return MaybeVelocity.none(Unit());
		});
		return velocity;
	}
	none => velocity;
}

Int stranded(velocity MaybeVelocity, position MaybePosition) => match (velocity) {
	v some => match (position) {
		p some {
			@controlflow$branch(@operators$not(below(p.x, Int(1000))), {
				return Int(1);
			});
			@controlflow$branch(below(p.x, Int(0)), {
				return Int(1);
			});
			return Int(0);
		}
		none => Int(0);
	};
	none => Int(0);
}

Int positionSum(position MaybePosition) => match (position) {
	p some => plus(p.x, times(Int(3), p.y));
	none => Int(0);
}

Int healthSum(health MaybeHealth) => match (health) {
	h some => h;
	none => Int(0);
}

Unit main() {
	n Int = size(Int(2000));
	rng Rng(Int(5));
	entities ListRef<Entity> = @primitives$ListRef(Entity);
	i Int(1);
	i!to(n) {
		entities!push(rng!make(i));
	}
	moved Int(0);
	dealt Int(0);
	removed Int(0);
	frame Int(1);
	frame!to(Int(40)) {
		// Movement.
		k Int(1);
		k!to(n) {
			moved = plus(moved, mobile(entities[k].position, entities[k].velocity));
			entities[k].position = shifted(entities[k].position, entities[k].velocity);
		}
		// Damage.
		k = Int(1);
		k!to(n) {
			damage Int = harm(entities[k].health, entities[k].position);
			dealt = plus(dealt, damage);
			entities[k].health = hurt(entities[k].health, damage);
		}
		// The sweep.
		k = Int(1);
		k!to(n) {
			removed = plus(removed, plus(dead(entities[k].health), stranded(entities[k].velocity, entities[k].position)));
			entities[k].health = culled(entities[k].health);
			entities[k].velocity = grounded(entities[k].velocity, entities[k].position);
		}
	}
	checksum Int(0);
	k Int(1);
	k!to(n) {
		checksum = plus(checksum, plus(positionSum(entities[k].position), healthSum(entities[k].health)));
	}
	say(@operators$concat(@operators$concat(@operators$concat(String(n), String(" ")), @operators$concat(String(moved), String(" "))), @operators$concat(@operators$concat(String(dealt), String(" ")), @operators$concat(@operators$concat(String(removed), String(" ")), String(checksum)))));
	return Unit();
}
