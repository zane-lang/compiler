/// Values a call left to run is given no address of, kept known past it: a
/// random generator held in a value struct, and the draws taken from it,
/// worked out while compiling though a counter the running program advances
/// sits between them. What is left to run sums with the size it was given.
package kept;

alias Int = @primitives$I64
alias Unit = @primitives$Unit
alias String = @primitives$String
alias List<T Type> = @primitives$List<T>

/// Advances the counter through the inclusive range, running the block once
/// per step.
Unit to(this Int, end Int, body @concepts$Block) mut {
	@controlflow$repeat(@operators$add(@operators$add(end, @operators$negate(this)), Int(1)), {
		@controlflow$branch(true, body);
		this = @operators$add(this, Int(1));
	});
	return Unit();
}

/// The size the program was started with: its first argument, or
/// `fallback` when it has none or the first spells no integer.
Int size(fallback Int) {
	args List<String> = @program$runtime:arguments();
	@controlflow$branch(@operators$lessThan(args:size(), Int(1)), {
		return fallback;
	});
	return args[Int(1)]:parseI64() ?? fallback;
}

Unit say(text String) {
	@program$console!print(@operators$concat(text, String.escaped("\n")));
	return Unit();
}

Int modulo(n Int, by Int) => @operators$add(n, @operators$negate(@operators$multiply(@operators$divide(n, by), by)))

type Random = struct {
	state Int;
}

Random(state Int) => init{ state; }

/// The next number from 0 to 99, by the C library's old linear
/// congruential step.
Int next(this Random) mut {
	this.state = modulo(@operators$add(@operators$multiply(this.state, Int(1103515245)), Int(12345)), Int(2147483648));
	return modulo(@operators$divide(this.state, Int(65536)), Int(100));
}

/// The sum of `count` draws.
Int draws(this Random, count Int) mut {
	total Int(0);
	@controlflow$repeat(count, {
		total = @operators$add(total, this!next());
	});
	return total;
}

Int bumped(this Int, by Int) mut {
	this = @operators$add(this, by);
	return this;
}

Unit main() {
	rounds Int = size(Int(100));
	random Random(Int(42));
	first Int = random!draws(Int(1000));
	reads Int(0);
	reads!bumped(rounds);
	second Int = random!draws(Int(60000));
	found Int(0);
	r Int(1);
	r!to(reads) {
		found = modulo(@operators$add(found, @operators$multiply(r, second)), Int(1000003));
	}
	say(@operators$concat(@operators$concat(@operators$concat(@operators$concat(String(first), String(" ")), String(second)), String(" ")), String(found)));
	return Unit();
}
