#!/usr/bin/env python3
"""Measure each perf program's two builds in estimated cycles.

Each directory here is one package, a program that reads its size from the
`arguments` file beside it. It is built twice, `optimized` with `--optimize`
and `plain` without it, as `zane run` builds, and each build is run once under
Valgrind's Callgrind with the cache and branch simulators on. What each
printed is held to `golden/NAME.out`. What the simulators counted for the
whole process, the C library's work included, becomes estimated cycles:

    instructions + 10 x first-level misses + 100 x last-level misses
                 + 20 x mispredicted branches

The caches simulated are fixed, not read from the machine, so every machine
simulates the same ones: 32 KiB first-level instruction and data caches and
an 8 MiB last-level cache, each with 64-byte lines. A simulated cycle is the
same on every run of one build, which is what lets one commit's build be
compared with the next; it is an estimate for a generic processor, not a
time on any real one.

    tests/perf/run                            # measure every program, both builds
    tests/perf/run flips trees                # measure these
    tests/perf/run --build plain              # measure one build of each
    tests/perf/run --against latest.tsv       # and fail if one is slower than its row there
    tests/perf/run --record DIR --commit SHA  # and write DIR's log as SHA's
    tests/perf/run --against latest.tsv --fresh  # and run even the builds its rows hold
    tests/perf/run --promote                  # write golden/NAME.out from this build

`--against` fails when a build's estimated cycles are more than
`TOLERANCE` above its row; a build with no row passes. `--record` writes
`DIR/latest.tsv`, one row per program and build, over what was there, and
appends the `LOGGED` program's rows to its histories, `DIR/LOGGED.tsv` for
the optimized build and `DIR/LOGGED-plain.tsv` for the plain one. It records a build
that is slower and still fails, and records nothing when a program fails to
build, to run or to print its golden output. CI keeps both on
the `perf-log` branch (`.github/scripts/perf`). `--zanec`, or `ZANEC` in the
environment, measures another build of the compiler.

Each row also holds its build's key: a hash of the executable built,
its `arguments`, what it printed, this script, and Valgrind's resolved path
and version, everything the counts follow from. With `--against`, a build
is not run again when it, taken with its golden output, has its row's key:
the counts are the row's, since the same build run the same way counts the
same. `--fresh` measures every build anyway.
"""

import argparse
from concurrent.futures import ThreadPoolExecutor
import hashlib
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile

HERE = Path(__file__).resolve().parent
ROOT = HERE.parents[1]
GOLDEN = HERE / "golden"
TOLERANCE = 0.01
LOGGED = "stress"
CACHES = ["--I1=32768,8,64", "--D1=32768,8,64", "--LL=8388608,16,64"]
COUNTS = ["cycles", "instructions", "l1_misses", "ll_misses", "mispredicts"]
COLUMNS = ["program", "commit", "date", *COUNTS]
# The histories keep the columns they started with; latest.tsv adds the key
# and the build. A row from before plain builds were measured has no build
# column, and is the optimized one.
LATEST = [*COLUMNS, "key", "build"]
# Each build's flags. The plain one is what `zane run` builds.
BUILDS = {"optimized": ["--optimize"], "plain": []}


def history(build):
    """The file the `LOGGED` program's rows for *build* are appended to."""
    return f"{LOGGED}.tsv" if build == "optimized" else f"{LOGGED}-{build}.tsv"


def programs():
    return sorted(p.name for p in HERE.iterdir() if p.is_dir() and (p / "main.zn").exists())


def totals(profile):
    """The whole process's count of each event Callgrind recorded: the
    `summary:` line its profile ends with."""
    events = None
    for line in profile.read_text().splitlines():
        if line.startswith("events:"):
            events = line.split()[1:]
        elif line.startswith("summary:"):
            return dict(zip(events, map(int, line.split()[1:])))
    raise ValueError(f"{profile} has no summary line")


def build_key(name, exe, printed, valgrind):
    """What the counts of program `name` built as *exe*, printing *printed*,
    follow from, hashed."""
    digest = hashlib.sha256()
    for part in [exe.read_bytes(), (HERE / name / "arguments").read_bytes(),
                 printed.encode(), Path(__file__).read_bytes(), valgrind]:
        digest.update(hashlib.sha256(part).digest())
    return digest.hexdigest()


def measure(zanec, name, build, work, valgrind, row):
    """What program `name`'s *build* printed and its counts, or why it has
    none. A *row* with the build's key gives its counts without running it."""
    exe, profile = work / f"{name}.{build}", work / f"{name}.{build}.callgrind"
    built = subprocess.run(
        [zanec, "--build", exe, *BUILDS[build], "--package", HERE / name],
        capture_output=True, text=True)
    if built.returncode:
        return name, build, None, f"build failed:\n{built.stdout}{built.stderr}"
    # A recorded key holds what its program printed, so a row whose key is
    # this build's printing the golden output printed that output too.
    out = GOLDEN / f"{name}.out"
    if row and out.exists():
        golden = out.read_text()
        key = build_key(name, exe, golden, valgrind)
        if row.get("key") == key:
            return name, build, {
                "output": golden,
                **{k: int(row[k]) for k in COUNTS},
                "key": key,
                "reused": row["commit"],
            }, None
    args = (HERE / name / "arguments").read_text().split()
    ran = subprocess.run(
        ["valgrind", "-q", "--tool=callgrind", "--cache-sim=yes", "--branch-sim=yes", *CACHES,
         f"--callgrind-out-file={profile}", exe, *args],
        capture_output=True, text=True)
    if ran.returncode:
        return name, build, None, f"exited with {ran.returncode}:\n{ran.stdout}{ran.stderr}"
    e = totals(profile)
    l1 = e["I1mr"] + e["D1mr"] + e["D1mw"]
    ll = e["ILmr"] + e["DLmr"] + e["DLmw"]
    mispredicts = e["Bcm"] + e["Bim"]
    return name, build, {
        "output": ran.stdout,
        "cycles": e["Ir"] + 10 * l1 + 100 * ll + 20 * mispredicts,
        "instructions": e["Ir"],
        "l1_misses": l1,
        "ll_misses": ll,
        "mispredicts": mispredicts,
        "key": build_key(name, exe, ran.stdout, valgrind),
        "reused": None,
    }, None


def read_rows(path):
    """A log's rows, keyed by program and build; a missing log has none."""
    if path is None or not path.exists():
        return {}
    lines = path.read_text().splitlines()
    header = lines[0].split("\t")
    rows = [dict(zip(header, line.split("\t"))) for line in lines[1:] if line]
    return {(row["program"], row.get("build", "optimized")): row for row in rows}


def write_log(directory, commit, results):
    commit, date = subprocess.run(
        ["git", "-C", ROOT, "show", "-s", "--format=%H %cd", "--date=format-local:%Y-%m-%dT%H:%M:%SZ", commit],
        capture_output=True, text=True, check=True, env={**os.environ, "TZ": "UTC"}).stdout.split()
    directory.mkdir(parents=True, exist_ok=True)

    def row(name, result, extra=()):
        return "\t".join([name, commit, date, *(str(result[k]) for k in COUNTS), *extra]) + "\n"

    (directory / "latest.tsv").write_text(
        "\t".join(LATEST) + "\n" + "".join(row(n, r, [r["key"], b]) for n, b, r in results))
    for name, build, result in results:
        if name == LOGGED:
            log = directory / history(build)
            if not log.exists():
                log.write_text("\t".join(COLUMNS) + "\n")
            with log.open("a") as out:
                out.write(row(name, result))


def problems_of(name, result, row):
    """What is wrong with what a build of `name` printed, and with how long
    it took."""
    problems, slow = [], []
    out = GOLDEN / f"{name}.out"
    if not out.exists():
        problems.append(f"no golden/{name}.out")
    elif out.read_text() != result["output"]:
        problems.append(f"printed {result['output']!r}, not golden/{name}.out's {out.read_text()!r}")
    if row:
        was = int(row["cycles"])
        if result["cycles"] > was * (1 + TOLERANCE):
            slow.append(f"{(result['cycles'] - was) / was:.2%} more estimated cycles than"
                            f" {row['commit'][:12]}'s {was}, past the {TOLERANCE:.0%} allowed")
    return problems, slow


def change(row, key, now):
    if not row:
        return "new"
    was = int(row[key])
    return f"{(now - was) / was:+.2%}" if was else "new"


def main():
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    parser.add_argument("names", nargs="*", help="programs to run; every one when none is named")
    parser.add_argument("--against", type=Path, metavar="LOG", help="fail if slower than LOG's rows")
    parser.add_argument("--record", type=Path, metavar="DIR", help="write DIR's log from this build")
    parser.add_argument("--commit", help="the commit recorded rows are for")
    parser.add_argument("--build", choices=BUILDS, action="append", dest="builds",
                        help="measure this build only; both when none is named")
    parser.add_argument("--promote", action="store_true", help="write golden/NAME.out from this build")
    parser.add_argument("--fresh", action="store_true",
                        help="measure every build, even one whose key is its row's")
    parser.add_argument("--zanec", type=Path, default=os.environ.get("ZANEC"),
                        help="the compiler to build with (default: this checkout's)")
    options = parser.parse_args()
    if options.record and not options.commit:
        sys.exit("--record needs --commit")
    zanec = options.zanec or ROOT / "_build" / "default" / "bin" / "zanec" / "zanec.exe"
    if not Path(zanec).exists():
        sys.exit(f"no compiler at {zanec}: dune build bin/zanec/zanec.exe")
    if shutil.which("valgrind") is None:
        sys.exit("valgrind is not on PATH; run this inside the devbox (Linux only)")
    names = options.names or programs()
    unknown = [n for n in names if n not in programs()]
    if unknown:
        sys.exit(f"no perf program named {', '.join(unknown)}")
    builds = options.builds or list(BUILDS)
    if options.record and (options.names or options.builds):
        sys.exit("--record measures every program's builds")
    orphans = [p.name for p in GOLDEN.iterdir() if p.stem not in programs()]
    if orphans:
        sys.exit(f"golden files for no program: {', '.join(sorted(orphans))}")
    rows = read_rows(options.against)
    # Promoting writes what the program prints, so it always runs it.
    reusable = {} if options.fresh or options.promote else rows
    # Valgrind as installed: under Nix its resolved path names the derivation,
    # so a rebuild that keeps the version still changes the key.
    valgrind = str(Path(shutil.which("valgrind")).resolve()).encode() + subprocess.run(
        ["valgrind", "--version"], capture_output=True, check=True).stdout
    # The longest run, stress's plain build, goes first, so that it does not
    # start last on a pool already busy with the others.
    jobs = sorted(((n, b) for n in names for b in builds),
                  key=lambda j: (j[0] != LOGGED, j[1] != "plain"))
    with tempfile.TemporaryDirectory() as work, ThreadPoolExecutor(os.cpu_count() or 1) as pool:
        measured = {(n, b): (r, e) for n, b, r, e in pool.map(
            lambda j: measure(zanec, *j, Path(work), valgrind, reusable.get(j)), jobs)}
    results = [(n, b, *measured[n, b]) for n in names for b in builds]
    broken = slower = False
    # A program is promoted only when every build of it ran and printed the
    # same output.
    promoted, held = {}, set()
    print(f"{'program':12} {'build':9}" + "".join(f" {k:>14} {'change':>8}" for k in COUNTS))
    for name, build, result, error in results:
        if error:
            print(f"{name:12} {build:9} {error}")
            held.add(name)
            broken = True
            continue
        row = rows.get((name, build))
        print(f"{name:12} {build:9}"
              + "".join(f" {result[k]:>14} {change(row, k, result[k]):>8}" for k in COUNTS))
        if result["reused"]:
            print(f"  the same build as {result['reused'][:12]}'s: its row, not run again")
        if options.promote:
            first = promoted.setdefault(name, (build, result["output"]))
            if first[1] != result["output"]:
                print(f"  printed {result['output']!r}, not the {first[0]} build's {first[1]!r}")
                held.add(name)
                broken = True
            continue
        printed, slow = problems_of(name, result, row)
        for problem in printed + slow:
            print(f"  {problem}")
        broken |= bool(printed)
        slower |= bool(slow)
    if options.against and not rows:
        print(f"{options.against} has no rows yet: nothing to compare with")
    for name, (_, output) in promoted.items():
        if name not in held:
            (GOLDEN / f"{name}.out").write_text(output)
    if options.record and not broken:
        write_log(options.record, options.commit, [(n, b, r) for n, b, r, _ in results])
    if broken or slower:
        sys.exit(1)


if __name__ == "__main__":
    main()
