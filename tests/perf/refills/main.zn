/// A bit writer, as an arithmetic coder's output: each bit doubles a pending
/// byte and counts it, and the eighth pushes the byte to a list and clears
/// the byte and its count together, which LLVM makes one `memset` of the
/// two slots in the frame. The coder's model, a table of weights and a
/// list of counts, is in the same frame; only the slots the `memset` and the push write are read
/// again after them, so the model stays in registers across the bytes.
package refills;

alias Int = @primitives$I64;
alias Float = @primitives$F64;
alias Bool = @primitives$Bool;
alias Unit = @primitives$Unit;
alias String = @primitives$String;
alias ListRef<T Type> = @primitives$ListRef<T>;

/// Advances the counter through the inclusive range, running the block once
/// per step.
Unit to(this Int, end Int, body @concepts$Block) mut {
	@controlflow$repeat(@operators$add(@operators$add(end, @operators$negate(this)), Int(1)), {
		@controlflow$branch(true, body);
		this = @operators$add(this, Int(1));
	});
	return Unit();
}

/// The size the program was started with: its first argument, or
/// `fallback` when it has none or the first spells no integer.
Int size(fallback Int) {
	args @primitives$List<String> = @program$runtime:arguments();
	@controlflow$branch(@operators$lessThan(args:size(), Int(1)), {
		return fallback;
	});
	return args[Int(1)]:parseI64() ?? fallback;
}

Unit say(text String) {
	@program$console!print(@operators$concat(text, String.escaped("\n")));
	return Unit();
}

Int plus(a Int, b Int) => @operators$add(a, b);
Int minus(a Int, b Int) => @operators$add(a, @operators$negate(b));
Int times(a Int, b Int) => @operators$multiply(a, b);
Int over(a Int, b Int) => @operators$divide(a, b);
Int modulo(a Int, b Int) => minus(a, times(over(a, b), b));
Bool below(a Int, b Int) => @operators$lessThan(a, b);
Bool same(a Int, b Int) => @operators$equal(a, b);

/// The linear congruential generator langbench uses.
type Rng = #struct {
	state Int;
}

Rng(seed Int) => init{ state = seed; }

Int next(this Rng) mut {
	this.state = @math$bitAnd(plus(times(this.state, Int(1103515245)), Int(12345)), Int(2147483647));
	return this.state;
}

/// A number below `bound`, from the generator's high bits.
/// A number below `bound`, from the generator's high bits.
Int pick(this Rng, bound Int) mut => modulo(over(this!next(), Int(65536)), bound);

Int twice(a Int) => times(a, Int(2));

type Writer = #struct {
	data @primitives$List<@primitives$U8>;
	pending Int;
	position Int;
	written Int;
}

Writer() => init{ data = @primitives$List(@primitives$U8); pending = Int(0); position = Int(0); written = Int(0); }

Unit bit(this Writer, value Int) mut {
	this.pending = plus(twice(this.pending), value);
	this.position = plus(this.position, Int(1));
	this.written = plus(this.written, Int(1));
	@controlflow$branch(same(this.position, Int(8)), {
		this.data!push(@primitives$U8.wrap(this.pending));
		this.pending = Int(0);
		this.position = Int(0);
	});
	return Unit();
}

/// Each symbol's bits, written from the high one down, as many as its
/// weight in the table says, with the table's bounds kept as the coder's
/// range.
Int encode(symbols ListRef<Int>, weights ListRef<Int>) {
	out Writer();
	table ListRef<Int> = @primitives$ListRef(Int);
	counts ListRef<Int> = @primitives$ListRef(Int);
	j Int(1);
	j!to(weights:size()) {
		table!push(weights[j]);
		counts!push(Int(0));
	}
	low Int(0);
	high Int(65535);
	i Int(1);
	i!to(symbols:size()) {
		s Int = symbols[i];
		w Int = table[plus(s, Int(1))];
		k Int(1);
		k!to(w) {
			b Int = @math$bitAnd(over(plus(s, low), plus(k, Int(1))), Int(1));
			out!bit(b);
			low = @math$bitAnd(plus(low, times(b, high)), Int(65535));
			high = plus(@math$bitAnd(minus(high, low), Int(32767)), Int(1));
			counts[plus(b, Int(1))] = plus(counts[plus(b, Int(1))], table[plus(b, Int(1))]);
		}
	}
	return plus(plus(plus(out.written, out.data:size()), low), plus(counts[Int(1)], counts[Int(2)]));
}

Unit main() {
	rounds Int = size(Int(10));
	rng Rng(Int(29));
	weights ListRef<Int> = @primitives$ListRef(Int);
	n Int(1);
	n!to(Int(16)) {
		weights!push(plus(rng!pick(Int(6)), Int(3)));
	}
	total Int(0);
	@controlflow$repeat(rounds, {
		symbols ListRef<Int> = @primitives$ListRef(Int);
		m Int(1);
		m!to(Int(3000)) {
			symbols!push(rng!pick(Int(16)));
		}
		total = plus(total, encode(symbols, weights));
	});
	say(String(total));
	return Unit();
}
