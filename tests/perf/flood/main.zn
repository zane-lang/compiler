/// Breadth-first flood fill of a grid with walls, as a maze solver's search
/// marks cells seen: a list of `Bool` flags is written while lists of
/// integers, the grid and the queue, are read. A one-byte store is tagged
/// apart from eight-byte ones, so the integers read after it are not read
/// again.
package flood;

alias Int = @primitives$I64;
alias Float = @primitives$F64;
alias Bool = @primitives$Bool;
alias Unit = @primitives$Unit;
alias String = @primitives$String;
alias ListRef<T Type> = @primitives$ListRef<T>;

/// Advances the counter through the inclusive range, running the block once
/// per step.
Unit to(this Int, end Int, body @concepts$Block) mut {
	@controlflow$repeat(@operators$add(@operators$add(end, @operators$negate(this)), Int(1)), {
		@controlflow$branch(true, body);
		this = @operators$add(this, Int(1));
	});
	return Unit();
}

/// The size the program was started with: its first argument, or
/// `fallback` when it has none or the first spells no integer.
Int size(fallback Int) {
	args @primitives$List<String> = @program$runtime:arguments();
	@controlflow$branch(@operators$lessThan(args:size(), Int(1)), {
		return fallback;
	});
	return args[Int(1)]:parseI64() ?? fallback;
}

Unit say(text String) {
	@program$console!print(@operators$concat(text, String.escaped("\n")));
	return Unit();
}

Int plus(a Int, b Int) => @operators$add(a, b);
Int minus(a Int, b Int) => @operators$add(a, @operators$negate(b));
Int times(a Int, b Int) => @operators$multiply(a, b);
Int over(a Int, b Int) => @operators$divide(a, b);
Int modulo(a Int, b Int) => minus(a, times(over(a, b), b));
Bool below(a Int, b Int) => @operators$lessThan(a, b);
Bool same(a Int, b Int) => @operators$equal(a, b);

/// The linear congruential generator langbench uses.
type Rng = #struct {
	state Int;
}

Rng(seed Int) => init{ state = seed; }

Int next(this Rng) mut {
	this.state = @math$bitAnd(plus(times(this.state, Int(1103515245)), Int(12345)), Int(2147483647));
	return this.state;
}

/// A number below `bound`, from the generator's high bits.
Int pick(this Rng, bound Int) mut => modulo(over(this!next(), Int(65536)), bound);

Int fill(walls ListRef<Int>, width Int, from Int) {
	start Int = plus(from, Int(0));
	seen ListRef<Bool> = @primitives$ListRef(Bool);
	queue ListRef<Int> = @primitives$ListRef(Int);
	c Int(1);
	c!to(walls:size()) {
		seen!push(false);
	}
	queue!push(start);
	seen[start] = true;
	head Int(1);
	reached Int(0);
	h Int(1);
	h!to(walls:size()) {
		@controlflow$branch(below(queue:size(), head), {
			return reached;
		});
		at Int = queue[head];
		head = plus(head, Int(1));
		reached = plus(reached, Int(1));
		next Int = plus(at, Int(1));
			@controlflow$branch(@operators$not(seen[next]), {
				@controlflow$branch(same(walls[next], Int(0)), {
					seen[next] = true;
					queue!push(next);
				});
			});
			next = minus(at, Int(1));
			@controlflow$branch(@operators$not(seen[next]), {
				@controlflow$branch(same(walls[next], Int(0)), {
					seen[next] = true;
					queue!push(next);
				});
			});
			next = plus(at, width);
			@controlflow$branch(@operators$not(seen[next]), {
				@controlflow$branch(same(walls[next], Int(0)), {
					seen[next] = true;
					queue!push(next);
				});
			});
			next = minus(at, width);
			@controlflow$branch(@operators$not(seen[next]), {
				@controlflow$branch(same(walls[next], Int(0)), {
					seen[next] = true;
					queue!push(next);
				});
			});
	}
	return reached;
}

Unit main() {
	rounds Int = size(Int(10));
	width Int(128);
	walls ListRef<Int> = @primitives$ListRef(Int);
	rng Rng(Int(43));
	y Int(1);
	y!to(width) {
		x Int(1);
		x!to(width) {
			wall Int(0);
			@controlflow$branch(same(x, Int(1)), { wall = Int(1); });
			@controlflow$branch(same(x, width), { wall = Int(1); });
			@controlflow$branch(same(y, Int(1)), { wall = Int(1); });
			@controlflow$branch(same(y, width), { wall = Int(1); });
			@controlflow$branch(same(rng!pick(Int(4)), Int(0)), {
				wall = Int(1);
			});
			walls!push(wall);
		}
	}
	checksum Int(0);
	round Int(1);
	round!to(rounds) {
		start Int = plus(times(plus(Int(1), modulo(round, minus(width, Int(2)))), width), Int(2));
		walls[start] = Int(0);
		checksum = plus(checksum, fill(walls, width, start));
	}
	say(String(checksum));
	return Unit();
}
