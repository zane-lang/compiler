/// A Huffman decoder over a tree of 16-byte nodes: each byte's eight bits,
/// highest first, step from a node to the child its `I32` field names
/// until a leaf, whose symbol is pushed. A child index is loaded from the
/// node before it, so the element address is on the walk's critical path;
/// with the index's one taken off the base, which the loop does not change,
/// the address is the loaded index scaled and added to it.
package nodes;

alias Int = @primitives$I64;
alias Float = @primitives$F64;
alias Bool = @primitives$Bool;
alias Unit = @primitives$Unit;
alias String = @primitives$String;
alias ListRef<T Type> = @primitives$ListRef<T>;

/// Advances the counter through the inclusive range, running the block once
/// per step.
Unit to(this Int, end Int, body @concepts$Block) mut {
	@controlflow$repeat(@operators$add(@operators$add(end, @operators$negate(this)), Int(1)), {
		@controlflow$branch(true, body);
		this = @operators$add(this, Int(1));
	});
	return Unit();
}

/// The size the program was started with: its first argument, or
/// `fallback` when it has none or the first spells no integer.
Int size(fallback Int) {
	args @primitives$List<String> = @program$runtime:arguments();
	@controlflow$branch(@operators$lessThan(args:size(), Int(1)), {
		return fallback;
	});
	return args[Int(1)]:parseI64() ?? fallback;
}

Unit say(text String) {
	@program$console!print(@operators$concat(text, String.escaped("\n")));
	return Unit();
}

Int plus(a Int, b Int) => @operators$add(a, b);
Int minus(a Int, b Int) => @operators$add(a, @operators$negate(b));
Int times(a Int, b Int) => @operators$multiply(a, b);
Int over(a Int, b Int) => @operators$divide(a, b);
Int modulo(a Int, b Int) => minus(a, times(over(a, b), b));
Bool below(a Int, b Int) => @operators$lessThan(a, b);
Bool same(a Int, b Int) => @operators$equal(a, b);

/// The linear congruential generator langbench uses.
type Rng = #struct {
	state Int;
}

Rng(seed Int) => init{ state = seed; }

Int next(this Rng) mut {
	this.state = @math$bitAnd(plus(times(this.state, Int(1103515245)), Int(12345)), Int(2147483647));
	return this.state;
}

/// A number below `bound`, from the generator's high bits.
Int pick(this Rng, bound Int) mut => modulo(over(this!next(), Int(65536)), bound);

alias I32 = @primitives$I32;
alias U8 = @primitives$U8;

type Node = struct {
	frequency I32;
	value U8;
	leaf Bool;
	padA U8;
	padB U8;
	left I32;
	right I32;
}

Node(value Int, leaf Bool, left Int, right Int) => init{
	frequency = I32.wrap(Int(1));
	value = U8.wrap(value);
	leaf = leaf;
	padA = U8.wrap(Int(0));
	padB = U8.wrap(Int(0));
	left = I32.wrap(left);
	right = I32.wrap(right);
}

Unit main() {
	bytes Int = size(Int(1000));
	nodes @primitives$List<Node> = @primitives$List(Node);
	/// Nodes 1 to 31 are inner, each with two children; 32 to 63 are leaves.
	n Int(1);
	n!to(Int(63)) {
		@controlflow$branch(below(n, Int(32)), {
			nodes!push(Node(Int(0), false, times(n, Int(2)), plus(times(n, Int(2)), Int(1))));
		});
		@controlflow$branch(below(Int(31), n), {
			nodes!push(Node(minus(n, Int(31)), true, Int(0), Int(0)));
		});
	}
	out @primitives$List<U8> = @primitives$List(U8);
	rng Rng(Int(5));
	current Int(1);
	b Int(1);
	b!to(bytes) {
		value Int = rng!pick(Int(256));
		j Int(1);
		j!to(Int(8)) {
			bit Int = @math$bitAnd(@math$shiftRight(value, minus(Int(8), j)), Int(1));
			@controlflow$branch(same(bit, Int(0)), {
				current = @primitives$I64(nodes[current].left);
			});
			@controlflow$branch(same(bit, Int(1)), {
				current = @primitives$I64(nodes[current].right);
			});
			reached Node = nodes[current];
			@controlflow$branch(reached.leaf, {
				out!push(reached.value);
				current = Int(1);
			});
		}
	}
	checksum Int(0);
	k Int(1);
	k!to(out:size()) {
		checksum = modulo(plus(times(checksum, Int(31)), @primitives$I64(out[k])), Int(1000000007));
	}
	say(@operators$concat(@operators$concat(String(checksum), String(" ")), String(out:size())));
	return Unit();
}
