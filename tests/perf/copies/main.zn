/// A tree of values copied whole, as langbench's treecopy: a perfect tree
/// of value variants built once, then copied and summed twenty times. Each
/// copy allocates every node afresh, so the two share nothing.
package copies;

alias Int = @primitives$I64;
alias Float = @primitives$F64;
alias Bool = @primitives$Bool;
alias Unit = @primitives$Unit;
alias String = @primitives$String;
alias ListRef<T Type> = @primitives$ListRef<T>;

/// Advances the counter through the inclusive range, running the block once
/// per step.
Unit to(this Int, end Int, body @concepts$Block) mut {
	@controlflow$repeat(@operators$add(@operators$add(end, @operators$negate(this)), Int(1)), {
		@controlflow$branch(true, body);
		this = @operators$add(this, Int(1));
	});
	return Unit();
}

/// The size the program was started with: its first argument, or
/// `fallback` when it has none or the first spells no integer.
Int size(fallback Int) {
	args @primitives$List<String> = @program$runtime:arguments();
	@controlflow$branch(@operators$lessThan(args:size(), Int(1)), {
		return fallback;
	});
	return args[Int(1)]:parseI64() ?? fallback;
}

Unit say(text String) {
	@program$console!print(@operators$concat(text, String.escaped("\n")));
	return Unit();
}


type Tree = variant {
	leaf Int;
	node Branch;
}

type Branch = struct {
	value Int;
	left Tree;
	right Tree;
}

Branch(value Int, left Tree, right Tree) => init{ value; left; right; }

Tree make(depth Int, value Int) {
	@controlflow$branch(@operators$equal(depth, Int(0)), {
		return Tree.leaf(value);
	});
	below Int = @operators$add(depth, @operators$negate(Int(1)));
	twice Int = @operators$multiply(value, Int(2));
	return Tree.node(Branch(value, make(below, twice), make(below, @operators$add(twice, Int(1)))));
}

Int sum(tree Tree) => match (tree) {
	v leaf => v;
	b node => @operators$add(b.value, @operators$add(sum(b.left), sum(b.right)));
}

Unit main() {
	depth Int = size(Int(6));
	original Tree = make(depth, Int(1));
	total Int(0);
	round Int(1);
	round!to(Int(20)) {
		copy Tree = original;
		total = @operators$add(total, sum(copy));
	}
	say(@operators$concat(@operators$concat(String(total), String(" ")), String(sum(original))));
	return Unit();
}
