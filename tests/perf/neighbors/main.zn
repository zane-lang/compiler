/// A maze carver's neighbour count: a small helper, four checked reads of a
/// grid, called on every pass of a loop and from more than one place, so
/// LLVM's inliner, which costs it as it stands, leaves it a call. A call in
/// a loop to a small leaf of the program is inlined there.
package neighbors;

alias Int = @primitives$I64;
alias Float = @primitives$F64;
alias Bool = @primitives$Bool;
alias Unit = @primitives$Unit;
alias String = @primitives$String;
alias ListRef<T Type> = @primitives$ListRef<T>;

/// Advances the counter through the inclusive range, running the block once
/// per step.
Unit to(this Int, end Int, body @concepts$Block) mut {
	@controlflow$repeat(@operators$add(@operators$add(end, @operators$negate(this)), Int(1)), {
		@controlflow$branch(true, body);
		this = @operators$add(this, Int(1));
	});
	return Unit();
}

/// The size the program was started with: its first argument, or
/// `fallback` when it has none or the first spells no integer.
Int size(fallback Int) {
	args @primitives$List<String> = @program$runtime:arguments();
	@controlflow$branch(@operators$lessThan(args:size(), Int(1)), {
		return fallback;
	});
	return args[Int(1)]:parseI64() ?? fallback;
}

Unit say(text String) {
	@program$console!print(@operators$concat(text, String.escaped("\n")));
	return Unit();
}

Int plus(a Int, b Int) => @operators$add(a, b);
Int minus(a Int, b Int) => @operators$add(a, @operators$negate(b));
Int times(a Int, b Int) => @operators$multiply(a, b);
Int over(a Int, b Int) => @operators$divide(a, b);
Int modulo(a Int, b Int) => minus(a, times(over(a, b), b));
Bool below(a Int, b Int) => @operators$lessThan(a, b);
Bool same(a Int, b Int) => @operators$equal(a, b);

/// The linear congruential generator langbench uses.
type Rng = #struct {
	state Int;
}

Rng(seed Int) => init{ state = seed; }

Int next(this Rng) mut {
	this.state = @math$bitAnd(plus(times(this.state, Int(1103515245)), Int(12345)), Int(2147483647));
	return this.state;
}

/// A number below `bound`, from the generator's high bits.
Int pick(this Rng, bound Int) mut => modulo(over(this!next(), Int(65536)), bound);

type Maze = #struct {
	grid ListRef<Int>;
	width Int;
}

Maze(width Int) => init{
	grid = @primitives$ListRef(Int);
	width;
}

/// How many of the eight cells around `at` are open.
Int open(this Maze, at Int) {
	w Int = this.width;
	side Int = plus(plus(this.grid[minus(at, Int(1))], this.grid[plus(at, Int(1))]), plus(this.grid[minus(at, w)], this.grid[plus(at, w)]));
	corner Int = plus(plus(this.grid[minus(minus(at, w), Int(1))], this.grid[plus(minus(at, w), Int(1))]), plus(this.grid[minus(plus(at, w), Int(1))], this.grid[plus(plus(at, w), Int(1))]));
	return plus(side, corner);
}

Int carve(this Maze, steps Int, seed Int) mut {
	rng Rng(seed);
	carved Int(0);
	span Int = minus(times(this.width, minus(this.width, Int(2))), Int(2));
	@controlflow$repeat(steps, {
		at Int = plus(plus(rng!pick(span), this.width), Int(2));
		@controlflow$branch(below(this:open(at), Int(3)), {
			this.grid[at] = Int(1);
			carved = plus(carved, Int(1));
		});
	});
	return carved;
}

Unit main() {
	steps Int = size(Int(10));
	maze Maze(Int(64));
	i Int(1);
	i!to(times(maze.width, maze.width)) {
		maze.grid!push(Int(0));
	}
	carved Int = plus(plus(maze!carve(steps, Int(23)), maze!carve(steps, Int(29))), maze!carve(steps, Int(31)));
	say(@operators$concat(@operators$concat(String(carved), String(" ")), String(maze:open(plus(maze.width, Int(2))))));
	return Unit();
}
