package bad;

/// `import lib` qualifies the package, so its method for every type is
/// written `lib$settle` (functions.md §6.1).
import lib;

/// A subject that introduces a parameter names it bare (generics.md §3.7).
Unit nested(this List<T Type> Type) => Unit();

type Steps = struct { n Int; }
Steps() => init{ n = Int(0); }

Unit workers(fixed Steps) {
	s Steps = Steps();
	s!settle();
	s!lib$settle();
	// A step's result converts to `@primitives$Bool`; an `Int` does not.
	s!@controlflow$work(Int(this Steps) mut => this.n);
	// A worker writes its subject, so a read-only parameter is no subject.
	fixed!@controlflow$work(Bool(this Steps) mut => false);
	// The conversion is the checker's to supply.
	s!@controlflow$work(Bool(this Steps) mut => false, Bool(b Bool) => b);
	// A worker intrinsic is a `mut` method, called with `!`.
	s:@controlflow$work(Bool(this Steps) mut => false);
	// It is a method of its subject, so the function form names nothing.
	@controlflow$work(s, Bool(this Steps) mut => false);
	// `register` waits on an event source, not on a bare interval.
	s!@controlflow$register(Int(1000), Bool(this Steps) mut => false);
	return Unit();
}
