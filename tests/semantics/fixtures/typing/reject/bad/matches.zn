package bad;

type Answer = variant { yes Int; no Bool; maybe Float; }
type Light = enum [ red, green ];

Int answer(value Answer) => match (value) {
	x yes => x;
	yes => Int(1);
	unsure => Int(2);
}

Int light(value Light) => match (value) {
	x red => Int(1);
	green => true;
}

Int plain(value Int) => match (value) {
	red => Int(1);
}

/// Each arm covers one combination, so what is missing is counted, not
/// listed: the first three missing combinations are named, in order, and the
/// rest counted.
Int three(v0 Light, v1 Light, v2 Light) => match (v0, v1, v2) {
	red, red, red => Int(1);
}

/// Thirty scrutinees have 2^30 combinations, which are never written out.
Int thirty(v0 Light, v1 Light, v2 Light, v3 Light, v4 Light, v5 Light, v6 Light, v7 Light, v8 Light, v9 Light, v10 Light, v11 Light, v12 Light, v13 Light, v14 Light, v15 Light, v16 Light, v17 Light, v18 Light, v19 Light, v20 Light, v21 Light, v22 Light, v23 Light, v24 Light, v25 Light, v26 Light, v27 Light, v28 Light, v29 Light) => match (v0, v1, v2, v3, v4, v5, v6, v7, v8, v9, v10, v11, v12, v13, v14, v15, v16, v17, v18, v19, v20, v21, v22, v23, v24, v25, v26, v27, v28, v29) {
	red, red, red, red, red, red, red, red, red, red, red, red, red, red, red, red, red, red, red, red, red, red, red, red, red, red, red, red, red, red => Int(1);
}

/// Sixty-four have more combinations than a count can hold.
Int sixtyFour(v0 Light, v1 Light, v2 Light, v3 Light, v4 Light, v5 Light, v6 Light, v7 Light, v8 Light, v9 Light, v10 Light, v11 Light, v12 Light, v13 Light, v14 Light, v15 Light, v16 Light, v17 Light, v18 Light, v19 Light, v20 Light, v21 Light, v22 Light, v23 Light, v24 Light, v25 Light, v26 Light, v27 Light, v28 Light, v29 Light, v30 Light, v31 Light, v32 Light, v33 Light, v34 Light, v35 Light, v36 Light, v37 Light, v38 Light, v39 Light, v40 Light, v41 Light, v42 Light, v43 Light, v44 Light, v45 Light, v46 Light, v47 Light, v48 Light, v49 Light, v50 Light, v51 Light, v52 Light, v53 Light, v54 Light, v55 Light, v56 Light, v57 Light, v58 Light, v59 Light, v60 Light, v61 Light, v62 Light, v63 Light) => match (v0, v1, v2, v3, v4, v5, v6, v7, v8, v9, v10, v11, v12, v13, v14, v15, v16, v17, v18, v19, v20, v21, v22, v23, v24, v25, v26, v27, v28, v29, v30, v31, v32, v33, v34, v35, v36, v37, v38, v39, v40, v41, v42, v43, v44, v45, v46, v47, v48, v49, v50, v51, v52, v53, v54, v55, v56, v57, v58, v59, v60, v61, v62, v63) {
	red, red, red, red, red, red, red, red, red, red, red, red, red, red, red, red, red, red, red, red, red, red, red, red, red, red, red, red, red, red, red, red, red, red, red, red, red, red, red, red, red, red, red, red, red, red, red, red, red, red, red, red, red, red, red, red, red, red, red, red, red, red, red, red => Int(1);
}
