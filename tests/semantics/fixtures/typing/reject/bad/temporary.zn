package bad;

type Note = #struct { pitch @primitives$Int; }

Note(pitch @primitives$Int) => init{ pitch; }

@primitives$Unit hear(note &Note) => @primitives$Unit()

/// A reference names a place: a value built in the argument is a temporary,
/// so it is stored first (memory.md §2.8).
@primitives$Unit greet() {
	hear(Note(@primitives$Int(1)));
	return @primitives$Unit();
}
