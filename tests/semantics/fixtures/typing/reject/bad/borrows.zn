package bad;

/// Nothing else in a call writes what the call borrows (memory.md §2.9.1):
/// not its `mut` subject, not a block argument, not a later argument. A
/// match arm with a binder writes its scrutinee only through the binder
/// (adt.md §5.1).
type Cargo = #struct { weight Int; }
type Lot = #variant { held Cargo; none Int; }
type Tally = struct { count Int; }

Cargo(weight Int) => init{ weight; }
Tally(count Int) => init{ count; }

Unit setFrom(this Tally, other Tally) mut {
	this.count = other.count;
	return Unit();
}

Unit stack(this List<Cargo>, cargo Cargo) mut => Unit()
Unit empty(this Lot) mut => Unit()
Int lift(this Cargo) mut => this.weight
Int weigh(cargo Cargo, body @concepts$Block) => cargo.weight
Int compare(cargo Cargo, other Int) => cargo.weight
Int grown(this List<Cargo>) mut => Int(1)

Unit borrows() {
	own List<Cargo> = @primitives$List(Cargo);
	t Tally(Int(1));
	t!setFrom(t);
	own!stack(own[Int(1)]);
	weigh(own[Int(1)], {
		own = @primitives$List(Cargo);
	});
	compare(own[Int(1)], own!grown());
	mine Lot = Lot.none(Int(0));
	n Int = match (mine) {
		c held {
			c!lift();
			mine = Lot.none(Int(1));
			return Int(1);
		}
		u none {
			mine!empty();
			return u;
		}
	}
	dirty Bool = true;
	if(dirty) {
		dirty = false;
	}
	tallies List<Tally> = @primitives$List(Tally);
	front Tally = tallies[Int(1)];
	tallies!push(front);
	was Bool = dirty;
	if(was) {
		dirty = false;
	}
	return Unit();
}
