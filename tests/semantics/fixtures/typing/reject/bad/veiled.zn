/// A veiled value (generics.md §3.8): a value whose type is a type
/// parameter is reached only through methods, functions, operators,
/// subscripts and constructors. Every other use is reported where the
/// generic body writes it, whether or not anything instantiates the body.
package bad;

type Vane = struct { level Int; }
type Tint = enum [ dusk, dawn ];

Tint.label Int {
    dusk = Int(1);
    dawn = Int(2);
}

Vane(level Int) => init{ level; }
Int read(this Vane) => this.level;

// Legal: hold it, call a method, a function, an operator and a
// constructor on it, and pass it on.
Int dialed(x T Type) => x:read();
T rebuilt(x T Type) {
    fresh T = T(Int(1));
    named T = T.from(Int(2));
    return x;
}

// Reported though nothing instantiates them.
Int peeked(x T Type) => x.level;
Unit poked(x T Type) {
    copy T = x;
    copy.level = Int(1);
    return Unit();
}
Int labelled(x T Type) => x.label;
T picked(x T Type) => T.dusk;
Int matched(x T Type) => match (x) {
    dusk => Int(1);
    dawn => Int(2);
}
Int called(x T Type) => x(Int(1));

// Reported though every instance would have the field.
Int instantiated(x T Type) => x.level;

// `T.name(...)` is always a named-constructor call. A type that declares
// none of that name makes the instance ill-formed, which is reported at
// the type's origin, with the path from there to the call.
T freshened(x T Type) => T.fresh();
T relayed(x T Type) => freshened(x);

Unit veiledCalls() {
    n Int = instantiated(Vane(Int(3)));
    r Vane = relayed(Vane(Int(4)));
    return Unit();
}

// A generic type's own structure is not veiled, but the field of type `T`
// it yields is.
type Keeper<T Type> = struct { held T; }
Int heldLevel(this Keeper<T Type>) => this.held.level;
