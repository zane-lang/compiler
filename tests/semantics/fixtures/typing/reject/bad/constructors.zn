package bad;

// Constructors on an enum and a variant (types.md §3.1, §3.3, §3.4, §3.7).
type Hue = enum [ amber, teal ];
type Ledger = variant { none Unit; some Int; }

// A named constructor's identifier differs from every member and case of its type.
Hue.amber() => Hue.teal;
Ledger.some(n Int) => Ledger.some(n);

// An enum or variant has no fields, so it has no field constructor.
Hue{level Int;} => Hue.amber;
Ledger{count Int;} => Ledger.some(count);

// `init{ }` assigns a struct's fields, which an enum or variant has none of.
// The values it is given are still checked.
Hue.blank() => init{}
Ledger.blank() => init{}
Hue.tinted() => init{ level = unlit; }

// A type name that fixes every type argument builds that type, so the
// checker reports a generic constructor that would infer another from the call.
type Pouch<T Type> = struct { held T; }
Pouch<T>(x T Type) => init{ held = x; }
alias IntPouch = Pouch<Int>;
type Draw<T Type> = variant { one T; none Unit; }
Draw<T>(x T Type) => Draw.one(x);
alias IntDraw = Draw<Int>;

Unit pouches() {
    fits IntPouch(Int(1));
    misbuilt Pouch<String> = IntPouch(String("x"));
    drawn Draw<String> = IntDraw(String("y"));
    return Unit();
}

// A variant without an anonymous constructor is still built by a case.
type Mark = variant { on Unit; off Unit; }

Unit marks() {
    m Mark();
    return Unit();
}
