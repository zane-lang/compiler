package bad;

/// An exit ends the run of the block its call is written in, so a call to an
/// exiting verb is written in a block that yields nothing.
Unit early(ready Bool) {
	guard(ready);
	if(ready) {
		guard(ready);
	}
	check Unit(flag Bool) {
		guard(flag);
		return Unit();
	}
	return Unit();
}

/// A block yields nothing: it takes no type argument, and a `resolve` in it
/// finishes the handler around it, when there is one.
Bool lazily(condition @concepts$Block<Bool>) => true

Unit yielding(ready Bool) {
	done Bool = if(ready) {
		resolve ready;
	}
	return Unit();
}

/// A lambda's body holds no exit of its own, not even in a block written
/// there (control-flow.md §4.2). A lambda that calls an exiting verb ends
/// itself, which is fine.
Unit lambdaExits() {
	leaves Unit() {
		@controlflow$exitFromCall();
		return Unit();
	}
	blocked Unit(flag Bool) {
		if(flag) {
			@controlflow$exitFromCall();
		}
		return Unit();
	}
	stops Unit(flag Bool) {
		if(flag) {
			guard(flag);
		}
		return Unit();
	}
	return Unit();
}

/// An enum map's entries, too.
type Step = enum [ only ]

Step.run Unit[] {
	only = Unit() {
		@controlflow$exitFromCall();
		return Unit();
	};
}

/// A lambda-variable at package scope, too.
bails Unit() {
	@controlflow$exitFromCall();
	return Unit();
}
