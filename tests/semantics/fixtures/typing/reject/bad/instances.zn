/// A generic body is checked per instantiation, so the error is reported for
/// the arguments that exposed it.
package bad;

T half(value T Type) => @operators$divide(value, value)

Unit instances() {
	fine Int = half(Int(4));
	text String = half(String("x"));
	return Unit();
}

/// Each instance asks for one at a larger argument, so its chain of
/// instantiations never ends. The limit is on that chain's depth, through
/// however many declarations it passes.
Unit ping(value T Type) {
	pong(Jar(value));
	return Unit();
}

Unit pong(value T Type) {
	ping(value);
	return Unit();
}

/// Two such calls per instance: the chain is followed to its end before the
/// instances beside it, so the error comes after one chain, not after every
/// instance the branches would ask for.
type Sack<T Type> = struct { item T; }

Sack<T>(item T Type) => init{ item; }

Unit fork(value T Type) {
	fork(Jar(value));
	fork(Sack(value));
	return Unit();
}

Unit chains() {
	ping(Int(1));
	fork(Int(1));
	return Unit();
}
