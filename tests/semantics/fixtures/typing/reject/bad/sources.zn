package bad;

type Bell = #struct { tone Int; }
type Rack = #struct { bell Bell; hook &Bell; }
type Slot = #variant { full Bell; empty Int; }

Bell(tone Int) => init{ tone; }

&Bell ring(bell &Bell) => bell
^Bell forge() => Bell(Int(1))
Int weight(bell &Bell) => bell.tone

/// A new reference comes from a settled place: a settled symbol, or a path
/// from one, or from a reference, through struct fields (memory.md §2.8).
/// A list's element, a payload and a temporary are not one; a value that is
/// already a reference is copied, from wherever it is.
Unit mint(rack &Rack, bells &ListRef<Bell>, hooks &@primitives$ArrayRef<&Bell, 2>, slot &Slot) {
	a &Bell = rack.bell;
	b &Bell = bells[Int(1)];
	c &Bell = hooks[Int(1)];
	d &Bell = slot.full ?? rack.bell;
	e &Bell = forge();
	f &Bell = ring(bells[Int(1)]);
	g &Bell = ring(rack.bell);
	h Int = match (slot) {
		x full => ring(x).tone;
		empty => Int(0);
	}
	tones ListRef<Int> = @primitives$ListRef(Int);
	tones[weight(bells[Int(1)])] = Int(1);
	return Unit();
}

/// A roaming owner may still move, so nothing references it or anything in
/// it; an `ArrayRef`'s elements are fixed storage, which take their root's
/// state (memory.md §2.8.1, generics.md §8.4).
Unit fixed() {
	spare ^Bell = Bell(Int(5));
	s &Bell = spare;
	row @primitives$ArrayRef<Bell, 2> = @primitives$ArrayRef.roaming([Bell(Int(1)), Bell(Int(2))]);
	r &Bell = row[Int(1)];
	loose ^@primitives$ArrayRef<Bell, 2> = @primitives$ArrayRef.roaming([Bell(Int(3)), Bell(Int(4))]);
	l &Bell = loose[Int(1)];
	return Unit();
}

/// A declared subscript is a reference source exactly when the projection
/// its body ends at is one (functions.md §2.9).
type Belfry = #struct { _row @primitives$ArrayRef<Bell, 2>; }
type Cupboard = #struct { _items ListRef<Bell>; }

(this Belfry)[index Int] => this._row[index]
(this Cupboard)[index Int] => this._items[index]

Unit project(belfry &Belfry, cupboard &Cupboard) {
	a &Bell = belfry[Int(1)];
	b &Bell = cupboard[Int(1)];
	return Unit();
}

/// A borrow is the caller's only for the call: it is never bound into `&`
/// storage and never returned as `&T` (memory.md §2.9). Neither is the
/// subject, which is a borrow too.
Unit hang(this Rack, bell Bell, spare &Bell) mut {
	this.hook = bell;
	this.hook = spare;
	held &Bell = bell;
	later &Bell = spare;
	repeat({
		this.hook = later;
		later = this.bell;
	});
	return Unit();
}

&Bell lend(bell Bell) => bell
&Bell own(this Rack) => this.bell

/// A store never goes through a reference, unless the reference is a
/// parameter the path starts at (lifetimes.md §1.1).
Unit retone(this Rack, other &Rack) mut {
	this.bell = Bell(Int(2));
	this.hook.tone = Int(3);
	own &Rack = other;
	own.bell = Bell(Int(4));
	return Unit();
}

Unit retains(value T Type) {
	return Unit();
}

/// An `ArrayRef`'s literal elements arrive in the mode its constructor
/// writes (generics.md §8.4). `ArrayRef` borrows them, so it stores no owner;
/// `ArrayRef.refs` mints a reference from each settled owner, as an `&Bell`
/// parameter would, and copies one already a reference, and `&` marks only a
/// reference type; `ArrayRef.roaming` takes an owner, which a reference does
/// not have. A literal of owners and references both is taken only as `&`
/// elements, and no type parameter is inferred from it.
Unit typed() {
	bell Bell(Int(6));
	spare ^Bell = Bell(Int(7));
	rung &Bell = bell;
	temps @primitives$ArrayRef<Bell, 1> = @primitives$ArrayRef([Bell(Int(8))]);
	undecided @primitives$ArrayRef<&Bell, 2> = @primitives$ArrayRef([bell, rung]);
	owning @primitives$ArrayRef<Bell, 2> = @primitives$ArrayRef.roaming([bell, rung]);
	roaming @primitives$ArrayRef<&Bell, 2> = @primitives$ArrayRef.refs([spare, rung]);
	retains([bell, rung]);
	held @primitives$ArrayRef<&Bell, 1> = @primitives$ArrayRef.refs([bell]);
	made @primitives$ArrayRef<&Bell, 1> = @primitives$ArrayRef.refs([Bell(Int(8))]);
	moving @primitives$ArrayRef<&Bell, 1> = @primitives$ArrayRef.refs([spare]);
	taken @primitives$ArrayRef<&Bell, 1> = @primitives$ArrayRef.roaming([rung]);
	settledIn @primitives$ArrayRef<Bell, 1> = @primitives$ArrayRef.roaming([bell]);
	count Int(1);
	counts @primitives$ArrayRef.refs([count]);
	copied @primitives$ArrayRef<Int, 1> = @primitives$ArrayRef([count]);
	return Unit();
}

/// A constructor's own `@concepts$Array` parameter may write the mode of its
/// elements as `^T Type` or `&T Type`, and the elements are checked as at
/// `ArrayRef.roaming` and `ArrayRef.refs`. That is the one place a marked
/// introduction stands inside type arguments.
type Peal<T Type, n @concepts$Int> = #struct { bells @primitives$ArrayRef<T, n>; }
Peal<T, n>(xs @concepts$Array<^T Type, n @concepts$Int>) => init{ bells = @primitives$ArrayRef.roaming(xs); }

type Chime<T Type, n @concepts$Int> = #struct { bells @primitives$ArrayRef<&T, n>; }
Chime<T, n>(xs @concepts$Array<&T Type, n @concepts$Int>) => init{ bells = @primitives$ArrayRef.refs(xs); }

Unit carried(row @primitives$ArrayRef<^T Type, 1>) {
	return Unit();
}

Unit wrapped(row @primitives$ArrayRef<@concepts$Array<&T Type, n @concepts$Int>, 1>) {
	return Unit();
}

Unit moded() {
	bell Bell(Int(6));
	rung &Bell = bell;
	settled Peal([bell]);
	pointing Peal([rung]);
	fresh Chime([Bell(Int(9))]);
	return Unit();
}
