package bad;

/// Worker pools (concurrency.md §6): one rejection per rule.
alias Pool<T Type, S Type, E Type> = @primitives$WorkerPool<T, S, E>;

type PoolBox = #struct { n Int; }
PoolBox() => init{ n = Int(0); }

/// An `&`, which names an object the program builds and can write or a
/// package constant.
type Pointing = #struct { poolBox &PoolBox; }
Pointing(poolBox &PoolBox) => init{ poolBox; }

standing PoolBox = PoolBox();

/// A verb whose parameter reaches a pool's element.
Unit pointAt(this Pool<Pointing, Unit, Unit>, poolBox &PoolBox) mut {
	this!start(Pointing(poolBox), Bool(this Pointing) mut => false);
	return Unit();
}

/// The same, after a type that picks the instance and has no parameter
/// local.
Unit pointAs(this Pool<Pointing, Unit, Unit>, T Type, pointing ^Pointing) mut {
	this!start(pointing, Bool(this Pointing) mut => false);
	return Unit();
}

/// An `&` to the console, a capability, beside an owned crate: allowed.
type Speaking = #struct {
	out &@runtime$Console;
	poolBox PoolBox;
}

Unit pools() {
	// The state and the events are values (§6.1).
	owned Pool<Int, PoolBox, Int> = @primitives$WorkerPool(Int, PoolBox(), Unit(this PoolBox, event Int) mut => Unit());
	sent Pool<Int, Int, PoolBox> = @primitives$WorkerPool(Int, Int(0), Unit(this Int, event PoolBox) mut => Unit());
	// An element's `&` names a package constant or a capability (§6.4).
	pointing Pool<Pointing, Unit, Unit> = @primitives$WorkerPool(Pointing);
	local PoolBox = PoolBox();
	pointing!start(Pointing(standing), Bool(this Pointing) mut => false);
	pointing!start(Pointing(local), Bool(this Pointing) mut => false);
	pointing!pointAt(standing);
	pointing!pointAt(local);
	pointing!pointAs(Int, Pointing(local));
	// A `mut` function value may store its argument in its subject.
	aim Unit[this Pointing, &PoolBox] mut = Unit(this Pointing, poolBox &PoolBox) mut {
		this.poolBox = poolBox;
		return Unit();
	}
	aimed ^Pointing = Pointing(standing);
	aimed!aim(local);
	pointing!start(aimed, Bool(this Pointing) mut => false);
	pointing!start(Pointing(standing), Bool(this Pointing) mut {
		inner Pool<Pointing, Unit, Unit> = @primitives$WorkerPool(Pointing);
		inner!start(Pointing(this.poolBox), Bool(this Pointing) mut => false);
		return false;
	});
	ones Pool<Int, Unit, Unit> = @primitives$WorkerPool(Int);
	ones!start(Int(1), Bool(this Int) mut {
		inner Pool<Pointing, Unit, Unit> = @primitives$WorkerPool(Pointing);
		near PoolBox = PoolBox();
		inner!start(Pointing(near), Bool(this Pointing) mut => false);
		return false;
	});
	speaking Pool<Speaking, Unit, Unit> = @primitives$WorkerPool(Speaking);
	// `elements` copies, so it reads value-typed elements only (§6.6).
	speaking:elements();
	// A step's result converts to `@primitives$Bool`; an `Int` does not.
	counts Pool<Int, Unit, Unit> = @primitives$WorkerPool(Int);
	counts!start(Int(1), Int(this Int) mut => this);
	// The publish function the checker supplies is not named.
	@primitives$publish(Int(1));
	return Unit();
}
