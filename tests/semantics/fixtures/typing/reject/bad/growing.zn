package bad;

/// A type that holds itself at a larger argument has a distinct instance at
/// every depth (generics.md §2.4).
type Grow<T Type> = variant { done Unit; more Grow<Array<T, 2>>; }

/// The argument may grow on any step of a cycle through other types.
type Outer<T Type> = struct { inner Inner<T>; }
type Inner<U Type> = variant { done Unit; more Outer<ListRef<U>>; }

/// An `&` member is followed too.
type Node<T Type> = #variant { last Unit; next &Node<Array<T, 2>>; }

/// A parameter passed back inside a larger argument breaks the rule even
/// where the instances it makes are finite.
type Spread<T Type, U Type> = variant { done Unit; more Spread<Array<U, 2>, U>; }
