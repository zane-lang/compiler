package bad;

type Twice = struct { a Int; }
type Twice = struct { b Int; }

/// A generic type declared again without parameters: its uses keep the first
/// declaration's parameters.
type Pair<T Type> = struct { left T; right T; }
type Pair = struct { only Int; }

Int left(pair Pair<Int>) => pair.left

limit Int(3)
limit Int(4)

Int limited(value Int) => value
limited Int(5)

Unit names() {
	x Int = unknown;
	y Nowhere = Int(1);
	f Int = twin;
	z Int = nope$value;
	return Unit();
}
