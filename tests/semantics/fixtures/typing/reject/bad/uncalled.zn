package bad;

/// Nothing calls these, so each is checked once where it is declared, with
/// its type parameter unknown. An error that depends on `T` waits for an instance;
/// an error independent of `T` holds in every instance, and is reported here.
T neverCalled(value T Type) {
	total Int = @operators$add(Int(1), String("a"));
	missing Int = nowhere;
	return value + value;
}

Int neverSized(values Array<T Type, n @concepts$Int>) => @operators$add(Int(n), 2.5);

type Shelf<T Type> = #struct { items ListRef<T>; }

/// A generic subscript nothing indexes is checked the same way.
(this Shelf<T Type>)[index Int] => this.shelves[index];
