/// Types that lead back to themselves at their own parameters, shuffled or
/// as written, or at arguments that name none of them, have finitely many
/// instances, and are accepted (generics.md §2.4).
package app;

alias Int = @primitives$I64;
alias Unit = @primitives$Unit;
alias Array<T Type, n @concepts$Int> = @primitives$Array<T, n>;
alias ListRef<T Type> = @primitives$ListRef<T>;

type Tree<T Type> = variant { leaf T; fork Pair<Tree<T>>; }
type Pair<T Type> = struct { left T; right T; }

type Chain<T Type> = variant { last T; more Chain<T>; }
type Swap<A Type, B Type> = variant { first A; second B; more Swap<B, A>; }
type Mixed<T Type> = variant { last T; more Mixed<Int>; }

/// Mutual recursion at the same arguments.
type Ping<T Type> = variant { stop T; on Pong<T>; }
type Pong<T Type> = variant { stop T; on Ping<T>; }

/// A larger argument that does not lead back.
type Holder<T Type> = struct { items Array<T, 2>; chain Chain<Array<T, 3>>; }

/// A larger argument on a path that ends before it leads back.
type Start<T Type> = variant { stop Unit; on Finish<Array<T, 2>>; }
type Finish<U Type> = variant { stop Unit; on Start<Int>; }

Unit main() => Unit();
