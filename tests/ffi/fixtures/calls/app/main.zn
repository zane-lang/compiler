/// Foreign verbs called (ffi.md §3): each type crossing into C and back,
/// C's own state kept between calls, and C in two packages defining the
/// same names, each package calling its own, among them a function each
/// package's interface header defines itself. C functions named `result`
/// and `args` are called as any other. A recursive function reading C's
/// state is never remembered (memoization.md), so it sees each change.
package app;

alias Unit = @primitives$Unit;
alias Bool = @primitives$Bool;
alias I32 = @primitives$I32;
alias I64 = @primitives$I64;
alias F32 = @primitives$F32;
alias F64 = @primitives$F64;
alias String = @primitives$String;

import lib;

type Vec3 = struct {
	x F64;
	y F64;
	z F64;
}

Vec3(x F64, y F64, z F64) => init{ x; y; z; }

type Pair = struct {
	id I32;
	weights @primitives$Array<F32, 3>;
	at Vec3;
}

Pair(id I32, weights @primitives$Array<F32, 3>, at Vec3) => init{ id; weights; at; }

type Tagged = struct {
	tag I32;
	n I64;
}

Tagged(tag I32, n I64) => init{ tag; n; }

type Nested = struct {
	first I32;
	inner Tagged;
	last F32;
}

Nested(first I32, inner Tagged, last F32) => init{ first; inner; last; }

/// An array of none between two fields, which Zane lays out last and C in
/// its place. C makes one, and it crosses back into C.
type Gap = struct {
	a I32;
	none @primitives$Array<I64, 0>;
	b I64;
}

/// A struct Zane lays out in declaration order whose array of none still
/// differs from C's, inside one Zane reorders.
type Tail = struct {
	n I64;
	none @primitives$Array<I64, 0>;
}

type Wrapped = struct {
	tag I32;
	tail Tail;
}

I64 twice(x I64) foreign "twice";
I32 narrow(byte I32, half I32) foreign "narrow";
F32 halve(x F32) foreign "halve";
Bool odd(n I32) foreign "odd";
I32 fromBool(b Bool) foreign "from_bool";
F64 sum(xs @primitives$Array<F64, 4>, ys @primitives$List<I64>) foreign "sum";
Bool same(a @primitives$Array<F64, 4>, b @primitives$Array<F64, 4>) foreign "same";
String greet(who String) foreign "greet";
I64 length(text String) foreign "length";
Vec3 add(a Vec3, b Vec3) foreign "vec_add";
Pair mirror(p Pair) foreign "pair_mirror";
Tagged flip(t Tagged) foreign "flip";
Nested nest(n Nested) foreign "nest";
Gap gap(a I32, b I64) foreign "make_gap";
Gap widen(g Gap) foreign "widen";
Wrapped wrapped(tag I32, n I64) foreign "make_wrapped";
Wrapped bump(w Wrapped) foreign "bump";
Unit addTo(n I64) foreign "add_to";
Unit reset() foreign "reset";
I64 counter() foreign "counter";

Bool if(condition Bool, body @concepts$Block) {
	@controlflow$branch(condition, body);
	return condition;
}

I64 counted(n I64) {
	if(@operators$lessThan(n, I64(2))) {
		return counter();
	}
	return @operators$add(counted(@operators$add(n, @operators$negate(I64(1)))), counted(@operators$add(n, @operators$negate(I64(2)))));
}

I64 helper() foreign "helper";
I64 named() foreign "named";
I64 definedHere(x I64) foreign "defined_here";
I64 result() foreign "result";
I64 args(n I64) foreign "args";

Unit show(text String) {
	@program$console!print(text);
	@program$console!print(String.escaped("\n"));
	return Unit();
}

Unit main() {
	show(String(twice(I64(21))));
	show(String(narrow(I32(200), I32(5))));
	show(String(halve(F32(5.0))));
	show(String(fromBool(odd(I32(7)))));
	show(String(fromBool(odd(I32(8)))));
	xs @primitives$Array<F64, 4> = @primitives$Array([F64(1.0), F64(2.0), F64(3.0), F64(4.0)]);
	ys @primitives$List<I64> = @primitives$List(I64);
	ys!push(I64(10));
	ys!push(I64(20));
	show(String(sum(xs, ys)));
	show(String(fromBool(same(xs, xs))));
	hello String = greet(String("zane"));
	show(hello);
	show(String(length(hello)));
	v Vec3 = add(Vec3(F64(1.0), F64(2.0), F64(3.0)), Vec3(F64(0.5), F64(0.5), F64(0.5)));
	show(String(v.x));
	show(String(v.z));
	p Pair = mirror(Pair(I32(7), @primitives$Array([F32(1.0), F32(2.0), F32(3.0)]), v));
	show(String(p.id));
	show(String(p.weights[I64(1)]));
	show(String(p.at.y));
	t Tagged = flip(Tagged(I32(3), I64(41)));
	show(String(t.tag));
	show(String(t.n));
	n Nested = nest(Nested(I32(5), Tagged(I32(8), I64(21)), F32(3.0)));
	show(String(n.first));
	show(String(n.inner.tag));
	show(String(n.inner.n));
	show(String(n.last));
	g Gap = widen(gap(I32(4), I64(9)));
	show(String(g.a));
	show(String(g.b));
	w Wrapped = bump(wrapped(I32(5), I64(11)));
	show(String(w.tag));
	show(String(w.tail.n));
	addTo(I64(1000));
	show(String(counter()));
	reset();
	show(String(counter()));
	show(String(counted(I64(10))));
	addTo(I64(1));
	show(String(counted(I64(10))));
	reset();
	show(String(helper()));
	show(String(lib$helper()));
	show(String(named()));
	show(String(lib$named()));
	show(String(lib$plus(I32(40), I32(2))));
	show(String(lib$widen(I64(3))));
	show(String(definedHere(I64(1))));
	show(String(lib$definedHere(I64(1))));
	show(String(lib$once(I64(2))));
	show(String(lib$useOnce()));
	show(String(lib$onceAlias(I64(3))));
	show(String(lib$onceIndirect(I64(4))));
	show(String(lib$onceStarted()));
	show(String(lib$onceValue()));
	show(String(lib$onceHelped()));
	show(String(lib$oncePointed()));
	lib$onceShare(I64(7));
	show(String(lib$onceShared()));
	show(String(lib$onceTokenSame()));
	show(String(lib$oncePointersSame()));
	lib$onceKeep(I64(8));
	show(String(lib$onceKept()));
	show(String(lib$onceCallSame()));
	show(String(lib$onceSetupRuns()));
	show(String(lib$onceSetupSame()));
	show(String(lib$onceExternalRuns()));
	show(String(lib$primed()));
	show(String(lib$primedRuns()));
	show(String(lib$wasWarmed()));
	show(String(lib$parsed()));
	show(String(lib$gnuFound()));
	show(String(result()));
	show(String(args(I64(21))));
	return Unit();
}
