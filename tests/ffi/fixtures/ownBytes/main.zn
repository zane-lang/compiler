/// A header that declares its own `zane_bytes` rather than include
/// `<zane_ffi.h>`, for a string C returns from inside its `const char *`
/// argument: the glue declares the allocator it moves the bytes with.
package ownBytes;

alias Unit = @primitives$Unit;
alias String = @primitives$String;

String rest(text String) foreign "own_rest";

Unit main() {
	@program$console!print(rest(String("xyz")));
	@program$console!print(String.escaped("\n"));
	return Unit();
}
