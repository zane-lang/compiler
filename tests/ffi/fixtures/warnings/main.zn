/// C the compiler warns of: in a file of the package's own directory, which
/// is shown, in an interface header no source includes, shown too, though
/// not for the helpers it leaves unused or its `#pragma once`, and in a
/// vendored file below it, which is not.
package warnings;

alias Unit = @primitives$Unit;
alias I64 = @primitives$I64;

I64 own(x I64) foreign "own";
I64 vendored(x I64) foreign "vendored";

Unit main() {
	return Unit();
}
