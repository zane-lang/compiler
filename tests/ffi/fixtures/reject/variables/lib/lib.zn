/// A capability whose globals the root names, and which declares a foreign
/// variable of its own, which only the root may.
package lib;

alias Unit = @primitives$Unit;
alias Bool = @primitives$Bool;
alias I32 = @primitives$I32;
alias I64 = @primitives$I64;
alias F32 = @primitives$F32;
alias F64 = @primitives$F64;
alias String = @primitives$String;

type Io = #handle{ cType = "io_t"; }

Unit make() {
	io Io foreign "io_global";
	return Unit();
}
