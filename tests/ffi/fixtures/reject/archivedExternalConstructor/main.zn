/// An interface header running an external constructor, which an
/// `archive` row's member compiles too, refused: as for a local one,
/// whether the archive runs the constructor cannot be determined.
package archivedExternalConstructor;

alias I64 = @primitives$I64;
alias Unit = @primitives$Unit;

I64 starts() foreign "starts";

Unit main() {
	starts();
	return Unit();
}
