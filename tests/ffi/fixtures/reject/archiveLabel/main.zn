/// An `archive` row whose member, a Mach-O object, defines a global
/// symbol an `__asm__` label names without the `_` a C name takes there,
/// which renaming cannot reach: the check refuses it, naming the member
/// and the symbol.
package archiveLabel;

alias I64 = @primitives$I64;
alias Unit = @primitives$Unit;

I64 labelled() foreign "labelled";

Unit main() {
	labelled();
	return Unit();
}
