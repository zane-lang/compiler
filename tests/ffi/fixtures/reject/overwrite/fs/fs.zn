/// A capability and the outside handle it opens, which has no setter.
package fs;

alias Unit = @primitives$Unit;
alias Bool = @primitives$Bool;
alias I32 = @primitives$I32;
alias I64 = @primitives$I64;
alias F32 = @primitives$F32;
alias F64 = @primitives$F64;
alias String = @primitives$String;

type Fs = #handle{ cType = "zane_fs_t"; }
type File = #handle{ cType = "zane_file_t"; free = "zane_fclose"; }

^File open(this Fs, path String) mut foreign "zane_fopen";
