/// An interface header running a constructor of its own whose
/// definitions an `archive` row's member compiles too, which the compiler refuses: which of
/// the header's constructors the archive runs cannot be determined from
/// the glue.
package archivedConstructor;

alias I64 = @primitives$I64;
alias Unit = @primitives$Unit;

I64 starts() foreign "starts";

Unit main() {
	starts();
	return Unit();
}
