/// An interface header defining a private constant whose address the
/// program can see, which a source holding assembly, assembled apart,
/// defines too: the glue's copy would have an address of its own, apart
/// from the source's, so the compiler refuses the header.
package assembledConstant;

alias I64 = @primitives$I64;
alias Unit = @primitives$Unit;

I64 tokenSame() foreign "token_same";

Unit main() {
	tokenSame();
	return Unit();
}
