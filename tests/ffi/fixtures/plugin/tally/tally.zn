/// A library package whose exported lambdas the plugin's export line gives
/// C symbols (packages.md §8.3). An exported lambda has root rights in any
/// package, so `add` writes the console (§8.4); `square` writes nothing, and
/// the host calls it from several threads at once (concurrency.md §4.7).
package tally;

alias I64 = @primitives$I64;

add I64(a I64, b I64) {
	@program$console!print(@primitives$String.escaped("tally adds\n"));
	return @operators$add(a, b);
} export "tally_add";

square I64(x I64) => @operators$multiply(x, x) export "tally_square";

I64 fib(n I64) {
	@controlflow$branch(@operators$lessThan(n, I64(2)), {
		return n;
	});
	return @operators$add(fib(@operators$add(n, @operators$negate(I64(1)))), fib(@operators$add(n, @operators$negate(I64(2)))));
}

/// Spawns two calls on the library's own pool, whose threads the library
/// joins as the host unloads it.
pair I64(n I64) {
	a I64 = spawn fib(n);
	b I64 = spawn fib(@operators$add(n, @operators$negate(I64(1))));
	return @operators$add(a, b);
} export "tally_pair";
