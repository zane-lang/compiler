/// Says it started, then works in calls of its own for as many rounds as its
/// argument says, so tier 1 can take over while it runs (docs/design/tiers.md).
package swap;

alias Int = @primitives$I64
alias Unit = @primitives$Unit
alias String = @primitives$String
alias List<T Type> = @primitives$List<T>

Unit to(this Int, end Int, body @concepts$Block) mut {
	@controlflow$repeat(@operators$add(@operators$add(end, @operators$negate(this)), Int(1)), {
		@controlflow$branch(true, body);
		this = @operators$add(this, Int(1));
	});
	return Unit();
}

Int rounds() {
	args List<String> = @program$runtime:arguments();
	@controlflow$branch(@operators$lessThan(args:size(), Int(1)), {
		return Int(10);
	});
	return args[Int(1)]:parseI64() ?? Int(10);
}

/// A Collatz-style walk of `start`, a thousand steps long.
Int walk(start Int) {
	v Int = start;
	sum Int(0);
	step Int(1);
	step!to(Int(1000)) {
		v = @math$bitAnd(@operators$add(@operators$multiply(v, Int(1103515245)), Int(12345)), Int(2147483647));
		sum = @math$bitAnd(@operators$add(sum, v), Int(1048575));
	}
	return sum;
}

Unit main() {
	@program$console!print(String("swap: started\n"));
	total Int(0);
	i Int(1);
	i!to(rounds()) {
		total = @math$bitAnd(@operators$add(total, walk(i)), Int(1048575));
	}
	@program$console!print(@operators$concat(String(total), String("\n")));
	return Unit();
}
