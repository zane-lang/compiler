/// Folding (docs/design/optimization.md): what an optimized build computes
/// at compile time, from the leaves up. Arithmetic at the edges of each
/// scalar and a zero's sign, strings, values and their copies, an abort, a list and a boxed value built and
/// measured, a list and a boxed value a call gives and the program then
/// changes, recursion, a `mut` call, a function value and a spawned call.
/// Each check prints `yes` when it holds and `no` when it does not, so the
/// unoptimized build, which folds nothing, shows the folded one is right.
package folding;

alias Int = @primitives$Int
alias I32 = @primitives$I32
alias Float = @primitives$Float
alias Bool = @primitives$Bool
alias Unit = @primitives$Unit
alias String = @primitives$String
alias List<T Type> = @primitives$List<T>

Bool if(condition Bool, body @concepts$Block) {
	@controlflow$branch(condition, body);
	return condition;
}

Unit to(this Int, end Int, body @concepts$Block) mut {
	@controlflow$repeat(end + ~this + Int(1), {
		@controlflow$branch(true, body);
		this = this + Int(1);
	});
	return Unit();
}

Unit check(ok Bool) {
	yes String("yes\n");
	no String("no\n");
	@controlflow$branch(ok, { @program$console!print(yes); });
	@controlflow$branch(~ok, { @program$console!print(no); });
	return Unit();
}

type Vec = struct {
	x Int;
	y Int;
}

Vec(x Int, y Int) => init{ x; y; }

Unit scale(this Vec, by Int) mut {
	this.x = this.x * by;
	this.y = this.y * by;
	return Unit();
}

type Shape = variant {
	dot Vec;
	circle Float;
	none Unit;
}

Int corners(s Shape) => match (s) {
	d dot => d.x + d.y;
	c circle => Int(0);
	n none => ~Int(1);
}

Int?Int divide(a Int, b Int) {
	if(b == Int(0)) {
		abort a;
	}
	return a / b;
}

Int rescued(a Int, b Int) {
	q Int = divide(a, b) ? e {
		return e + Int(100);
	}
	return q;
}

Int fib(n Int) {
	if(n < Int(2)) {
		return n;
	}
	return fib(n + ~Int(1)) + fib(n + ~Int(2));
}

/// A list built and read inside one call: only the sum leaves it.
Int squares(n Int) {
	values List<Int> = @primitives$List(Int);
	i Int(1);
	i!to(n) {
		values!push(i * i);
	}
	total Int(0);
	j Int(1);
	j!to(values:size()) {
		total = total + values[j];
	}
	return total;
}

type Countdown = variant {
	done Unit;
	more Countdown;
}

Int depth(c Countdown) => match (c) {
	d done => Int(0);
	m more => Int(1) + depth(m);
}

/// A boxed value built and taken apart inside one call.
Int boxed(n Int) {
	c Countdown = Countdown.done(Unit());
	i Int(1);
	i!to(n) {
		c = Countdown.more(c);
	}
	return depth(c);
}

/// A list that leaves the call it is built in.
^List<Int> upTo(n Int) {
	values ^List<Int> = @primitives$List(Int);
	i Int(1);
	i!to(n) {
		values!push(i);
	}
	return values;
}

^List<String> words() {
	values ^List<String> = @primitives$List(String);
	values!push(String("fold"));
	values!push(String("ed"));
	return values;
}

Int sum(values &List<Int>) {
	total Int(0);
	i Int(1);
	i!to(values:size()) {
		total = total + values[i];
	}
	return total;
}

/// A boxed value that leaves the call it is built in.
Countdown countdown(n Int) {
	c Countdown = Countdown.done(Unit());
	i Int(1);
	i!to(n) {
		c = Countdown.more(c);
	}
	return c;
}

String repeated(word String, times Int) {
	out String("");
	i Int(1);
	i!to(times) {
		out = out + word;
	}
	return out;
}

/// A struct copied is a value of its own: changing one copy leaves the
/// other as it was.
Int copied() {
	a Vec = Vec(Int(1), Int(2));
	b Vec = a;
	a.x = Int(9);
	return b.x;
}

Int unchanged(v Vec) {
	w Vec = v;
	w.x = Int(9);
	return v.x;
}

Float inverse(x Float) => Float(1.0) / x

Unit negate(this Float) mut {
	this = ~this;
	return Unit();
}

Int twice(f Int[Int], x Int) => f(f(x))

Int pair(n Int) {
	a Int = spawn fib(n);
	b Int = spawn fib(n + ~Int(1));
	return a + b;
}

Unit main() {
	// Each scalar at its edges: a wrap, the one quotient that wraps, a NaN
	// and a negative zero.
	check(Int(9223372036854775807) + Int(1) < Int(0));
	check(~Int(9223372036854775807) + ~Int(1) / ~Int(1) < Int(0));
	check(I32(2147483647) + I32(1) == ~I32(2147483647) + ~I32(1));
	check(I32(65536) * I32(65536) == I32(0));
	check(I32(7) / ~I32(2) == ~I32(3));
	nan Float = Float(0.0) / Float(0.0);
	check(~(nan == nan));
	check(~(nan < Float(1.0)) * ~(Float(1.0) < nan));
	check(~Float(0.0) == Float(0.0));
	check(Float(1.0) / ~Float(0.0) < Float(0.0));
	check(Float(0.0) < inverse(Float(0.0)));
	check(inverse(~Float(0.0)) < Float(0.0));
	zero Float(0.0);
	zero!negate();
	check(Float(1.0) / zero < Float(0.0));
	check((true + false) * ~(true * false));

	// Strings, joined and compared.
	check(repeated(String("ab"), Int(3)) == String("ababab"));
	check(~(String("a") + String("b") == String("ba")));

	// Values: a struct written by a `mut` call, and a variant matched.
	v Vec = Vec(Int(2), Int(3));
	v!scale(Int(10));
	check(v.x + v.y == Int(50));
	check(corners(Shape.dot(Vec(Int(4), Int(5)))) == Int(9));
	check(corners(Shape.none(Unit())) == ~Int(1));
	check(copied() == Int(1));
	check(unchanged(Vec(Int(1), Int(2))) == Int(1));

	// An abort is a value the handler gets.
	check(rescued(Int(7), Int(0)) == Int(107));
	check(rescued(Int(8), Int(2)) == Int(4));

	// Recursion, a list and a box, each inside a call that gives an Int.
	check(fib(Int(20)) == Int(6765));
	check(squares(Int(10)) == Int(385));
	check(boxed(Int(5)) == Int(5));

	// A list and a box made by a call, then changed where the program runs.
	made List<Int> = upTo(Int(4));
	check(sum(made) == Int(10));
	made!push(Int(10));
	made[Int(1)] = Int(7);
	check(sum(made) == Int(26));
	text List<String> = words();
	check(text[Int(1)] + text[Int(2)] == String("folded"));
	text!push(String("!"));
	check(text:size() == Int(3));
	built Countdown = countdown(Int(3));
	check(depth(built) == Int(3));
	built = Countdown.more(built);
	check(depth(built) == Int(4));

	// A function value, and calls spawned inside a call.
	check(twice(Int(x Int) { return x * Int(3); }, Int(2)) == Int(18));
	check(pair(Int(10)) == Int(89));
	return Unit();
}
