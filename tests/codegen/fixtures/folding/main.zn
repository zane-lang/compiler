/// Folding (docs/design/optimization.md): what an optimized build computes
/// at compile time, from the leaves up. Arithmetic at the edges of each
/// scalar and a zero's sign, strings, values and their copies, an abort, a list and a boxed value built and
/// measured, a list and a boxed value a call gives and the program then
/// changes, recursion, a `mut` call, a function value and a spawned call.
/// Each check prints `yes` when it holds and `no` when it does not, so the
/// unoptimized build, which folds nothing, shows the folded one is right.
package folding;

alias Int = @primitives$I64
alias I32 = @primitives$I32
alias Float = @primitives$F64
alias Bool = @primitives$Bool
alias Unit = @primitives$Unit
alias String = @primitives$String
alias List<T Type> = @primitives$List<T>

Bool if(condition Bool, body @concepts$Block) {
	@controlflow$branch(condition, body);
	return condition;
}

Unit to(this Int, end Int, body @concepts$Block) mut {
	@controlflow$repeat(@operators$add(@operators$add(end, @operators$negate(this)), Int(1)), {
		@controlflow$branch(true, body);
		this = @operators$add(this, Int(1));
	});
	return Unit();
}

Unit check(ok Bool) {
	yes String("yes\n");
	no String("no\n");
	@controlflow$branch(ok, { @program$console!print(yes); });
	@controlflow$branch(@operators$not(ok), { @program$console!print(no); });
	return Unit();
}

type Vec = struct {
	x Int;
	y Int;
}

Vec(x Int, y Int) => init{ x; y; }

Unit scale(this Vec, by Int) mut {
	this.x = @operators$multiply(this.x, by);
	this.y = @operators$multiply(this.y, by);
	return Unit();
}

type Shape = variant {
	dot Vec;
	circle Float;
	none Unit;
}

Int corners(s Shape) => match (s) {
	d dot => @operators$add(d.x, d.y);
	c circle => Int(0);
	n none => @operators$negate(Int(1));
}

Int?Int divide(a Int, b Int) {
	if(@operators$equal(b, Int(0))) {
		abort a;
	}
	return @operators$divide(a, b);
}

Int rescued(a Int, b Int) {
	q Int = divide(a, b) ? e {
		return @operators$add(e, Int(100));
	}
	return q;
}

Int fib(n Int) {
	if(@operators$lessThan(n, Int(2))) {
		return n;
	}
	return @operators$add(fib(@operators$add(n, @operators$negate(Int(1)))), fib(@operators$add(n, @operators$negate(Int(2)))));
}

/// A list built and read inside one call: only the sum leaves it.
Int squares(n Int) {
	values List<Int> = @primitives$List(Int);
	i Int(1);
	i!to(n) {
		values!push(@operators$multiply(i, i));
	}
	total Int(0);
	j Int(1);
	j!to(values:size()) {
		total = @operators$add(total, values[j]);
	}
	return total;
}

type Countdown = variant {
	done Unit;
	more Countdown;
}

Int depth(c Countdown) => match (c) {
	d done => Int(0);
	m more => @operators$add(Int(1), depth(m));
}

/// A boxed value built and taken apart inside one call.
Int boxed(n Int) {
	c Countdown = Countdown.done(Unit());
	i Int(1);
	i!to(n) {
		c = Countdown.more(c);
	}
	return depth(c);
}

/// A list that leaves the call it is built in.
^List<Int> upTo(n Int) {
	values ^List<Int> = @primitives$List(Int);
	i Int(1);
	i!to(n) {
		values!push(i);
	}
	return values;
}

^List<String> words() {
	values ^List<String> = @primitives$List(String);
	values!push(String("fold"));
	values!push(String("ed"));
	return values;
}

Int sum(values &List<Int>) {
	total Int(0);
	i Int(1);
	i!to(values:size()) {
		total = @operators$add(total, values[i]);
	}
	return total;
}

/// A boxed value that leaves the call it is built in.
Countdown countdown(n Int) {
	c Countdown = Countdown.done(Unit());
	i Int(1);
	i!to(n) {
		c = Countdown.more(c);
	}
	return c;
}

String repeated(word String, times Int) {
	out String("");
	i Int(1);
	i!to(times) {
		out = @operators$concat(out, word);
	}
	return out;
}

/// A struct copied is a value of its own: changing one copy leaves the
/// other as it was.
Int copied() {
	a Vec = Vec(Int(1), Int(2));
	b Vec = a;
	a.x = Int(9);
	return b.x;
}

Int unchanged(v Vec) {
	w Vec = v;
	w.x = Int(9);
	return v.x;
}

Float inverse(x Float) => @operators$divide(Float(1.0), x)

Unit negate(this Float) mut {
	this = @operators$negate(this);
	return Unit();
}

Int twice(f Int[Int], x Int) => f(f(x))

Int pair(n Int) {
	a Int = spawn fib(n);
	b Int = spawn fib(@operators$add(n, @operators$negate(Int(1))));
	return @operators$add(a, b);
}

Unit main() {
	// Each scalar at its edges: a wrap, the one quotient that wraps, a NaN
	// and a negative zero.
	check(@operators$lessThan(@operators$add(Int(9223372036854775807), Int(1)), Int(0)));
	check(@operators$lessThan(@operators$add(@operators$negate(Int(9223372036854775807)), @operators$divide(@operators$negate(Int(1)), @operators$negate(Int(1)))), Int(0)));
	check(@operators$equal(@operators$add(I32(2147483647), I32(1)), @operators$add(@operators$negate(I32(2147483647)), @operators$negate(I32(1)))));
	check(@operators$equal(@operators$multiply(I32(65536), I32(65536)), I32(0)));
	check(@operators$equal(@operators$divide(I32(7), @operators$negate(I32(2))), @operators$negate(I32(3))));
	nan Float = @operators$divide(Float(0.0), Float(0.0));
	check(@operators$not(@operators$equal(nan, nan)));
	check(@operators$and(@operators$not(@operators$lessThan(nan, Float(1.0))), @operators$not(@operators$lessThan(Float(1.0), nan))));
	check(@operators$equal(@operators$negate(Float(0.0)), Float(0.0)));
	check(@operators$lessThan(@operators$divide(Float(1.0), @operators$negate(Float(0.0))), Float(0.0)));
	check(@operators$lessThan(Float(0.0), inverse(Float(0.0))));
	check(@operators$lessThan(inverse(@operators$negate(Float(0.0))), Float(0.0)));
	zero Float(0.0);
	zero!negate();
	check(@operators$lessThan(@operators$divide(Float(1.0), zero), Float(0.0)));
	check(@operators$and(@operators$or(true, false), @operators$not(@operators$and(true, false))));

	// Strings, joined and compared.
	check(@operators$equal(repeated(String("ab"), Int(3)), String("ababab")));
	check(@operators$not(@operators$equal(@operators$concat(String("a"), String("b")), String("ba"))));

	// Values: a struct written by a `mut` call, and a variant matched.
	v Vec = Vec(Int(2), Int(3));
	v!scale(Int(10));
	check(@operators$equal(@operators$add(v.x, v.y), Int(50)));
	check(@operators$equal(corners(Shape.dot(Vec(Int(4), Int(5)))), Int(9)));
	check(@operators$equal(corners(Shape.none(Unit())), @operators$negate(Int(1))));
	check(@operators$equal(copied(), Int(1)));
	check(@operators$equal(unchanged(Vec(Int(1), Int(2))), Int(1)));

	// An abort is a value the handler gets.
	check(@operators$equal(rescued(Int(7), Int(0)), Int(107)));
	check(@operators$equal(rescued(Int(8), Int(2)), Int(4)));

	// Recursion, a list and a box, each inside a call that gives an Int.
	check(@operators$equal(fib(Int(20)), Int(6765)));
	check(@operators$equal(squares(Int(10)), Int(385)));
	check(@operators$equal(boxed(Int(5)), Int(5)));

	// A list and a box made by a call, then changed where the program runs.
	made List<Int> = upTo(Int(4));
	check(@operators$equal(sum(made), Int(10)));
	made!push(Int(10));
	made[Int(1)] = Int(7);
	check(@operators$equal(sum(made), Int(26)));
	text List<String> = words();
	check(@operators$equal(@operators$concat(text[Int(1)], text[Int(2)]), String("folded")));
	text!push(String("!"));
	check(@operators$equal(text:size(), Int(3)));
	built Countdown = countdown(Int(3));
	check(@operators$equal(depth(built), Int(3)));
	built = Countdown.more(built);
	check(@operators$equal(depth(built), Int(4)));

	// A function value, and calls spawned inside a call.
	check(@operators$equal(twice(Int(x Int) { return @operators$multiply(x, Int(3)); }, Int(2)), Int(18)));
	check(@operators$equal(pair(Int(10)), Int(89)));
	return Unit();
}
