/// `appendRange` copies a range of one list onto the end of another, and
/// `appendOwn` a range of the list itself, each as one copy of the
/// elements' bytes; a list's own range is read after its block has grown.
/// In a loop, a list that grows by an append is read again after it, as
/// after a push: its block moves as it grows. A list that is an element is
/// found once, after the range's start runs, so a start that grows the list
/// holding it moves it first.
package listAppend;

alias I64 = @primitives$I64;
alias String = @primitives$String;
alias Unit = @primitives$Unit;
alias Row = @primitives$List<I64>;

Unit to(this I64, end I64, body @concepts$Block) mut {
	@controlflow$repeat(@operators$add(@operators$add(end, @operators$negate(this)), I64(1)), {
		@controlflow$branch(true, body);
		this = @operators$add(this, I64(1));
	});
	return Unit();
}

/// Grows the list by `n` rows, which moves its elements into a new block,
/// and gives 1.
I64 growAndGive(this @primitives$List<Row>, n I64) mut {
	i I64(1);
	i!to(n) {
		row Row = @primitives$List(I64);
		row!push(i);
		this!push(row);
	}
	return I64(1);
}

/// The first index, which says each time it runs.
I64 pick() {
	@program$console!print(String(" pick "));
	return I64(1);
}

Unit main() {
	numbers @primitives$List<I64> = @primitives$List(I64);
	numbers!push(I64(1));
	numbers!push(I64(2));
	numbers!push(I64(3));
	// 1 2 3 2 3, then doubled past the first block's room.
	numbers!appendOwn(I64(2), I64(2));
	numbers!appendOwn(I64(1), numbers:size());
	numbers!appendOwn(I64(1), numbers:size());
	numbers!appendOwn(I64(1), numbers:size());
	numbers!appendOwn(I64(1), numbers:size());
	@program$console!print(String(numbers:size()));
	@program$console!print(String(numbers[I64(4)]));
	@program$console!print(String(numbers[I64(80)]));
	other @primitives$List<I64> = @primitives$List(I64);
	other!push(I64(9));
	other!appendRange(numbers, I64(3), I64(3));
	other!appendRange(numbers, I64(1), I64(0));
	@program$console!print(String(other:size()));
	@program$console!print(String(other[I64(2)]));
	@program$console!print(String(other[I64(4)]));
	// Each round appends the list's first element and adds the last: 1 per
	// round, read from a block that has moved under the loop.
	grown @primitives$List<I64> = @primitives$List(I64);
	grown!push(I64(1));
	total I64(0);
	k I64(1);
	k!to(I64(5000)) {
		grown!appendOwn(I64(1), I64(1));
		total = @operators$add(total, grown[grown:size()]);
	}
	@program$console!print(String(grown:size()));
	@program$console!print(String(total));
	// A row found after its start grows the rows, then a row found by a
	// call, which runs once: 7 7 7, and ` pick ` printed once.
	rows @primitives$List<Row> = @primitives$List(Row);
	first Row = @primitives$List(I64);
	first!push(I64(7));
	rows!push(first);
	rows[I64(1)]!appendOwn(rows!growAndGive(I64(1000)), I64(1));
	rows[pick()]!appendOwn(I64(1), I64(1));
	@program$console!print(String(rows:size()));
	@program$console!print(String(rows[I64(1)]:size()));
	@program$console!print(String(rows[I64(1)][I64(3)]));
	return Unit();
}
