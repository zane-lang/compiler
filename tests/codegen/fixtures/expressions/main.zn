/// Verbs whose body is one expression, written out where they are called
/// (docs/design/lowering.md L11): an instance of a generic one, a chain of
/// them, and one whose arguments run in the order they are written, as a
/// call's do, each once however often the body names it. A spawned call to
/// one calls its function, which it keeps. `noted` is written as
/// statements, so it is called. `tripled` is called too: the verb it calls
/// always expands, and its body is longer than an expression verb written
/// out may be. So are `starts`, whose verb spawns, and `first`, whose
/// subscript is longer than that. Each check prints `yes` when it holds and
/// `no` when it does not.
package expressions;

alias Int = @primitives$I64
alias Bool = @primitives$Bool
alias Unit = @primitives$Unit
alias String = @primitives$String
alias List<T Type> = @primitives$List<T>

Unit check(ok Bool) {
	yes String.escaped("yes\n");
	no String.escaped("no\n");
	@controlflow$branch(ok, { @program$console!print(yes); });
	@controlflow$branch(@operators$not(ok), { @program$console!print(no); });
	return Unit();
}

T same(value T Type) => value

Int plus(a Int, b Int) => @operators$add(a, b)

Int twice(x Int) => plus(same(x), same(x))

Int noted(n Int, label String) {
	@program$console!print(label);
	return n;
}

Int stepped(x Int, k @concepts$Int) {
	s0 Int = x;
	s1 Int = @operators$add(s0, Int(k));
	s2 Int = @operators$add(s1, Int(k));
	s3 Int = @operators$add(s2, Int(k));
	s4 Int = @operators$add(s3, Int(k));
	s5 Int = @operators$add(s4, Int(k));
	s6 Int = @operators$add(s5, Int(k));
	s7 Int = @operators$add(s6, Int(k));
	s8 Int = @operators$add(s7, Int(k));
	s9 Int = @operators$add(s8, Int(k));
	s10 Int = @operators$add(s9, Int(k));
	s11 Int = @operators$add(s10, Int(k));
	s12 Int = @operators$add(s11, Int(k));
	return s12;
}

Int tripled(x Int) => stepped(x, 3)

Unit started(n @concepts$Int) {
	spawn noted(Int(n), String.escaped("spawned\n"));
	return Unit();
}

Unit starts() => started(1)

type Row = #struct {
	items List<Int>;
}

Row() => init{
	items = @primitives$List(Int);
}

(this Row)[i Int] => this.items[@operators$add(@operators$add(@operators$add(@operators$add(@operators$add(@operators$add(@operators$add(@operators$add(@operators$add(@operators$add(@operators$add(@operators$add(@operators$add(@operators$add(i, Int(0)), Int(0)), Int(0)), Int(0)), Int(0)), Int(0)), Int(0)), Int(0)), Int(0)), Int(0)), Int(0)), Int(0)), Int(0)), Int(0))]

Int first(row Row) => row[Int(1)]

Unit main() {
	check(@operators$equal(twice(Int(21)), Int(42)));
	check(@operators$equal(twice(noted(Int(21), String.escaped("once\n"))), Int(42)));
	check(@operators$equal(plus(noted(Int(1), String.escaped("first\n")), noted(Int(2), String.escaped("second\n"))), Int(3)));
	check(@operators$equal(tripled(Int(6)), Int(42)));
	starts();
	row Row();
	row.items!push(Int(7));
	check(@operators$equal(first(row), Int(7)));
	later Int = spawn plus(Int(4), Int(5));
	check(@operators$equal(later, Int(9)));
	return Unit();
}
