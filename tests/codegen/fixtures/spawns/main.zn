/// Spawns: calls started with `spawn` run on the pool's threads while the
/// caller goes on (concurrency.md §3). A local bound to one waits for it
/// where it is read, and a block waits for every call spawned in it before
/// it drains (§4.1). Results come home with their blocks: numbers, strings,
/// lists and owners, read, left unread, or dropped. The
/// runtime stops the program if a drain finds a block still out. Each check
/// prints `yes` when it holds and `no` when it does not.
package spawns;

alias Int = @primitives$I64
alias Bool = @primitives$Bool
alias Unit = @primitives$Unit
alias String = @primitives$String
alias List<T Type> = @primitives$List<T>

/// Advances the counter through the inclusive range, running the block once
/// per step.
Unit to(this Int, end Int, body @concepts$Block) mut {
	@controlflow$repeat(@operators$add(@operators$add(end, @operators$negate(this)), Int(1)), {
		@controlflow$branch(true, body);
		this = @operators$add(this, Int(1));
	});
	return Unit();
}

type Tally = struct {
	total Int;
}

Tally(total Int) => init{ total; }

Unit add(this Tally, n Int) mut {
	this.total = @operators$add(this.total, n);
	return Unit();
}

/// A value that boxes itself, so it owns a block for each level.
type Countdown = variant {
	done Unit;
	more Countdown;
}

Int depth(c Countdown) => match (c) {
	d done => Int(0);
	m more => @operators$add(Int(1), depth(m));
}

/// Adds `n` levels, one whole copy at a time.
Unit deepen(this Countdown, n Int) mut {
	i Int(1);
	i!to(n) {
		this = Countdown.more(this);
	}
	return Unit();
}

/// An owner holding values that spawned calls write while others read them.
type Holder = #struct {
	count Countdown;
	tally Tally;
}

Holder(count Countdown) => init{ count; tally = Tally(Int(0)); }

/// Reads the countdown through the owner `n` times. Each read is a whole
/// snapshot, so it sees every level a write-back put there or none.
Int watch(h &Holder, n Int, whole Int) {
	seen Int(0);
	i Int(1);
	i!to(n) {
		c Countdown = h.count;
		d Int = depth(c);
		@controlflow$branch(@operators$equal(d, Int(0)), {
			seen = @operators$add(seen, Int(1));
		});
		@controlflow$branch(@operators$equal(d, whole), {
			seen = @operators$add(seen, Int(1));
		});
	}
	return seen;
}

type Person = #struct {
	name String;
	age Int;
}

Person(name String, age Int) => init{ name; age; }

Unit check(ok Bool) {
	yes String("yes\n");
	no String("no\n");
	@controlflow$branch(ok, {
		@program$console!print(yes);
	});
	@controlflow$branch(@operators$not(ok), {
		@program$console!print(no);
	});
	return Unit();
}

Int fib(n Int) {
	@controlflow$branch(@operators$lessThan(n, Int(2)), {
		return n;
	});
	return @operators$add(fib(@operators$add(n, @operators$negate(Int(1)))), fib(@operators$add(n, @operators$negate(Int(2)))));
}

/// Spawns two calls of its own and waits for both.
Int pair(n Int) {
	a Int = spawn fib(n);
	b Int = spawn fib(@operators$add(n, @operators$negate(Int(1))));
	return @operators$add(a, b);
}

String greet(name String) {
	return @operators$concat(String("hi "), name);
}

String nameOf(p &Person) {
	return @operators$concat(p.name, String("!"));
}

^Person born(name String, age Int) {
	return Person(@operators$concat(name, String(" lovelace")), age);
}

^List<String> words(n Int) {
	all ^List<String> = @primitives$List(String);
	i Int(1);
	i!to(n) {
		all!push(@operators$concat(String("w"), String("!")));
	}
	return all;
}

Unit nothing() {
	return Unit();
}

/// Aborts with a string made on its own thread when `b` is zero.
Int?String divide(a Int, b Int) {
	@controlflow$branch(@operators$equal(b, Int(0)), {
		abort @operators$concat(String("by "), String("zero"));
	});
	return @operators$divide(a, b);
}

/// A spawned call's abort passed on from its handler, changed.
Int?String relay(a Int, b Int) {
	q Int = spawn divide(a, b) ? e {
		abort @operators$concat(e, String("!"));
	}
	return @operators$add(q, Int(1));
}

/// Exits when `n` is 2, which ends the run of the caller's block.
Int pick(n Int) {
	@controlflow$branch(@operators$equal(n, Int(2)), {
		@controlflow$exitFromCall();
	});
	return n;
}

Int ageOf(p Person) => p.age

Unit main() {
	// The pool resized before it starts, and a count it refuses.
	@program$runtime!setThreads(Int(2)) ? u {
		resolve Unit();
	}
	refused Int(0);
	@program$runtime!setThreads(Int(0)) ? u {
		refused = Int(1);
		resolve Unit();
	}
	check(@operators$equal(refused, Int(1)));

	// A number, read after the caller goes on.
	a Int = spawn fib(Int(20));
	check(@operators$equal(a, Int(6765)));

	// A string made on another thread comes home with its bytes, and the
	// value lent to the call lives until it returns.
	who String("ada");
	s String = spawn greet(who);
	check(@operators$equal(s, String("hi ada")));

	// A reference passed to a spawned call.
	p Person(String("grace"), Int(85));
	g &Person = p;
	n String = spawn nameOf(g);
	check(@operators$equal(n, String("grace!")));

	// An owner lent to a spawned call by a borrow may be borrowed again
	// while the call reads it.
	lent ^Person = Person(String("ada"), Int(36));
	read Int = spawn ageOf(lent);
	check(@operators$equal(ageOf(lent), Int(36)));
	check(@operators$equal(read, Int(36)));

	// An owner returned: it settles where it comes home, and a reference
	// names it there.
	q Person = spawn born(String("ada"), Int(36));
	h &Person = q;
	check(@operators$equal(h.name, String("ada lovelace")));
	check(@operators$equal(h.age, Int(36)));

	// A list built on another thread.
	w List<String> = spawn words(Int(50));
	check(@operators$equal(w:size(), Int(50)));

	// A mutating call on a value, waited for when its block drains.
	t Tally(Int(0));
	@controlflow$branch(true, {
		spawn t!add(Int(5));
	});
	check(@operators$equal(t.total, Int(5)));

	// Mutating calls on values that own blocks, all at once: each returns
	// and takes blocks in the caller's region while the others do.
	c1 Countdown = Countdown.done(Unit());
	c2 Countdown = Countdown.done(Unit());
	c3 Countdown = Countdown.done(Unit());
	@controlflow$branch(true, {
		spawn c1!deepen(Int(200));
		spawn c2!deepen(Int(300));
		spawn c3!deepen(Int(400));
	});
	check(@operators$equal(@operators$add(@operators$add(depth(c1), depth(c2)), depth(c3)), Int(900)));

	// A value in an owner written by a spawned call while another reads it:
	// the writer works on a copy it writes back, and each read is a
	// coherent snapshot.
	holder Holder(Countdown.done(Unit()));
	seer &Holder = holder;
	@controlflow$branch(true, {
		watched Int = spawn watch(seer, Int(300), Int(250));
		spawn holder.count!deepen(Int(250));
		spawn holder.tally!add(Int(3));
		check(@operators$equal(watched, Int(300)));
	});
	check(@operators$equal(depth(holder.count), Int(250)));
	check(@operators$equal(holder.tally.total, Int(3)));

	// Calls that spawn calls of their own, all at once.
	x Int = spawn pair(Int(18));
	y Int = spawn pair(Int(17));
	z Int = spawn fib(Int(20));
	check(@operators$equal(@operators$add(x, y), z));

	// One spawn per pass of a loop, each waited for as its pass drains.
	sum Int(0);
	i Int(1);
	i!to(Int(10)) {
		f Int = spawn fib(i);
		sum = @operators$add(sum, f);
	}
	check(@operators$equal(sum, Int(143)));

	// A result never read, and one dropped: both come home at the drain,
	// which returns their blocks.
	@controlflow$branch(true, {
		unread String = spawn greet(String("nobody"));
		spawn greet(String("no one"));
		spawn words(Int(5));
		spawn nothing();
	});

	// The pool resized while calls run, and back to one thread for each
	// processor.
	@program$runtime!setThreads(Int(8)) ? u {
		resolve Unit();
	}
	@controlflow$branch(true, {
		spawn words(Int(20));
		@program$runtime!setThreads(Int(1)) ? u {
			resolve Unit();
		}
		spawn words(Int(20));
	});
	@program$runtime!setThreadsAuto();

	// A call that aborts settles where it is first read: its handler runs
	// once, on this thread, and what it resolves is the result.
	runs Int(0);
	q1 Int = spawn divide(Int(9), Int(3)) ? e {
		runs = @operators$add(runs, Int(1));
		resolve Int(0);
	}
	q2 Int = spawn divide(Int(9), Int(0)) ? e {
		check(@operators$equal(e, String("by zero")));
		runs = @operators$add(runs, Int(1));
		resolve Int(7);
	}
	check(@operators$equal(q1, Int(3)));
	check(@operators$equal(@operators$add(q2, q2), Int(14)));
	check(@operators$equal(runs, Int(1)));
	q3 Int = spawn divide(Int(1), Int(0)) ?? Int(4);
	check(@operators$equal(q3, Int(4)));
	check(@operators$equal(relay(Int(8), Int(2)) ?? Int(0), Int(5)));
	check(@operators$equal(relay(Int(8), Int(0)) ? e { resolve Int(100); }, Int(100)));
	relayed String = String("");
	relay(Int(8), Int(0)) ? e {
		relayed = e;
		resolve Int(0);
	}
	check(@operators$equal(relayed, String("by zero!")));

	// Calls nothing reads settle where their block ends.
	ran Int(0);
	@controlflow$branch(true, {
		unread Int = spawn divide(Int(1), Int(0)) ? e {
			ran = @operators$add(ran, Int(1));
			resolve Int(0);
		}
		spawn divide(Int(2), Int(0)) ? e {
			ran = @operators$add(ran, Int(10));
			resolve Int(0);
		}
		spawn divide(Int(2), Int(1)) ? e {
			ran = @operators$add(ran, Int(100));
			resolve Int(0);
		}
	});
	check(@operators$equal(ran, Int(11)));

	// A call that exits ends the run of its block where it is read.
	passes Int(0);
	j Int(1);
	j!to(Int(4)) {
		k Int = spawn pick(j);
		passes = @operators$add(passes, k);
	}
	check(@operators$equal(passes, Int(8)));

	// A spawned call read where it is written, and a local written after
	// its call is spawned.
	check(@operators$equal(spawn fib(Int(10)), Int(55)));
	r Int = spawn fib(Int(12));
	r = @operators$add(r, Int(1));
	check(@operators$equal(r, Int(145)));
	return Unit();
}
