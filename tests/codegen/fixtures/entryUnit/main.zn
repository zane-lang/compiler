/// A `main` that returns `Unit`, which the runtime's entry discards
/// (docs/design/lowering.md L16).
package entryUnit;

alias Int = @primitives$I64
alias Unit = @primitives$Unit
alias String = @primitives$String

Unit main() {
	done String.escaped("main returns unit\n");
	@program$console!print(done);
	return Unit();
}
