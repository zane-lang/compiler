/// A chain of 300 distinct structs that ends in an `Int` and a `String`,
/// held by a reference type beside a `&` member. Nothing in it grows, so its
/// layout, its owned blocks and what it reaches through references are found
/// however long it is (Tty.Growth). Each check prints `yes` when it holds
/// and `no` when it does not. Each struct has one member but S150, whose
/// second makes the chain a struct there rather than the member it holds,
/// and S299 at the end.
package longChain;

alias Int = @primitives$I64;
alias Bool = @primitives$Bool;
alias Unit = @primitives$Unit;
alias String = @primitives$String;

type Leaf = #struct {
	n Int;
}

Leaf(n Int) => init{ n; }

Unit bump(this Leaf) mut {
	this.n = @operators$add(this.n, Int(1));
	return Unit();
}

type Top = #struct {
	at &Leaf;
	chain S0;
}

Top(at &Leaf, chain S0) => init{ at; chain; }

/// A write through a `Top`, which the borrow analysis follows down every
/// member to the `Leaf` its `&` member names.
Unit bump(this Top) mut {
	this.at!bump();
	return Unit();
}

Unit check(ok Bool) {
	yes String.escaped("yes\n");
	no String.escaped("no\n");
	@controlflow$branch(ok, {
		@program$console!print(yes);
	});
	@controlflow$branch(@operators$not(ok), {
		@program$console!print(no);
	});
	return Unit();
}


