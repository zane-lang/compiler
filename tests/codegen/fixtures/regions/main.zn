/// Regions: every scope keeps the blocks its values own in a dynamic region
/// of its own, returned together at its drain (memory.md §3.1–3.2). A value
/// that escapes a scope takes its blocks out first: a roaming owner
/// returned, a list built in a loop, a result left from a `match` arm, a
/// string aborted with, and values stored or pushed from an inner block into
/// an outer one, which a reference then names. A checked drain stops the program if it finds a
/// block still out, so a run that ends cleanly moved every one. Each check
/// prints `yes` when it holds and `no` when it does not.
package regions;

alias Int = @primitives$I64
alias Bool = @primitives$Bool
alias Unit = @primitives$Unit
alias String = @primitives$String
alias List<T Type> = @primitives$List<T>
alias Words = @primitives$List<String>

/// Advances the counter through the inclusive range, running the block once
/// per step.
Unit to(this Int, end Int, body @concepts$Block) mut {
	@controlflow$repeat(@operators$add(@operators$add(end, @operators$negate(this)), Int(1)), {
		@controlflow$branch(true, body);
		this = @operators$add(this, Int(1));
	});
	return Unit();
}

type Person = #struct {
	name String;
	friends List<String>;
}

Person(name String) => init{ name; friends = @primitives$List(String); }

type Choice = variant {
	left Unit;
	right Unit;
}

Unit check(ok Bool) {
	yes String("yes\n");
	no String("no\n");
	@controlflow$branch(ok, {
		@program$console!print(yes);
	});
	@controlflow$branch(@operators$not(ok), {
		@program$console!print(no);
	});
	return Unit();
}

/// A roaming owner made here, written, and returned: its blocks leave with
/// it before this call's scope drains.
^Person made() {
	p ^Person = Person(@operators$concat(String("ada"), String(" lovelace")));
	p.friends!push(@operators$concat(String("charles"), String(" babbage")));
	check(@operators$equal(p.name, String("ada lovelace")));
	return p;
}

/// A list of strings built in a loop, where each pass holds one of its own.
^Words built(n Int) {
	words ^Words = @primitives$List(String);
	i Int(1);
	i!to(n) {
		piece String = @operators$concat(String("w"), String("!"));
		words!push(piece);
	}
	return words;
}

/// A list of lists, returned from a scope nested in the call's.
^List<Words> nested() {
	rows ^List<Words> = @primitives$List(Words);
	i Int(1);
	i!to(Int(3)) {
		rows!push(built(i));
	}
	return rows;
}

/// A result left from a `match` arm that holds a string of its own.
String chosen(c Choice) => match (c) {
	l left {
		here String = @operators$concat(String("le"), String("ft"));
		return @operators$concat(here, String("!"));
	}
	r right => String("right");
}

String?String refused() {
	kept String = @operators$concat(String("no"), String("pe"));
	abort kept;
}

Unit main() {
	// A returned owner keeps its blocks, settles here, and a reference made
	// to it reaches them.
	p Person = made();
	h &Person = p;
	check(@operators$equal(h.name, String("ada lovelace")));
	check(@operators$equal(p.friends[Int(1)], String("charles babbage")));

	// A list returned from a loop's scopes, and a list of them.
	words List<String> = built(Int(100));
	check(@operators$equal(words:size(), Int(100)));
	check(@operators$equal(words[Int(100)], String("w!")));
	rows List<Words> = nested();
	check(@operators$equal(rows[Int(3)]:size(), Int(3)));
	check(@operators$equal(rows[Int(2)][Int(2)], String("w!")));

	// Stored and pushed from an inner block, into an outer one's.
	s String("");
	late List<String> = @primitives$List(String);
	i Int(1);
	i!to(Int(50)) {
		inner String = @operators$concat(String("in"), String("ner"));
		s = @operators$concat(inner, String("!"));
		late!push(@operators$concat(inner, String("?")));
	}
	check(@operators$equal(s, String("inner!")));
	check(@operators$equal(late[Int(50)], String("inner?")));

	// Left from an arm, and aborted with.
	check(@operators$equal(chosen(Choice.left(Unit())), String("left!")));
	check(@operators$equal(refused() ? e { resolve e; }, String("nope")));

	// A long list grows where it is while nothing follows it, and moves
	// past what does.
	long List<Int> = @primitives$List(Int);
	j Int(1);
	j!to(Int(100000)) {
		long!push(j);
	}
	check(@operators$equal(long[Int(100000)], Int(100000)));
	check(@operators$equal(long[Int(1)], Int(1)));
	return Unit();
}
