/// A variant of 300 cases, more than a byte tells apart, so it keeps a
/// 4-byte tag: cases 1 and 257, whose tags share their low byte, each own
/// a string, and a list of them is matched and drained case by case.
/// Each check prints `yes` when it holds and `no` when it does not.
package wideSum;

alias Int = @primitives$I64;
alias Bool = @primitives$Bool;
alias Unit = @primitives$Unit;
alias String = @primitives$String;
alias ListRef<T Type> = @primitives$ListRef<T>;

Unit check(ok Bool) {
	yes String.escaped("yes\n");
	no String.escaped("no\n");
	@controlflow$branch(ok, { @program$console!print(yes); });
	@controlflow$branch(@operators$not(ok), { @program$console!print(no); });
	return Unit();
}

