/// A float truncated to an integer that cannot hold what is left stops the
/// program with a failing status, after what it wrote so far (types.md
/// §2.7).
package truncation;

alias I32 = @primitives$I32
alias F64 = @primitives$F64

F64 big() => F64(2147483648.0)

@primitives$Unit main() {
	before @primitives$String("before\n");
	after @primitives$String("after\n");
	@program$console!print(before);
	n I32 = I32.truncate(big());
	@program$console!print(after);
	return @primitives$Unit();
}
