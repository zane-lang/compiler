/// Lists: `@primitives$List<T>`, a handle to a block that grows (memory.md
/// §3.6). Pushed to, measured, indexed and written at an index; lists of
/// scalars, strings, owners and lists; a generic type over one with a
/// declared subscript, and a generic verb. A roaming owner moves into a
/// list, whose elements move with every block it grows into, and one
/// replaced at an index dies. Each check prints `yes` when it holds and `no`
/// when it does not.
package lists;

alias Int = @primitives$I64
alias Bool = @primitives$Bool
alias Unit = @primitives$Unit
alias String = @primitives$String
alias List<T Type> = @primitives$List<T>
alias Row = @primitives$List<Int>

/// Advances the counter through the inclusive range, running the block once
/// per step.
Unit to(this Int, end Int, body @concepts$Block) mut {
	@controlflow$repeat(@operators$add(@operators$add(end, @operators$negate(this)), Int(1)), {
		@controlflow$branch(true, body);
		this = @operators$add(this, Int(1));
	});
	return Unit();
}

type Person = #struct {
	name String;
	age Int;
}

Person(name String, age Int) => init{ name; age; }

/// A generic type over a list, with a declared subscript.
type Stack<T Type> = #struct {
	items List<T>;
}

Stack<T>(T Type) => init{ items = @primitives$List(T); }

Unit add(this Stack<T Type>, value T) mut {
	this.items!push(value);
	return Unit();
}

(this Stack<T Type>)[index Int] => this.items[index]

/// A generic verb.
Int count(values &List<T Type>) => values:size()

Int sum(values &List<Int>) {
	total Int(0);
	i Int(1);
	i!to(values:size()) {
		total = @operators$add(total, values[i]);
	}
	return total;
}

Unit check(ok Bool) {
	yes String("yes\n");
	no String("no\n");
	@controlflow$branch(ok, {
		@program$console!print(yes);
	});
	@controlflow$branch(@operators$not(ok), {
		@program$console!print(no);
	});
	return Unit();
}

Unit main() {
	// Scalars: pushed, counted, read and written.
	numbers List<Int> = @primitives$List(Int);
	check(@operators$equal(numbers:size(), Int(0)));
	i Int(1);
	i!to(Int(100)) {
		numbers!push(i);
	}
	check(@operators$equal(count(numbers), Int(100)));
	check(@operators$equal(@operators$add(numbers[Int(1)], numbers[Int(100)]), Int(101)));
	numbers[Int(50)] = Int(0);
	check(@operators$equal(sum(numbers), Int(5000)));

	// Strings, moved in and read where they are.
	words List<String> = @primitives$List(String);
	words!push(String("to"));
	late String("be");
	words!push(late);
	check(@operators$equal(@operators$concat(words[Int(1)], words[Int(2)]), String("tobe")));
	words[Int(1)] = String("or");
	check(@operators$equal(words[Int(1)], String("or")));

	// Owners: a roaming one moves into the list, which keeps its elements
	// through every block it grows into.
	people List<Person> = @primitives$List(Person);
	ada ^Person = Person(String("ada"), Int(36));
	people!push(ada);
	j Int(1);
	j!to(Int(1000)) {
		people!push(Person(String("x"), j));
	}
	check(@operators$equal(people[Int(1)].name, String("ada")));
	check(@operators$equal(people[Int(1001)].age, Int(1000)));

	// An element replaced at its index: the old one dies with its block.
	people[Int(1)] = Person(String("grace"), Int(45));
	check(@operators$equal(people[Int(1)].name, String("grace")));
	check(@operators$equal(people:size(), Int(1001)));

	// A list of lists.
	rows List<Row> = @primitives$List(Row);
	k Int(1);
	k!to(Int(3)) {
		row ^Row = @primitives$List(Int);
		row!push(k);
		row!push(@operators$multiply(k, Int(10)));
		rows!push(row);
	}
	check(@operators$equal(rows[Int(3)][Int(2)], Int(30)));

	// A generic type, and its declared subscript.
	stack Stack<String> = Stack(String);
	stack!add(String("first"));
	stack!add(String("second"));
	check(@operators$equal(stack[Int(2)], String("second")));
	check(@operators$equal(count(stack.items), Int(2)));
	return Unit();
}
