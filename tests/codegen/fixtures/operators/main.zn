/// The derived operators of operators.md §2.3, on intrinsic and declared
/// operators: each gives its value, and its operands run in the order they
/// were written, whichever way round the desugaring passes them. Then a `'`
/// between digits, which separates them and changes nothing
/// (docs/spec-divergences.md §8). Every check prints `yes` when it holds and
/// `no` when it does not.
package operators;

alias Int = @primitives$Int
alias Float = @primitives$Float
alias Bool = @primitives$Bool
alias Unit = @primitives$Unit
alias String = @primitives$String

Bool if(condition Bool, body @concepts$Block) {
	@controlflow$branch(condition, body);
	return condition;
}

Unit else(this Bool, body @concepts$Block) {
	@controlflow$branch(~this, body);
	return Unit();
}

Unit check(holds Bool) {
	yes String("yes\n");
	no String("no\n");
	ran Bool = if(holds) {
		@program$console!print(yes);
	}
	ran:else() {
		@program$console!print(no);
	}
	return Unit();
}

/// A value that says when it is read.
Int say(value Int, name String) {
	@program$console!print(name);
	return value;
}

/// A type whose only comparison is the `<` it declares.
type Weight = struct { grams Int; }

Weight(grams Int) => init{ grams; }

Bool <(left Weight, right Weight) => left.grams < right.grams

Weight heavy(grams Int, name String) {
	@program$console!print(name);
	return Weight(grams);
}

Unit main() {
	a String("a ");
	b String("b ");
	line String("\n");

	// The intrinsic comparisons, each way round.
	check(Int(9) > Int(5));
	check(~(Int(5) > Int(9)));
	check(Int(5) <= Int(9));
	check(Int(9) <= Int(9));
	check(~(Int(9) <= Int(5)));
	check(Int(9) >= Int(5));
	check(~(Int(5) >= Int(9)));
	check(Float(2.5) > Float(1.5));
	check(Int(9) - Int(5) == Int(4));

	// Written order, printed: every line reads `a b`.
	greater Bool = say(Int(1), a) > say(Int(2), b);
	@program$console!print(line);
	atMost Bool = say(Int(1), a) <= say(Int(2), b);
	@program$console!print(line);
	atLeast Bool = say(Int(1), a) >= say(Int(2), b);
	@program$console!print(line);
	check(~greater * atMost * ~atLeast);

	// A declared `<`, reached through the derived forms.
	check(Weight(Int(9)) > Weight(Int(5)));
	check(~(Weight(Int(5)) > Weight(Int(9))));
	check(Weight(Int(5)) <= Weight(Int(9)));
	check(~(Weight(Int(9)) <= Weight(Int(5))));
	lighter Bool = heavy(Int(1), a) > heavy(Int(2), b);
	@program$console!print(line);
	check(~lighter);

	// Separated digits.
	million Int(1'000'000);
	check(million == Int(1000000));
	ratio Float(1'000.25);
	check(ratio == Float(1000.25));
	return Unit();
}
