/// `sort` sorts a list of integers in place, ascending: 32-bit integers
/// past the sizes insertion sort and the pivot's medians of medians take,
/// with many equal keys, and 64-bit integers already in descending order.
/// Each list is checked whole: the count of out-of-order neighbours (or, for
/// the descending list, of elements off their place) is 0, and the 32-bit
/// list's keys keep their sum and each key its count from before the sort.
package listSort;

alias I64 = @primitives$I64;
alias I32 = @primitives$I32;
alias Bool = @primitives$Bool;
alias String = @primitives$String;
alias Unit = @primitives$Unit;

Unit main() {
	small @primitives$List<I32> = @primitives$List(I32);
	seed I64 = I64(7);
	@controlflow$repeat(I64(1000)) {
		seed = @operators$add(@operators$multiply(seed, I64(1103515245)), I64(12345));
		small!push(I32.wrap(@operators$divide(seed, I64(2305843009213693952))));
	}
	before I64 = I64(0);
	i I64 = I64(1);
	@controlflow$repeat(I64(1000)) {
		before = @operators$add(before, I64(small[i]));
		i = @operators$add(i, I64(1));
	}
	unsorted @primitives$List<I32> = small;
	small!sort();
	after I64 = I64(0);
	bad I64 = I64(0);
	i = I64(1);
	@controlflow$repeat(I64(1000)) {
		after = @operators$add(after, I64(small[i]));
		@controlflow$branch(@operators$lessThan(I64(1), i), {
			@controlflow$branch(@operators$lessThan(small[i], small[@operators$add(i, @operators$negate(I64(1)))]), {
				bad = @operators$add(bad, I64(1));
			});
		});
		i = @operators$add(i, I64(1));
	}
	@program$console!print(String(bad));
	@program$console!print(String(@operators$add(after, @operators$negate(before))));
	// Each of the eight keys, -4 to 3, keeps its count from before the sort.
	moved I64 = I64(0);
	key I64 = @operators$negate(I64(4));
	@controlflow$repeat(I64(8)) {
		was I64 = I64(0);
		now I64 = I64(0);
		i = I64(1);
		@controlflow$repeat(I64(1000)) {
			@controlflow$branch(@operators$equal(I64(unsorted[i]), key), {
				was = @operators$add(was, I64(1));
			});
			@controlflow$branch(@operators$equal(I64(small[i]), key), {
				now = @operators$add(now, I64(1));
			});
			i = @operators$add(i, I64(1));
		}
		@controlflow$branch(@operators$not(@operators$equal(was, now)), {
			moved = @operators$add(moved, I64(1));
		});
		key = @operators$add(key, I64(1));
	}
	@program$console!print(String(moved));
	@program$console!print(String(I64(small[I64(1)])));
	@program$console!print(String(I64(small[I64(500)])));
	@program$console!print(String(I64(small[I64(1000)])));
	big @primitives$List<I64> = @primitives$List(I64);
	n I64 = I64(300);
	@controlflow$repeat(I64(300)) {
		big!push(n);
		n = @operators$add(n, @operators$negate(I64(1)));
	}
	big!sort();
	off I64 = I64(0);
	i = I64(1);
	@controlflow$repeat(I64(300)) {
		@controlflow$branch(@operators$not(@operators$equal(big[i], i)), {
			off = @operators$add(off, I64(1));
		});
		i = @operators$add(i, I64(1));
	}
	@program$console!print(String(off));
	@program$console!print(String(big[I64(1)]));
	@program$console!print(String(big[I64(150)]));
	@program$console!print(String(big[I64(300)]));
	return Unit();
}
