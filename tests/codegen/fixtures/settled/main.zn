/// References: `&T` minted from settled owners, their fields and
/// parameters, read and written through, passed and returned, and stored in
/// fields. A settled owner never moves, so a reference is its address: an
/// overwrite of the owner, or of the owner around it, is made in place and
/// the reference observes the replacement (memory.md §2.2, §4). A roaming
/// owner settles where it lands. Each check prints `yes` when it holds and
/// `no` when it does not.
package settled;

alias Int = @primitives$Int
alias Bool = @primitives$Bool
alias Unit = @primitives$Unit
alias String = @primitives$String

/// Runs the block when the condition holds, and reports whether it did.
Bool if(condition Bool, body @concepts$Block) {
	@controlflow$branch(condition, body);
	return condition;
}

/// Advances the counter through the inclusive range, running the block once
/// per step.
Unit to(this Int, end Int, body @concepts$Block) mut {
	@controlflow$repeat(end + ~this + Int(1), {
		@controlflow$branch(true, body);
		this = this + Int(1);
	});
	return Unit();
}

type Node = #struct {
	value Int;
}

Node(value Int) => init{ value; }

Unit bump(this Node) mut {
	this.value = this.value + Int(1);
	return Unit();
}

Int twice(this Node) => this.value * Int(2)

Int peek(node &Node) => node.value

/// Returns one of two references it was given.
&Node larger(a &Node, b &Node) {
	if(b.value < a.value) {
		return a;
	}
	return b;
}

type Car = #struct {
	engine &Node;
	spare Node;
}

Car(engine &Node, spare ^Node) => init{ engine; spare; }

type Holder = #variant {
	some Node;
	none Unit;
}

Unit check(ok Bool) {
	yes String("yes\n");
	no String("no\n");
	@controlflow$branch(ok, {
		@program$console!print(yes);
	});
	@controlflow$branch(~ok, {
		@program$console!print(no);
	});
	return Unit();
}

Unit main() {
	// A reference reads and writes the settled owner it names, and the
	// owner's own writes show through it.
	a Node(Int(1));
	g &Node = a;
	a!bump();
	check(g.value == Int(2));
	g!bump();
	check(a.value == Int(3));
	check((peek(g) == Int(3)) * (peek(a) == Int(3)));
	check(g:twice() == Int(6));

	// An overwrite of a settled owner is made in place, and the reference
	// observes the replacement.
	a = Node(Int(7));
	check(g.value == Int(7));

	// A roaming owner settles where it lands, and is referenced from there.
	spare ^Node = Node(Int(20));
	spare!bump();
	b Node = spare;
	h &Node = b;
	check(h.value == Int(21));
	b = Node(Int(100));
	check(h.value == Int(100));

	// A reference passed and returned, and one repointed.
	check(larger(a, b).value == Int(100));
	g = b;
	check(g.value == Int(100));

	// A reference field, and a reference minted from an owning field of a
	// settled owner.
	car Car(a, Node(Int(5)));
	car.engine!bump();
	check(a.value == Int(8));
	s &Node = car.spare;
	s!bump();
	check(car.spare.value == Int(6));
	car.spare = Node(Int(50));
	check(s.value == Int(50));

	// The whole owner overwritten in place: a reference into its field
	// observes the replacement's field.
	car = Car(b, Node(Int(60)));
	check(s.value == Int(60));
	check(car.engine.value == Int(100));

	// A binder is its payload's place: a write through it stays.
	kept Holder = Holder.some(Node(Int(30)));
	check(match (kept) {
		k some {
			k!bump();
			return k.value == Int(31);
		}
		z none => false;
	});
	check(match (kept) {
		k some => k.value == Int(31);
		z none => false;
	});

	// A fresh scrutinee is held where it is matched.
	check(match (Holder.some(Node(Int(40)))) {
		k some {
			k!bump();
			return k.value == Int(41);
		}
		z none => false;
	});

	// Many references minted and dropped: each pass's owner drains with its
	// block, and nothing is kept for a reference.
	total Int(0);
	i Int(1);
	i!to(Int(100000)) {
		x Node(i);
		y &Node = x;
		total = total + peek(y);
	}
	check(total == Int(5000050000));
	return Unit();
}
