/// What folding keeps (docs/design/optimization.md O4, O6): output made
/// while computing a value is replayed where the code was, in order; a call
/// that runs out of the step budget, one that nests calls too deep, and one
/// whose value is past the size cap stay runtime code, with the constant code
/// inside them still folded; a store made inside an expression that folds is
/// still made for a read that happens when the program runs, and what code
/// left to run writes is not known after it. Each check
/// prints `yes` when it holds and `no` when it does not, and every line
/// written shows the order held.
package replayed;

alias Int = @primitives$I64
alias Bool = @primitives$Bool
alias Unit = @primitives$Unit
alias String = @primitives$String

Bool if(condition Bool, body @concepts$Block) {
	@controlflow$branch(condition, body);
	return condition;
}

Unit to(this Int, end Int, body @concepts$Block) mut {
	@controlflow$repeat(@operators$add(@operators$add(end, @operators$negate(this)), Int(1)), {
		@controlflow$branch(true, body);
		this = @operators$add(this, Int(1));
	});
	return Unit();
}

Unit say(text String) {
	@program$console!print(text);
	return Unit();
}

Unit check(ok Bool) {
	@controlflow$branch(ok, { say(String("yes\n")); });
	@controlflow$branch(@operators$not(ok), { say(String("no\n")); });
	return Unit();
}

/// Writes while it computes.
Int loud(n Int) {
	say(String("computing\n"));
	return @operators$multiply(n, Int(2));
}

/// Three million steps: past the budget, so it runs when the program does.
Int spin(n Int) {
	total Int(0);
	i Int(1);
	i!to(n) {
		total = @operators$add(@operators$add(total, @operators$multiply(Int(2), Int(3))), @operators$negate(Int(5)));
	}
	return total;
}

/// Five thousand calls deep: past the depth a fold may go.
Int down(n Int) {
	if(@operators$equal(n, Int(0))) {
		return Int(0);
	}
	return @operators$add(Int(1), down(@operators$add(n, @operators$negate(Int(1)))));
}

Int bumped(this Int, by Int) mut {
	this = @operators$add(this, by);
	return this;
}

Int double(n Int) => @operators$multiply(n, Int(2))

/// Reads its subject's own slot after three million steps, so the read
/// happens when the program runs.
Int slowly(this Int) mut {
	waited Int = spin(Int(3000000));
	return @operators$add(@operators$add(this, waited), @operators$negate(Int(3000000)));
}

String repeated(word String, times Int) {
	out String("");
	i Int(1);
	i!to(times) {
		out = @operators$concat(out, word);
	}
	return out;
}

Unit main() {
	say(String("first\n"));
	check(@operators$equal(loud(Int(21)), Int(42)));
	say(String("between\n"));
	check(@operators$equal(spin(Int(3000000)), Int(3000000)));
	check(@operators$equal(down(Int(5000)), Int(5000)));
	say(String("after\n"));

	// A store made inside an expression that folds is still made, for the
	// read that happens when the program runs.
	x Int(5);
	check(@operators$equal(double(x!bumped(Int(1))), Int(12)));
	check(@operators$equal(x!slowly(), Int(6)));

	// A value only the running program has, and code left to run that
	// changes a local: what it wrote is not known after it, neither to the
	// rest of the expression nor to the code after a condition.
	one Int = @operators$add(spin(Int(3000000)), @operators$negate(Int(2999999)));
	y Int(5);
	check(@operators$equal(@operators$add(y!bumped(one), y), Int(12)));
	z Int(5);
	if(@operators$equal(z!bumped(one), Int(0))) {
	}
	check(@operators$equal(z, Int(6)));

	// A count that folds stores what it wrote, for the slot the running
	// program reads.
	w Int(5);
	@controlflow$repeat(w!bumped(Int(1)), {
	});
	check(@operators$equal(w!bumped(one), Int(7)));

	// Seventy thousand bytes: past the size cap.
	long String = repeated(String("0123456789"), Int(7000));
	check(@operators$equal(long, repeated(String("0123456789"), Int(7000))));

	// The pool resized, and a count it refuses, replayed as they were made.
	@program$runtime!setThreads(Int(2)) ? u {
		resolve Unit();
	}
	refused Int(0);
	@program$runtime!setThreads(Int(0)) ? u {
		refused = Int(1);
		resolve Unit();
	}
	check(@operators$equal(refused, Int(1)));
	return Unit();
}
