/// A foreign verb that takes a function value, which lowering refuses until
/// function values cross into C (docs/design/ffi.md F11).
package foreignFunction;

alias Unit = @primitives$Unit;
alias F64 = @primitives$F64;

F64 apply(f F64[F64], x F64) foreign "apply";

/// A lambda-variable declared at package scope.
half F64(x F64) {
	return @operators$divide(x, F64(2.0));
}

Unit main() {
	y F64 = apply(half, F64(3.0));
	return Unit();
}
