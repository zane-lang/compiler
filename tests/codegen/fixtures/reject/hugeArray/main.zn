/// An array of 2^32 `I64`s takes 32 GiB, more than the main context's range
/// of frames holds, so lowering refuses its type where it is named rather
/// than leaving the program to stop when it runs.
package hugeArray;

alias Int = @primitives$I64;
alias Unit = @primitives$Unit;
alias Array<T Type, n @concepts$Int> = @primitives$Array<T, n>;

Array<Int, 4294967296> make() => make();

Unit main() {
	big Array<Int, 4294967296> = make();
	return Unit();
}
