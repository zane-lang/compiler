/// `byteSet` reads each of its 256 flags as one byte, so lowering takes
/// only an array of one-byte flags: an `I64` is eight.
package byteSetFlags;

alias I64 = @primitives$I64;
alias String = @primitives$String;
alias Unit = @primitives$Unit;

Unit main() {
	flags @primitives$ArrayRef<I64, 256> = @primitives$ArrayRef.fill(256, I64(i I64) => i);
	set @primitives$ByteSet = flags:byteSet();
	@program$console!print(String(@primitives$I64(1)));
	return Unit();
}
