/// `@primitives$sort` sorts integers only, so lowering takes no list of
/// floats.
package sortFloats;

alias F64 = @primitives$F64;
alias String = @primitives$String;
alias Unit = @primitives$Unit;

Unit main() {
	values @primitives$List<F64> = @primitives$List(F64);
	values!push(F64(2.5));
	values!sort();
	return Unit();
}
