/// An array of 2^60 `I64`s takes 2^63 bytes, which would wrap to 0 in the
/// arithmetic of its size, and past the 2^48 bytes any value is limited to,
/// so lowering refuses its type where it is named.
package beyondLimit;

alias Int = @primitives$I64
alias Unit = @primitives$Unit
alias Array<T Type, n @concepts$Int> = @primitives$Array<T, n>

Array<Int, 1152921504606846976> make() => make()

Unit main() {
	big Array<Int, 1152921504606846976> = make();
	return Unit();
}
