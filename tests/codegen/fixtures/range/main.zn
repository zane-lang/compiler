/// An index outside a list stops the program with a failing status, after
/// what it wrote so far (docs/design/lowering.md §9).
package range;

alias Int = @primitives$I64
alias String = @primitives$String

@primitives$Unit main() {
	before String.escaped("before\n");
	after String.escaped("after\n");
	numbers @primitives$ListRef<Int> = @primitives$ListRef(Int);
	numbers!push(Int(1));
	@program$console!print(before);
	missing Int = numbers[Int(2)];
	@program$console!print(after);
	return @primitives$Unit();
}
