/// A `main` that returns a `String` that owns its block, which the runtime's
/// entry discards (docs/design/lowering.md L16), in a package with a constant
/// nothing reads.
package entryStringConstant;

alias Int = @primitives$I64
alias Unit = @primitives$Unit
alias String = @primitives$String

unused Int(1)

String main() {
	done String("main returns a string\n");
	@program$console!print(done);
	return @operators$concat(String("owned "), String("text"));
}
