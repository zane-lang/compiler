/// A `main` that returns a `#struct` that owns a list, which the runtime's
/// entry discards (docs/design/lowering.md L16).
package entryStruct;

alias Int = @primitives$I64
alias Unit = @primitives$Unit
alias String = @primitives$String

alias List<T Type> = @primitives$List<T>

type Bag = #struct {
	items List<Int>;
	name String;
}

Bag(items ^List<Int>, name String) => init{ items; name; }

^Bag main() {
	done String("main returns a struct\n");
	@program$console!print(done);
	items ^List<Int> = @primitives$List(Int);
	items!push(Int(1));
	items!push(Int(2));
	return Bag(items, @operators$concat(String("a "), String("bag")));
}
