/// What the memory-semantics probes (tests/memory-probes/,
/// docs/memory-semantics-findings.md) found broken, kept running: a
/// reference stored as an element is read (memory.md §2.2), and a recursive
/// value far deeper than the C stack allows recursion is built, copied,
/// overwritten and destroyed (memory.md §2.3), and a fixed array of 512 KiB,
/// more parts than LLVM moves as one value, is built and moved. An element
/// store, and a `!` call on an element, whose value grows the list find the
/// element only once the list has moved (memory.md §2.12). Each check prints `yes` when it
/// holds and `no` when it does not.
package probed;

alias Int = @primitives$I64
alias Bool = @primitives$Bool
alias Unit = @primitives$Unit
alias String = @primitives$String
alias ListRef<T Type> = @primitives$ListRef<T>

Bool if(condition Bool, body @concepts$Block) {
	@controlflow$branch(condition, body);
	return condition;
}

Unit say(text String) {
	@program$console!print(text);
	return Unit();
}

Unit check(label String, ok Bool) {
	say(label);
	@controlflow$branch(ok, { say(String.escaped(" yes\n")); });
	@controlflow$branch(@operators$not(ok), { say(String.escaped(" no\n")); });
	return Unit();
}

type Port = #struct { n Int; }
Port(n Int) => init{ n; }

/// A constructor's own `@concepts$Array` parameter names the mode its
/// elements are passed in, as the `ArrayRef` constructors do.
type Roster<T Type, n @concepts$Int> = #struct { items @primitives$ArrayRef<T, n>; }
Roster<T, n>(xs @concepts$Array<^T Type, n @concepts$Int>) => init{ items = @primitives$ArrayRef.roaming(xs); }

type Pinned<T Type, n @concepts$Int> = #struct { items @primitives$ArrayRef<&T, n>; }
Pinned<T, n>(xs @concepts$Array<&T Type, n @concepts$Int>) => init{ items = @primitives$ArrayRef.refs(xs); }

Unit references() {
	p Port(Int(1));
	q Port(Int(2));
	row @primitives$ArrayRef<&Port, 2> = @primitives$ArrayRef.refs([p, q]);
	x &Port = row[Int(1)];
	check(String("an `&` element is read"), @operators$equal(x.n, Int(1)));
	check(String("through it"), @operators$equal(row[Int(2)].n, Int(2)));
	row[Int(1)] = q;
	check(String("a copied reference keeps its owner"), @operators$equal(x.n, Int(1)));
	check(String("the element names its new owner"), @operators$equal(row[Int(1)].n, Int(2)));
	r &Port = q;
	mixed @primitives$ArrayRef<&Port, 2> = @primitives$ArrayRef.refs([p, r]);
	check(String("one literal mints and copies"), @operators$equal(@operators$add(mixed[Int(1)].n, mixed[Int(2)].n), Int(3)));
	swapped @primitives$ArrayRef<&Port, 2> = @primitives$ArrayRef.refs([r, p]);
	check(String("in either order"), @operators$equal(swapped[Int(1)].n, Int(2)));
	roster Roster([Port(Int(3)), Port(Int(4))]);
	check(String("a `^T` element takes each owner"), @operators$equal(roster.items[Int(2)].n, Int(4)));
	pinned Pinned([p, r]);
	check(String("an `&T` element mints and copies"), @operators$equal(pinned.items[Int(2)].n, Int(2)));
	return Unit();
}

type Count = variant { done Int; more Count; }

Count make(n Int) {
	if(@operators$equal(n, Int(0))) {
		return Count.done(Int(0));
	}
	return Count.more(make(@operators$add(n, @operators$negate(Int(1)))));
}

Int depth(c Count) => match (c) { n done => n; m more => @operators$add(depth(m), Int(1)); }

Unit deep() {
	a Count = make(Int(30000));
	check(String("a value 30,000 boxes deep"), @operators$equal(depth(a), Int(30000)));
	b Count = a;
	check(String("its copy"), @operators$equal(depth(b), Int(30000)));
	b = Count.done(Int(1));
	check(String("the copy overwritten"), @operators$equal(depth(b), Int(1)));
	a = make(Int(29999));
	check(String("the value overwritten in place"), @operators$equal(depth(a), Int(29999)));
	return Unit();
}

Unit large() {
	a @primitives$ArrayRef<Int, 65536> = @primitives$ArrayRef.fill(65536, Int(i Int) => i);
	check(String("a 512 KiB array"), @operators$equal(a[Int(65536)], Int(65536)));
	return Unit();
}

Unit to(this Int, end Int, body @concepts$Block) mut {
	@controlflow$repeat(@operators$add(@operators$add(end, @operators$negate(this)), Int(1)), {
		@controlflow$branch(true, body);
		this = @operators$add(this, Int(1));
	});
	return Unit();
}

Int growAndGive(this ListRef<Int>, n Int) mut {
	i Int(1);
	i!to(n) { this!push(i); }
	return Int(4242);
}

Unit bump(this Int, by Int) mut {
	this = @operators$add(this, by);
	return Unit();
}

Unit order() {
	ints ListRef<Int> = @primitives$ListRef(Int);
	ints!push(Int(1));
	ints!push(Int(2));
	pad ListRef<Int> = @primitives$ListRef(Int);
	pad!push(Int(0));
	ints[Int(1)] = ints!growAndGive(Int(1000));
	check(String("a store whose value grows the list"), @operators$equal(ints[Int(1)], Int(4242)));
	ints[Int(2)]!bump(ints!growAndGive(Int(1000)));
	check(String("a `!` call whose argument grows the list"), @operators$equal(ints[Int(2)], Int(4244)));
	more ListRef<Int> = @primitives$ListRef(Int);
	more!push(Int(3));
	bumper Unit(this Int, by Int) mut {
		this = @operators$add(this, by);
		return Unit();
	}
	more[Int(1)]!bumper(more!growAndGive(Int(1000)));
	check(String("the same through a function value"), @operators$equal(more[Int(1)], Int(4245)));
	return Unit();
}

Unit main() {
	references();
	deep();
	large();
	order();
	return Unit();
}
