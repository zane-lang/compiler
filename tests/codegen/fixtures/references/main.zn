/// References written out with `&` (memory.md §2.6): minted from a settled
/// owner, copied from a reference, passed, and observing the owner when it
/// is overwritten in place. A generic `&T Type` parameter, stored in a
/// generic mould's `&T` field. An `&T` abort type handing a reference to the
/// handler. `@program$console` passed where a reference is wanted. A field
/// constructor given an `&T` entry out of order. Each check prints
/// `yes` when it holds and `no` when it does not.
package references;

alias Int = @primitives$I64
alias Bool = @primitives$Bool
alias Unit = @primitives$Unit
alias String = @primitives$String

Unit check(ok Bool) {
	yes String("yes\n");
	no String("no\n");
	@controlflow$branch(ok, { @program$console!print(yes); });
	@controlflow$branch(@operators$not(ok), { @program$console!print(no); });
	return Unit();
}

type Person = #struct {
	age Int;
}

Person(age Int) => init{ age; }

Int age(p &Person) => p.age

type Pin<T Type> = #struct {
	at &T;
}

Pin<T>(at &T Type) => init{ at; }

Int ageOf(at &T Type, p Person) => p.age

type Wrap = #struct {
	child Person;
}

Wrap(child ^Person) => init{ child; }

Int?&Person refuse(w &Wrap) {
	abort w.child;
}

Unit pass(c &@runtime$Console) {
	return Unit();
}

/// Its entries given out of order, so each is stored before the call.
type Link = #struct {
	tag Int;
	to &Person;
}

Link{ tag Int; to &Person; } => init{ tag; to; }

Unit main() {
	a Person(Int(3));
	g &Person = a;
	check(@operators$equal(@operators$add(age(a), g.age), Int(6)));
	h &Person = g;
	a = Person(Int(4));
	check(@operators$equal(h.age, Int(4)));
	pin Pin(a);
	a = Person(Int(5));
	check(@operators$equal(pin.at.age, Int(5)));
	check(@operators$equal(ageOf(a, a), Int(5)));
	w Wrap(Person(Int(9)));
	n Int = refuse(w) ? e {
		resolve e.age;
	}
	check(@operators$equal(n, Int(9)));
	link Link{ to = a; tag = Int(1); }
	a = Person(Int(6));
	check(@operators$equal(link.to.age, Int(6)));
	pass(@program$console);
	pass(@program$console);
	return Unit();
}
