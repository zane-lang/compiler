/// Strings: `@primitives$String`, a value type whose handle owns its bytes
/// (memory.md §3.6, types.md §2.7). Joined, compared and printed; copied
/// deep, held in an owner and read through a reference to it, overwritten,
/// carried in a payload, returned, discarded and aborted with. The runtime stops the program if a block outlives its
/// owner, and a block returned twice fails under the C library, so a run that
/// ends cleanly returned each block once. Each check prints `yes` when it
/// holds and `no` when it does not.
package texts;

alias Int = @primitives$I64
alias Bool = @primitives$Bool
alias Unit = @primitives$Unit
alias String = @primitives$String

/// Advances the counter through the inclusive range, running the block once
/// per step.
Unit to(this Int, end Int, body @concepts$Block) mut {
	@controlflow$repeat(@operators$add(@operators$add(end, @operators$negate(this)), Int(1)), {
		@controlflow$branch(true, body);
		this = @operators$add(this, Int(1));
	});
	return Unit();
}

type Person = #struct {
	name String;
}

Person(name String) => init{ name; }

String greeting(this Person) => @operators$concat(String("hello, "), this.name)

Unit rename(this Person, name String) mut {
	this.name = name;
	return Unit();
}

type Tagged = #variant {
	named String;
	anonymous Unit;
}

type Holder = #variant {
	some Person;
	none Unit;
}

String twice(text String) => @operators$concat(text, text)

String?String refuse(text String) {
	abort @operators$concat(text, String("!"));
}

Unit check(ok Bool) {
	yes String("yes\n");
	no String("no\n");
	@controlflow$branch(ok, {
		@program$console!print(yes);
	});
	@controlflow$branch(@operators$not(ok), {
		@program$console!print(no);
	});
	return Unit();
}

Unit main() {
	// Joined, compared and printed.
	a String("ab");
	b String = @operators$concat(a, String("cd\n"));
	@program$console!print(b);
	check(@operators$equal(@operators$concat(a, String("cd\n")), b));
	check(@operators$not(@operators$equal(a, b)));
	check(@operators$equal(twice(a), String("abab")));

	// A copy owns bytes of its own, so overwriting the original leaves it
	// as it was.
	c String = b;
	check(@operators$equal(c, String("abcd\n")));
	b = String("again");
	check(@operators$equal(b, String("again")));
	check(@operators$equal(c, String("abcd\n")));

	// An owner holding a string, read through a reference, and its string
	// replaced; a copy of the field keeps the old bytes.
	p Person(String("ada"));
	g &Person = p;
	check(@operators$equal(g:greeting(), String("hello, ada")));
	old String = p.name;
	p.name = @operators$concat(a, String("!"));
	check(@operators$equal(g:greeting(), String("hello, ab!")));
	check(@operators$equal(old, String("ada")));

	// A payload read through a binder, and a payload owner that dies with
	// its case.
	t Tagged = Tagged.named(String("abcd?"));
	check(match (t) {
		k named => @operators$equal(k, String("abcd?"));
		z anonymous => false;
	});
	t = Tagged.anonymous(Unit());
	kept ^Person = Person(String("held"));
	kept!rename(@operators$concat(a, String("?")));
	holder Holder = Holder.some(kept);
	check(match (holder) {
		h some => @operators$equal(h:greeting(), String("hello, ab?"));
		z none => false;
	});
	holder = Holder.none(Unit());

	// A result nobody keeps, and a string aborted with.
	twice(a);
	check(@operators$equal(refuse(String("no")) ? e { resolve e; }, String("no!")));

	// Many strings made and replaced: each pass returns what it replaced,
	// and what it made itself.
	s String("");
	i Int(1);
	i!to(Int(10000)) {
		made String = @operators$concat(a, String("y"));
		s = @operators$concat(made, String("z"));
	}
	check(@operators$equal(s, String("abyz")));
	return Unit();
}
