/// Reference types: `#struct` and `#variant` instances owned in their
/// scope's arena. A roaming owner (`^T`) moves by `let`, `return`, `abort`
/// and a `^T` parameter, and settles where it lands; a bare parameter
/// borrows; and `mut` methods write through the subject. A taken owner the
/// body does not move on dies with the body. Every way out of a block drains
/// its arena: falling off the end, `return`, `abort`, a `resolve`, and an
/// exit. The runtime stops the program if a scope is drained out of order or
/// left open. Each check prints `yes` when it holds and `no` when it does
/// not.
package owners;

alias Int = @primitives$I64
alias Bool = @primitives$Bool
alias Unit = @primitives$Unit
alias String = @primitives$String

/// Runs the block when the condition holds, and reports whether it did.
Bool if(condition Bool, body @concepts$Block) {
	@controlflow$branch(condition, body);
	return condition;
}

/// Advances the counter through the inclusive range, running the block once
/// per step.
Unit to(this Int, end Int, body @concepts$Block) mut {
	@controlflow$repeat(@operators$add(@operators$add(end, @operators$negate(this)), Int(1)), {
		@controlflow$branch(true, body);
		this = @operators$add(this, Int(1));
	});
	return Unit();
}

/// Ends its caller's invocation when the condition holds.
Unit guard(condition Bool) {
	@controlflow$branch(condition, { @controlflow$exitFromCall(); });
	return Unit();
}

type Account = #struct {
	owner Int;
	balance Int;
}

Account(owner Int) => init{ owner; balance = Int(0); }

Unit deposit(this Account, amount Int) mut {
	this.balance = @operators$add(this.balance, amount);
	return Unit();
}

Int funds(this Account) => this.balance

/// Moves the roaming local it built out through its return.
^Account opened(owner Int, amount Int) {
	a ^Account = Account(owner);
	a!deposit(amount);
	return a;
}

/// Borrows its argument.
Int balanceOf(account Account) => account.balance

/// Takes its argument, which dies with the body.
Int closed(account ^Account) => account.balance

/// Takes its argument and hands it back: a parameter is read-only, so it
/// moves into a local first.
^Account relayed(account ^Account) {
	kept ^Account = account;
	kept!deposit(Int(1));
	return kept;
}

type Slot = #variant {
	empty Unit;
	held Account;
}

/// Returns from inside a block that holds a local.
Int richest(limit Int) {
	i Int(1);
	i!to(limit) {
		a Account = opened(i, @operators$multiply(i, Int(10)));
		if(@operators$lessThan(Int(30), a.balance)) {
			return a.owner;
		}
	}
	return Int(0);
}

/// Aborts from inside a block that holds a local.
Int?Int overdrawn(amount Int) {
	a Account = opened(Int(9), Int(5));
	if(@operators$lessThan(a.balance, amount)) {
		b Account = opened(Int(8), amount);
		abort b.balance;
	}
	return a.balance;
}

/// Aborts with a roaming owner, which the handler's binder holds.
Int?^Account refused(owner Int) {
	if(@operators$equal(owner, Int(0))) {
		abort opened(Int(7), Int(70));
	}
	return owner;
}

type Choice = variant {
	pick Int;
	skip Unit;
}

/// A `match` arm aborts from inside its own block, and the `match`'s handler
/// holds the abort value there.
Int chosen(c Choice) => match (c) {
	n pick {
		a ^Account = opened(n, n);
		if(@operators$equal(a.balance, Int(0))) {
			abort a;
		}
		return a.balance;
	}
	s skip {
		abort Account(Int(6));
	}
} ? e {
	resolve @operators$multiply(e.owner, Int(100));
}

/// Sums balances, skipping one pass with `guard` after holding a local.
Int total(skipped Int) {
	sum Int(0);
	i Int(1);
	i!to(Int(5)) {
		a Account = opened(i, i);
		guard(@operators$equal(i, skipped));
		sum = @operators$add(sum, a.balance);
	}
	return sum;
}

Unit check(ok Bool) {
	yes String("yes\n");
	no String("no\n");
	@controlflow$branch(ok, {
		@program$console!print(yes);
	});
	@controlflow$branch(@operators$not(ok), {
		@program$console!print(no);
	});
	return Unit();
}

Unit main() {
	// A roaming owner, written through a `mut` method and read through
	// another.
	a ^Account = opened(Int(1), Int(5));
	a!deposit(Int(10));
	check(@operators$equal(a:funds(), Int(15)));

	// A move that settles, a refilled roaming owner, a borrow, a take, and a
	// relay.
	b Account = a;
	check(@operators$equal(b.balance, Int(15)));
	a = Account(Int(2));
	check(@operators$equal(a.owner, Int(2)));
	check(@operators$equal(balanceOf(b), Int(15)));
	check(@operators$equal(balanceOf(a), Int(0)));
	check(@operators$equal(closed(a), Int(0)));
	c ^Account = opened(Int(3), Int(7));
	c = relayed(c);
	check(@operators$equal(c.balance, Int(8)));
	check(@operators$equal(closed(Account(Int(4))), Int(0)));

	// A variant holding a struct.
	s Slot = Slot.held(Account(Int(3)));
	check(match (s) {
		e empty => false;
		h held => @operators$equal(h.owner, Int(3));
	});

	// Each way out of a hosting block.
	check(@operators$equal(richest(Int(9)), Int(4)));
	check(@operators$equal(overdrawn(Int(1)) ?? Int(0), Int(5)));
	check(@operators$equal(overdrawn(Int(7)) ? e { resolve @operators$add(e, Int(1)); }, Int(8)));
	check(@operators$equal(total(Int(3)), Int(12)));
	check(@operators$equal(refused(Int(0)) ? e { resolve e.balance; }, Int(70)));
	check(@operators$equal(refused(Int(4)) ? e { resolve e.balance; }, Int(4)));
	check(@operators$equal(chosen(Choice.pick(Int(5))), Int(5)));
	check(@operators$equal(chosen(Choice.pick(Int(0))), Int(0)));
	check(@operators$equal(chosen(Choice.skip(Unit())), Int(600)));

	// A hundred thousand passes, each holding two owners and draining them,
	// and each taking one into a call that drops it.
	count Int(0);
	i Int(1);
	i!to(Int(100000)) {
		e ^Account = opened(i, Int(1));
		d Account = e;
		count = @operators$add(count, d.balance);
		count = @operators$add(count, closed(opened(i, Int(0))));
	}
	check(@operators$equal(count, Int(100000)));
	return Unit();
}
