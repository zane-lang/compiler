/// A type passed to a constructor as an applied type or a reference
/// (generics.md §5.3). A generic bag makes an empty list of a compound element
/// over its own parameter, `@primitives$ListRef(Pair<T>)`, and is pushed to
/// and read back at `Int`; the same list is made over a concrete applied
/// type; and a constructor takes a reference type and an applied type over
/// one, and one over a number parameter written nowhere else. A verb type is
/// passed the same way: a generic list of callbacks over its own parameter,
/// `@primitives$ListRef(T[T])`, run in order. Each check prints `yes` when it
/// holds.
package typeValues;

alias Int = @primitives$I64;
alias Bool = @primitives$Bool;
alias Unit = @primitives$Unit;
alias String = @primitives$String;
alias ListRef<T Type> = @primitives$ListRef<T>;

type Pair<T Type> = #struct { a T; b T; }
Pair<T>(a T Type, b T) => init{ a; b; }

type Port = #struct { n Int; }

/// Records only how many of its type it was built for.
type Tally<T Type> = #struct { count Int; }
Tally<T>(T Type, count Int) => init{ count; }

type Bag<T Type> = #struct { items ListRef<Pair<T>>; }
Bag<T>(T Type) => init{ items = @primitives$ListRef(Pair<T>); }

Unit add(this Bag<T Type>, a T, b T) mut {
	this.items!push(Pair(a, b));
	return Unit();
}

/// Callbacks run in the order they were added, each on what the last returned.
type Hooks<T Type> = #struct { items ListRef<T[T]>; }
Hooks<T>(T Type) => init{ items = @primitives$ListRef(T[T]); }

T run(this Hooks<T Type>, value T) {
	out T = value;
	i Int(1);
	@controlflow$repeat(this.items:size(), {
		out = this.items[i](out);
		i = @operators$add(i, Int(1));
	});
	return out;
}

/// `n` is written only inside the type passed, which makes it a number
/// parameter all the same.
Unit sized(n @concepts$Int) {
	made Tally(@primitives$Array<Int, n>, Int(7));
	check(@operators$equal(made.count, Int(7)));
	return Unit();
}

Unit check(ok Bool) {
	yes String.escaped("yes\n");
	no String.escaped("no\n");
	@controlflow$branch(ok, { @program$console!print(yes); });
	@controlflow$branch(@operators$not(ok), { @program$console!print(no); });
	return Unit();
}

Unit main() {
	// The empty list made in generic code, at `Int`.
	bag Bag(Int);
	bag!add(Int(1), Int(2));
	bag!add(Int(3), Int(4));
	check(@operators$equal(bag.items:size(), Int(2)));
	check(@operators$equal(bag.items[Int(2)].b, Int(4)));
	// The same list over a concrete applied type.
	pairs ListRef<Pair<Int>> = @primitives$ListRef(Pair<Int>);
	pairs!push(Pair(Int(5), Int(6)));
	check(@operators$equal(pairs[Int(1)].a, Int(5)));
	// A reference type, and an applied type over one.
	ports Tally(&Port, Int(2));
	check(@operators$equal(ports.count, Int(2)));
	pairsOfPorts Tally(Pair<&Port>, Int(3));
	check(@operators$equal(pairsOfPorts.count, Int(3)));
	// A number parameter written only inside a passed type.
	sized(4);
	// A verb type: the callbacks made in generic code, at `Int`, and the same
	// list over a concrete one.
	twice Int(x Int) { return @operators$multiply(x, Int(2)); }
	more Int(x Int) { return @operators$add(x, Int(1)); }
	hooks Hooks(Int);
	hooks.items!push(twice);
	hooks.items!push(more);
	check(@operators$equal(hooks:run(Int(5)), Int(11)));
	plain ListRef<Int[Int]> = @primitives$ListRef(Int[Int]);
	plain!push(more);
	check(@operators$equal(plain[Int(1)](Int(1)), Int(2)));
	return Unit();
}
