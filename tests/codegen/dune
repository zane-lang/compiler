; Stages 4 and 6: lowering and codegen (docs/design/lowering.md). README.md
; says what each fixture is for. The LLVM module's own text is not a golden
; file, since it is LLVM's to print and changes with the LLVM release.

; The rules themselves are written from the golden files by
; tests/gen/gen_rules.ml, into dune.inc. A fixture added without its rules
; fails the diff below; `dune promote` then writes them.

; Every program here runs with its drains checked: a block still out in a
; region when its scope drains stops the program (runtime/zane_internal.h).
(env
 (_
  (env-vars
   (ZANE_CHECK 1))))

(include dune.inc)

(rule
 (deps (glob_files golden/*) (source_tree fixtures))
 (action
  (with-stdout-to
   dune.inc.gen
   (run %{exe:../gen/gen_rules.exe} codegen))))

(rule
 (alias runtest)
 (action
  (diff dune.inc dune.inc.gen)))
