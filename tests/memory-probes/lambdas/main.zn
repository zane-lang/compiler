/// A reference laundered through a function value. A lambda stores its `&T`
/// parameter into its subject, but a call through a function value records
/// no resting place (docs/design/semantics.md §10), so a call from an inner
/// block that hands it an inner owner is accepted (lifetimes.md §1.11 says
/// ILLEGAL). The program then reads and writes through the dangling
/// reference: each check prints NO where a sound program would print yes.
package lambdas;
alias Int = @primitives$Int
alias Bool = @primitives$Bool
alias Unit = @primitives$Unit
alias String = @primitives$String
alias List<T Type> = @primitives$List<T>

Bool if(condition Bool, body @concepts$Block) {
	@controlflow$branch(condition, body);
	return condition;
}

Unit to(this Int, end Int, body @concepts$Block) mut {
	@controlflow$repeat(end + ~this + Int(1), {
		@controlflow$branch(true, body);
		this = this + Int(1);
	});
	return Unit();
}

Unit say(text String) {
	@program$console!print(text);
	return Unit();
}

/// Prints the label and `yes` when the condition holds, `no` when not.
Unit check(label String, ok Bool) {
	say(label);
	@controlflow$branch(ok, { say(String(" yes\n")); });
	@controlflow$branch(~ok, { say(String(" NO\n")); });
	return Unit();
}

alias Block = @concepts$Block
Unit inner(body Block) {
	@controlflow$branch(true, body);
	return Unit();
}

type Port = #struct { n Int; }
Port(n Int) => init{ n; }

Unit set(this Port, n Int) mut {
	this.n = n;
	return Unit();
}

type Plug = #struct { port &Port; }
Plug(port &Port) => init{ port; }

Unit apply(this Plug, f Unit[this Plug, &Port] mut, port &Port) mut {
	this!f(port);
	return Unit();
}

Unit main() {
	far Port(Int(1));
	plug Plug(far);
	wire Unit(this Plug, port &Port) mut {
		this.port = port;
		return Unit();
	}
	inner({
		near Port(Int(2));
		plug!wire(near);                // ILLEGAL: near's block ends before plug's
	});
	inner({
		victim Port(Int(100));
		plug.port!set(Int(999));        // writes into victim's slot
		check(String("victim untouched (lambda-variable)"), victim.n == Int(100));
	});
	inner({
		near Port(Int(3));
		plug!apply(wire, near);         // ILLEGAL: the same, through a function parameter
	});
	inner({
		victim Port(Int(100));
		plug.port!set(Int(999));
		check(String("victim untouched (function parameter)"), victim.n == Int(100));
	});

	// A value carrying a reference, pushed by a lambda into an outer list.
	plugs List<Plug> = @primitives$List(Plug);
	keep Unit(this List<Plug>, p ^Plug) mut {
		this!push(p);
		return Unit();
	}
	inner({
		near Port(Int(4));
		arriving ^Plug = Plug(near);
		plugs!keep(arriving);           // ILLEGAL: arriving carries a reference to near
	});
	inner({
		victim Port(Int(100));
		plugs[Int(1)].port!set(Int(999));
		check(String("victim untouched (carried, pushed)"), victim.n == Int(100));
	});

	return Unit();
}
