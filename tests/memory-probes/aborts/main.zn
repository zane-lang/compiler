/// Owners that travel through aborts and handlers (lifetimes.md §1.7,
/// error-handling.md §3): an abort value moved out of its handler, a result
/// moved through `??`, ignored abortable results, and a refill from a handler.
package aborts;
alias Int = @primitives$I64
alias Bool = @primitives$Bool
alias Unit = @primitives$Unit
alias String = @primitives$String
alias List<T Type> = @primitives$List<T>

Bool if(condition Bool, body @concepts$Block) {
	@controlflow$branch(condition, body);
	return condition;
}

Unit to(this Int, end Int, body @concepts$Block) mut {
	@controlflow$repeat(@operators$add(@operators$add(end, @operators$negate(this)), Int(1)), {
		@controlflow$branch(true, body);
		this = @operators$add(this, Int(1));
	});
	return Unit();
}

Unit say(text String) {
	@program$console!print(text);
	return Unit();
}

/// Prints the label and `yes` when the condition holds, `no` when not.
Unit check(label String, ok Bool) {
	say(label);
	@controlflow$branch(ok, { say(String(" yes\n")); });
	@controlflow$branch(@operators$not(ok), { say(String(" NO\n")); });
	return Unit();
}
type Engine = #struct { power Int; label String; }
Engine(power Int, label String) => init{ power; label; }

^Engine?^Engine pick(n Int) {
	made ^Engine = Engine(n, @operators$concat(String("made-"), String("here")));
	if(@operators$equal(n, Int(1))) {
		abort Engine(Int(100), @operators$concat(String("abort-"), String("value")));
	}
	return made;
}

^Engine?Unit maybe(n Int) {
	if(@operators$equal(n, Int(1))) {
		abort Unit();
	}
	return Engine(n, String("ok"));
}

Unit main() {
	a ^Engine = pick(Int(1)) ? e {
		resolve e;
	}
	check(String("abort value moved out of the handler"), @operators$and(@operators$equal(a.power, Int(100)), @operators$equal(a.label, String("abort-value"))));
	b ^Engine = pick(Int(2)) ?? Engine(Int(0), String("fallback"));
	check(String("result moved through ??"), @operators$equal(b.label, String("made-here")));
	c Engine = maybe(Int(1)) ?? Engine(Int(5), String("fb"));
	check(String("fallback settled"), @operators$equal(c.power, Int(5)));
	r &Engine = c;
	pick(Int(1)) ?? Engine(Int(0), String("dropped"));
	maybe(Int(2)) ?? Engine(Int(0), String("dropped"));
	check(String("ignored abortable results"), @operators$equal(r.power, Int(5)));
	i Int(1);
	i!to(Int(100000)) {
		x ^Engine = pick(Int(1)) ? e { resolve e; }
		y Engine = x;
	}
	check(String("loop of aborted owners"), true);
	b = pick(Int(1)) ? e { resolve e; }
	check(String("refill an owning symbol from a handler"), @operators$equal(b.power, Int(100)));
	return Unit();
}
