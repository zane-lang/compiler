/// A match binder is its case's payload (adt.md §5: it "behaves as that
/// case's payload", and the scrutinee "stays in scope"). An arm that
/// overwrites the scrutinee destroys that payload while the binder still
/// names it; `churn` then reuses the freed blocks.
package binders;
alias Int = @primitives$Int
alias Bool = @primitives$Bool
alias Unit = @primitives$Unit
alias String = @primitives$String
alias List<T Type> = @primitives$List<T>

Bool if(condition Bool, body @concepts$Block) {
	@controlflow$branch(condition, body);
	return condition;
}

Unit to(this Int, end Int, body @concepts$Block) mut {
	@controlflow$repeat(end + ~this + Int(1), {
		@controlflow$branch(true, body);
		this = this + Int(1);
	});
	return Unit();
}

Unit say(text String) {
	@program$console!print(text);
	return Unit();
}

/// Prints the label and `yes` when the condition holds, `no` when not.
Unit check(label String, ok Bool) {
	say(label);
	@controlflow$branch(ok, { say(String(" yes\n")); });
	@controlflow$branch(~ok, { say(String(" NO\n")); });
	return Unit();
}
type Engine = #struct { power Int; label String; }
Engine(power Int, label String) => init{ power; label; }
type Slot = #variant { full Engine; empty Unit; }
type VSlot = variant { full String; empty Unit; }

Unit clear(this Slot) mut {
	this = Slot.empty(Unit());
	return Unit();
}

Unit churn() {
	j Int(1);
	j!to(Int(200)) {
		s Slot = Slot.full(Engine(Int(999), String("junk") + String("junk")));
		t String = String("junkjunkjunk") + String("junkjunkjunk");
	}
	return Unit();
}

Unit main() {
	slot Slot = Slot.full(Engine(Int(42), String("orig") + String("inal")));
	n Int = match (slot) {
		e full {
			slot = Slot.empty(Unit());  // ILLEGAL (adt.md §5.1)
			churn();
			return e.power;
		}
		u empty => Int(0);
	}
	check(String("binder after its scrutinee is overwritten (reference)"), n == Int(42));

	v VSlot = VSlot.full(String("orig") + String("inal"));
	m String = match (v) {
		s full {
			v = VSlot.empty(Unit());  // ILLEGAL (adt.md §5.1)
			churn();
			return s;
		}
		u empty => String("");
	}
	check(String("binder after its scrutinee is overwritten (value)"), m == String("original"));

	slot2 Slot = Slot.full(Engine(Int(42), String("orig") + String("inal")));
	k Int = match (slot2) {
		e full {
			slot2!clear();  // ILLEGAL (adt.md §5.1)
			churn();
			return e.power;
		}
		u empty => Int(0);
	}
	check(String("binder after a mut call on its scrutinee"), k == Int(42));
	return Unit();
}
