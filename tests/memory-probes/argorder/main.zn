/// A borrow argument followed, in the same call, by an argument that `!`-calls
/// the container the borrow points into: the variant changes case, the list
/// relocates its block, and the callee then reads freed storage.
package argorder;
alias Int = @primitives$I64
alias Bool = @primitives$Bool
alias Unit = @primitives$Unit
alias String = @primitives$String
alias List<T Type> = @primitives$List<T>

Bool if(condition Bool, body @concepts$Block) {
	@controlflow$branch(condition, body);
	return condition;
}

Unit to(this Int, end Int, body @concepts$Block) mut {
	@controlflow$repeat(@operators$add(@operators$add(end, @operators$negate(this)), Int(1)), {
		@controlflow$branch(true, body);
		this = @operators$add(this, Int(1));
	});
	return Unit();
}

Unit say(text String) {
	@program$console!print(text);
	return Unit();
}

/// Prints the label and `yes` when the condition holds, `no` when not.
Unit check(label String, ok Bool) {
	say(label);
	@controlflow$branch(ok, { say(String(" yes\n")); });
	@controlflow$branch(@operators$not(ok), { say(String(" NO\n")); });
	return Unit();
}
type Engine = #struct { power Int; label String; }
Engine(power Int, label String) => init{ power; label; }
type Slot = #variant { full Engine; empty Unit; }
Int clearAndGive(this Slot) mut {
	this = Slot.empty(Unit());
	return Int(0);
}
Int growAndGive(this List<Engine>, n Int) mut {
	i Int(1);
	i!to(n) { this!push(Engine(i, String("fill"))); }
	return Int(0);
}
Unit churn() {
	j Int(1);
	j!to(Int(200)) {
		s Slot = Slot.full(Engine(Int(999), @operators$concat(String("junk"), String("junk"))));
		l List<Engine> = @primitives$List(Engine);
		l!push(Engine(Int(999), String("junk")));
	}
	return Unit();
}
Int readLater(e Engine, x Int) {
	churn();
	return @operators$add(e.power, x);
}
Unit main() {
	slot Slot = Slot.full(Engine(Int(42), @operators$concat(String("orig"), String("inal"))));
	a Int = readLater(slot.full ?? Engine(Int(0), String("none")), slot!clearAndGive());  // ILLEGAL (memory.md §2.9.1)
	check(String("borrowed payload freed by a later argument"), @operators$equal(a, Int(42)));
	list List<Engine> = @primitives$List(Engine);
	list!push(Engine(Int(42), String("x")));
	pad List<Engine> = @primitives$List(Engine);
	pad!push(Engine(Int(0), String("p")));
	b Int = readLater(list[Int(1)], list!growAndGive(Int(1000)));  // ILLEGAL (memory.md §2.9.1)
	check(String("borrowed element moved by a later argument"), @operators$equal(b, Int(42)));
	return Unit();
}
