/// Values in lists (memory.md §2.3): an element copied out, an element
/// copied over another, an element overwritten from itself, and each copy
/// independent of its source afterwards.
package valuelists;
alias Int = @primitives$Int
alias Bool = @primitives$Bool
alias Unit = @primitives$Unit
alias String = @primitives$String
alias List<T Type> = @primitives$List<T>

Bool if(condition Bool, body @concepts$Block) {
	@controlflow$branch(condition, body);
	return condition;
}

Unit to(this Int, end Int, body @concepts$Block) mut {
	@controlflow$repeat(end + ~this + Int(1), {
		@controlflow$branch(true, body);
		this = this + Int(1);
	});
	return Unit();
}

Unit say(text String) {
	@program$console!print(text);
	return Unit();
}

/// Prints the label and `yes` when the condition holds, `no` when not.
Unit check(label String, ok Bool) {
	say(label);
	@controlflow$branch(ok, { say(String(" yes\n")); });
	@controlflow$branch(~ok, { say(String(" NO\n")); });
	return Unit();
}

type Pair = struct { a String; b String; }
Pair(a String, b String) => init{ a; b; }
type Count = variant { done String; more Count; }
Int depth(c Count) => match (c) {
	s done => Int(0);
	m more => depth(m) + Int(1);
}

Unit main() {
	pairs List<Pair> = @primitives$List(Pair);
	pairs!push(Pair(String("a1"), String("b1")));
	pairs!push(Pair(String("a2"), String("b2")));
	out Pair = pairs[Int(1)];
	pairs[Int(1)].a = String("changed");
	check(String("element copied out is independent"), out.a == String("a1"));
	pairs[Int(1)] = pairs[Int(2)];
	pairs[Int(2)].b = String("changed");
	check(String("element copied over another is independent"), pairs[Int(1)].b == String("b2"));
	pairs[Int(1)].a = pairs[Int(1)].a + pairs[Int(1)].a;
	check(String("element field overwritten from itself"), pairs[Int(1)].a == String("a2a2"));
	pairs[Int(2)] = Pair(pairs[Int(2)].b, pairs[Int(2)].a);
	check(String("element overwritten from its own fields"), (pairs[Int(2)].a == String("changed")) * (pairs[Int(2)].b == String("a2")));

	counts List<Count> = @primitives$List(Count);
	counts!push(Count.more(Count.more(Count.done(String("x")))));
	counts!push(counts[Int(1)]);  // ILLEGAL (memory.md §2.9.1)
	counts[Int(2)] = Count.more(counts[Int(2)]);
	check(String("recursive element copied and grown"), (depth(counts[Int(1)]) == Int(2)) * (depth(counts[Int(2)]) == Int(3)));
	i Int(1);
	i!to(Int(2000)) {
		counts!push(counts[i]);  // ILLEGAL (memory.md §2.9.1)
	}
	check(String("list grown from its own elements"), depth(counts[Int(2001)]) == Int(2));
	return Unit();
}
