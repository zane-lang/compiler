/// The water tower (lifetimes.md §2.2, concurrency.md §4.1): a block whose
/// spawned work still reads its owners drains only after that work ends, so
/// the owners outlive every read.
package watertower;
alias Int = @primitives$I64
alias Bool = @primitives$Bool
alias Unit = @primitives$Unit
alias String = @primitives$String
alias List<T Type> = @primitives$List<T>

Bool if(condition Bool, body @concepts$Block) {
	@controlflow$branch(condition, body);
	return condition;
}

Unit to(this Int, end Int, body @concepts$Block) mut {
	@controlflow$repeat(@operators$add(@operators$add(end, @operators$negate(this)), Int(1)), {
		@controlflow$branch(true, body);
		this = @operators$add(this, Int(1));
	});
	return Unit();
}

Unit say(text String) {
	@program$console!print(text);
	return Unit();
}

/// Prints the label and `yes` when the condition holds, `no` when not.
Unit check(label String, ok Bool) {
	say(label);
	@controlflow$branch(ok, { say(String(" yes\n")); });
	@controlflow$branch(@operators$not(ok), { say(String(" NO\n")); });
	return Unit();
}
alias Block = @concepts$Block
Unit inner(body Block) {
	@controlflow$branch(true, body);
	return Unit();
}
type Port = #struct { n Int; label String; }
Port(n Int, label String) => init{ n; label; }
/// Reads the port many times, adding what it sees, and reports whether
/// every read saw it intact.
Unit report(port &Port, times Int, expect Int) {
	total Int(0);
	i Int(1);
	i!to(times) {
		if(@operators$equal(port.label, @operators$concat(String("still"), String(" here")))) {
			total = @operators$add(total, port.n);
		}
	}
	check(String("a spawned reader saw its port"), @operators$equal(total, expect));
	return Unit();
}

Unit main() {
	k Int(1);
	k!to(Int(5)) {
		inner({
			near Port(Int(1), @operators$concat(String("still"), String(" here")));
			other Port(Int(2), @operators$concat(String("still"), String(" here")));
			spawn report(near, Int(200000), Int(200000));
			spawn report(other, Int(200000), Int(400000));
		});
		// The next pass reuses the slots; a read after the drain would see a
		// different port.
	}
	return Unit();
}
