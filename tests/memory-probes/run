#!/usr/bin/env bash
# Runs every memory-semantics probe program: each directory here is one
# package, or a build of several. It is type-checked; if it checks, it is built and run. What the
# compiler and the program printed goes to NAME.out beside the directory, so
# a change in behaviour shows as a diff. A program is built unoptimized and
# optimized, and the second's output is shown too when it differs.
#
# With --check, the committed NAME.out files are left alone: each probe's
# output is written aside and held to its NAME.out, and any difference fails
# the run. So does a probe whose build failed, or whose optimized build
# differs, unless its directory holds an EXPECTED file whose first line names
# that outcome, `== build failed` or `== the optimized build differs`, and
# whose remaining lines say why it is expected. The file
# only permits the outcome; what the probe printed must still match NAME.out.
# `just test-compiler` runs this. Usage: run [--check] [NAME...]
set -u
check=
[ "${1:-}" = --check ] && { check=1; shift; }
here=$(cd "$(dirname "$0")" && pwd)
root=$(cd "$here/../.." && pwd)
zanec="$root/_build/default/bin/zanec/zanec.exe"
[ -x "$zanec" ] || { echo "build zanec first: dune build bin/zanec/zanec.exe" >&2; exit 1; }
cd "$here"
# Nix's C compiler wrapper (devbox) defines _FORTIFY_SOURCE, which warns at
# -O0 on every unoptimized build; the warning is the environment's, not a
# probe's, so it is kept out of NAME.out.
[ -n "${NIX_HARDENING_ENABLE:-}" ] &&
	export NIX_HARDENING_ENABLE=$(tr ' ' '\n' <<<"$NIX_HARDENING_ENABLE" | grep -v '^fortify' | tr '\n' ' ')
names=("$@")
[ ${#names[@]} -eq 0 ] && names=($(ls -d */ | tr -d /))
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
# Whether probe $1's directory permits outcome $2: its EXPECTED file
# names it on the first line and says why below.
expected() {
	[ -f "$1/EXPECTED" ] && [ "$(head -n 1 "$1/EXPECTED")" = "$2" ] &&
		tail -n +2 "$1/EXPECTED" | grep -q '[^[:space:]]'
}
failed=0
for n in "${names[@]}"; do
	# A directory of directories is a build of several packages, the first
	# in name order being the root.
	pkgs=()
	for d in "$n"/*/; do [ -d "$d" ] && pkgs+=(--package "${d%/}"); done
	[ ${#pkgs[@]} -eq 0 ] && pkgs=(--package "$n")
	out="$n.out"
	[ -n "$check" ] && out="$tmp/$n.out"
	{
		if "$zanec" --check "${pkgs[@]}" 2>&1; then
			echo "== checks; building and running"
			if "$zanec" --build "$tmp/$n.exe" "${pkgs[@]}" 2>&1 &&
				"$zanec" --build "$tmp/$n.opt.exe" --optimize "${pkgs[@]}" 2>&1; then
				"$tmp/$n.exe" > "$tmp/$n.plain" 2>&1; plain=$?
				"$tmp/$n.opt.exe" > "$tmp/$n.opt" 2>&1; opt=$?
				cat "$tmp/$n.plain"
				if ! cmp -s "$tmp/$n.plain" "$tmp/$n.opt" || [ $plain != $opt ]; then
					echo "== the optimized build differs (exit $opt):"
					cat "$tmp/$n.opt"
				fi
				echo "== exit $plain"
			else
				echo "== build failed"
			fi
		else
			echo "== rejected"
		fi
	} > "$out"
	if [ -z "$check" ]; then
		echo "$n: $(tail -1 "$out")"
		continue
	fi
	problems=()
	for outcome in "== build failed" "== the optimized build differs"; do
		line=$(grep -m 1 -- "^$outcome" "$out") || continue
		expected "$n" "$outcome" || problems+=("$line, and $n/EXPECTED does not permit it")
	done
	if [ ! -f "$n.out" ]; then
		problems+=("no committed $n.out")
	elif ! cmp -s "$n.out" "$out"; then
		problems+=("output differs from the committed $n.out:")
	fi
	if [ ${#problems[@]} -eq 0 ]; then
		echo "ok   $n"
	else
		failed=1
		for problem in "${problems[@]}"; do echo "FAIL $n: $problem"; done
		[ -f "$n.out" ] && diff "$n.out" "$out" | head -40
	fi
done
exit $failed
