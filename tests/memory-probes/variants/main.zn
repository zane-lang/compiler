/// Reference variants and `ArrayRef` at run time (memory.md §2.2, §2.8,
/// §2.8.1, lifetimes.md §2.1): a payload is roaming and never referenced,
/// a reference to the variant itself observes a case change, a binder is the
/// payload's place, and an `ArrayRef`'s elements are settled under a settled
/// root and overwritten in place.
package variants;
alias Int = @primitives$I64
alias Bool = @primitives$Bool
alias Unit = @primitives$Unit
alias String = @primitives$String
alias List<T Type> = @primitives$List<T>

Bool if(condition Bool, body @concepts$Block) {
	@controlflow$branch(condition, body);
	return condition;
}

Unit to(this Int, end Int, body @concepts$Block) mut {
	@controlflow$repeat(@operators$add(@operators$add(end, @operators$negate(this)), Int(1)), {
		@controlflow$branch(true, body);
		this = @operators$add(this, Int(1));
	});
	return Unit();
}

Unit say(text String) {
	@program$console!print(text);
	return Unit();
}

/// Prints the label and `yes` when the condition holds, `no` when not.
Unit check(label String, ok Bool) {
	say(label);
	@controlflow$branch(ok, { say(String(" yes\n")); });
	@controlflow$branch(@operators$not(ok), { say(String(" NO\n")); });
	return Unit();
}

type Engine = #struct { power Int; label String; }
Engine(power Int, label String) => init{ power; label; }

Unit tune(this Engine) mut {
	this.power = @operators$add(this.power, Int(1));
	return Unit();
}

type Slot = #variant { full Engine; empty Unit; pair Twin; }
type Twin = #struct { a Engine; b Engine; }
Twin(a ^Engine, b ^Engine) => init{ a; b; }

Int power(s &Slot) => match (s) {
	e full => e.power;
	u empty => Int(0);
	t pair => @operators$add(t.a.power, t.b.power);
}

^Slot fill(n Int) => Slot.full(Engine(n, String("filled")))

alias Block = @concepts$Block
Unit inner(body Block) {
	@controlflow$branch(true, body);
	return Unit();
}
type Shed = #struct { row @primitives$ArrayRef<Engine, 2>; }
Shed(row ^@primitives$ArrayRef<Engine, 2>) => init{ row; }
Unit churn() {
	j Int(1);
	j!to(Int(200)) {
		l List<Engine> = @primitives$List(Engine);
		l!push(Engine(Int(999), @operators$concat(String("junk"), String("junk"))));
	}
	return Unit();
}
Unit main() {
	slot Slot = Slot.full(Engine(Int(1), String("one")));
	view &Slot = slot;
	check(String("payload read through a reference"), @operators$equal(power(view), Int(1)));
	slot = Slot.pair(Twin(Engine(Int(2), String("a")), Engine(Int(3), String("b"))));
	check(String("case change seen through the reference"), @operators$equal(power(view), Int(5)));
	slot = Slot.empty(Unit());
	check(String("changed to empty"), @operators$equal(power(view), Int(0)));
	slot = fill(Int(7));
	check(String("refilled from a result"), @operators$equal(power(view), Int(7)));

	// A binder is the payload's place: a write through it stays.
	n Int = match (slot) {
		e full {
			e!tune();
			return e.power;
		}
		u empty => Int(0);
		t pair => Int(0);
	}
	check(String("binder writes the payload"), @operators$and(@operators$equal(n, Int(8)), @operators$equal(power(view), Int(8))));

	// Case changes in a loop destroy each payload.
	i Int(1);
	i!to(Int(100000)) {
		slot = Slot.pair(Twin(Engine(i, @operators$concat(String("x"), String("y"))), Engine(i, String("z"))));
		slot = Slot.full(Engine(i, @operators$concat(String("w"), String("v"))));
	}
	check(String("loop of case changes"), @operators$equal(power(view), Int(100000)));

	// ArrayRef elements: settled under a settled root.
	row @primitives$ArrayRef<Engine, 3> = @primitives$ArrayRef([Engine(Int(1), String("a")), Engine(Int(2), String("b")), Engine(Int(3), String("c"))]);
	second &Engine = row[Int(2)];
	row[Int(2)] = Engine(Int(20), String("bb"));
	check(String("ArrayRef element overwrite seen"), @operators$equal(second.power, Int(20)));
	second!tune();
	check(String("write through element reference"), @operators$equal(row[Int(2)].power, Int(21)));
	row = @primitives$ArrayRef([Engine(Int(4), String("d")), Engine(Int(5), String("e")), Engine(Int(6), String("f"))]);
	check(String("whole ArrayRef overwrite seen"), @operators$and(@operators$equal(second.power, Int(5)), @operators$equal(second.label, String("e"))));

	// Replaced from an inner block, whose blocks then drain.
	row2 @primitives$ArrayRef<Engine, 2> = @primitives$ArrayRef([Engine(Int(1), String("a")), Engine(Int(2), String("b"))]);
	second2 &Engine = row2[Int(2)];
	inner({
		row2 = @primitives$ArrayRef([Engine(Int(3), @operators$concat(String("c"), String("c"))), Engine(Int(4), @operators$concat(String("d"), String("d")))]);
	});
	churn();
	check(String("element ref after the ArrayRef is replaced from an inner block"), @operators$and(@operators$equal(second2.power, Int(4)), @operators$equal(second2.label, String("dd"))));
	shed Shed(@primitives$ArrayRef([Engine(Int(1), String("a")), Engine(Int(2), String("b"))]));
	s &Engine = shed.row[Int(1)];
	inner({
		shed = Shed(@primitives$ArrayRef([Engine(Int(5), @operators$concat(String("e"), String("e"))), Engine(Int(6), String("f"))]));
	});
	churn();
	check(String("element ref after its owner is replaced from an inner block"), @operators$and(@operators$equal(s.power, Int(5)), @operators$equal(s.label, String("ee"))));
	return Unit();
}
