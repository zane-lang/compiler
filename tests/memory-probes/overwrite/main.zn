/// Settled overwrites are made in place (memory.md §2.2, §3.6): a reference
/// to the owner, to a field of it, or to a member below a boxed member keeps
/// naming the slot and observes the replacement.
package overwrite;

alias Int = @primitives$I64
alias Bool = @primitives$Bool
alias Unit = @primitives$Unit
alias String = @primitives$String
alias List<T Type> = @primitives$List<T>

Bool if(condition Bool, body @concepts$Block) {
	@controlflow$branch(condition, body);
	return condition;
}

Unit to(this Int, end Int, body @concepts$Block) mut {
	@controlflow$repeat(@operators$add(@operators$add(end, @operators$negate(this)), Int(1)), {
		@controlflow$branch(true, body);
		this = @operators$add(this, Int(1));
	});
	return Unit();
}

Unit say(text String) {
	@program$console!print(text);
	return Unit();
}

/// Prints the label and `yes` when the condition holds, `no` when not.
Unit check(label String, ok Bool) {
	say(label);
	@controlflow$branch(ok, { say(String(" yes\n")); });
	@controlflow$branch(@operators$not(ok), { say(String(" NO\n")); });
	return Unit();
}

type Engine = #struct { power Int; }
Engine(power Int) => init{ power; }

type Car = #struct { engine Engine; name String; }
Car(engine ^Engine, name String) => init{ engine; name; }

/// A reference type that boxes itself: `next` is on a cycle.
type Chain = #variant { end Engine; link Link; }
type Link = #struct { head Engine; next Chain; }
Link(head ^Engine, next ^Chain) => init{ head; next; }

type Holder = #struct { link Link; }
Holder(link ^Link) => init{ link; }

Int powerOf(e &Engine) => e.power

Unit main() {
	car Car(Engine(Int(1)), String("a"));
	whole &Car = car;
	part &Engine = car.engine;
	car.engine = Engine(Int(2));
	check(String("field overwrite seen through field ref"), @operators$equal(part.power, Int(2)));
	car = Car(Engine(Int(3)), String("b"));
	check(String("whole overwrite seen through field ref"), @operators$equal(part.power, Int(3)));
	check(String("whole overwrite seen through whole ref"), @operators$equal(whole.engine.power, Int(3)));
	check(String("string field replaced"), @operators$equal(whole.name, String("b")));

	// A moved-in replacement, not a fresh one.
	incoming ^Car = Car(Engine(Int(4)), String("c"));
	car = incoming;
	check(String("moved-in replacement seen"), @operators$equal(part.power, Int(4)));
	incoming = Car(Engine(Int(5)), String("d"));
	check(String("refilled source is independent"), @operators$equal(part.power, Int(4)));

	// A boxed member under a settled root keeps its block.
	holder Holder(Link(Engine(Int(10)), Chain.link(Link(Engine(Int(11)), Chain.end(Engine(Int(12)))))));
	h &Engine = holder.link.head;
	check(String("ref into settled struct field"), @operators$equal(h.power, Int(10)));
	holder.link = Link(Engine(Int(20)), Chain.end(Engine(Int(21))));
	check(String("ref observes overwrite of enclosing field"), @operators$equal(h.power, Int(20)));
	holder = Holder(Link(Engine(Int(30)), Chain.end(Engine(Int(31)))));
	check(String("ref observes overwrite of root"), @operators$equal(powerOf(h), Int(30)));

	// Overwrite in a loop: each old occupant is destroyed, the slot stays.
	i Int(1);
	i!to(Int(100000)) {
		car = Car(Engine(i), String("loop"));
	}
	check(String("loop overwrite ends at last"), @operators$equal(part.power, Int(100000)));
	return Unit();
}
