/// Spawned calls and the store rule (lifetimes.md §1.1, §1.11, §2.2,
/// concurrency.md §4.1): a spawned call's result and resting places are
/// checked as a plain call's are. ILLEGAL marks what the spec rejects.
package spawnstore;
alias Int = @primitives$I64
alias Bool = @primitives$Bool
alias Unit = @primitives$Unit
alias String = @primitives$String
alias List<T Type> = @primitives$List<T>

Bool if(condition Bool, body @concepts$Block) {
	@controlflow$branch(condition, body);
	return condition;
}

Unit to(this Int, end Int, body @concepts$Block) mut {
	@controlflow$repeat(@operators$add(@operators$add(end, @operators$negate(this)), Int(1)), {
		@controlflow$branch(true, body);
		this = @operators$add(this, Int(1));
	});
	return Unit();
}

Unit say(text String) {
	@program$console!print(text);
	return Unit();
}

/// Prints the label and `yes` when the condition holds, `no` when not.
Unit check(label String, ok Bool) {
	say(label);
	@controlflow$branch(ok, { say(String(" yes\n")); });
	@controlflow$branch(@operators$not(ok), { say(String(" NO\n")); });
	return Unit();
}
alias Block = @concepts$Block
Unit inner(body Block) {
	@controlflow$branch(true, body);
	return Unit();
}
type Port = #struct { n Int; }
Port(n Int) => init{ n; }
type Plug = #struct { port &Port; }
Plug(port &Port) => init{ port; }
Unit wire(this Plug, port &Port) mut {
	this.port = port;
	return Unit();
}
&Port pass(port &Port) => port
^Plug plugInto(port &Port) => Plug(port)

Unit main() {
	far Port(Int(1));
	r &Port = far;
	plug Plug(far);
	plugs List<Plug> = @primitives$List(Plug);
	inner({
		near Port(Int(2));
		r = spawn pass(near);           // ILLEGAL: the result names near
		spawn plug!wire(near);          // ILLEGAL: resting place
		p ^Plug = spawn plugInto(near);
		plugs!push(p);                  // ILLEGAL: p carries a reference to near
		ok &Port = spawn pass(far);     // legal
	});
	return Unit();
}
