/// A `!` call whose subject is a list element and whose argument grows the
/// list: the subject's address is taken before the argument relocates the
/// list's block, so the method writes into the freed block.
package subjectorder;
alias Int = @primitives$Int
alias Bool = @primitives$Bool
alias Unit = @primitives$Unit
alias String = @primitives$String
alias List<T Type> = @primitives$List<T>

Bool if(condition Bool, body @concepts$Block) {
	@controlflow$branch(condition, body);
	return condition;
}

Unit to(this Int, end Int, body @concepts$Block) mut {
	@controlflow$repeat(end + ~this + Int(1), {
		@controlflow$branch(true, body);
		this = this + Int(1);
	});
	return Unit();
}

Unit say(text String) {
	@program$console!print(text);
	return Unit();
}

/// Prints the label and `yes` when the condition holds, `no` when not.
Unit check(label String, ok Bool) {
	say(label);
	@controlflow$branch(ok, { say(String(" yes\n")); });
	@controlflow$branch(~ok, { say(String(" NO\n")); });
	return Unit();
}
type Engine = #struct { power Int; label String; }
Engine(power Int, label String) => init{ power; label; }
Unit setTo(this Engine, n Int) mut {
	this.power = n;
	return Unit();
}
Int growAndGive(this List<Engine>, n Int) mut {
	i Int(1);
	i!to(n) { this!push(Engine(i, String("fill"))); }
	return Int(4242);
}
Unit main() {
	engines List<Engine> = @primitives$List(Engine);
	engines!push(Engine(Int(1), String("e")));
	pad List<Engine> = @primitives$List(Engine);
	pad!push(Engine(Int(0), String("p")));
	engines[Int(1)]!setTo(engines!growAndGive(Int(1000)));
	check(String("element subject whose argument grows the list"), engines[Int(1)].power == Int(4242));
	return Unit();
}
