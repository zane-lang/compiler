/// Blocks larger than 1 MiB (memory.md §3.1, §3.6): a list grown past it,
/// a string doubled past it, both copied or moved out of the scope that
/// made them, and a list of strings whose growth relocates owned blocks.
package oversized;
alias Int = @primitives$Int
alias Bool = @primitives$Bool
alias Unit = @primitives$Unit
alias String = @primitives$String
alias List<T Type> = @primitives$List<T>

Bool if(condition Bool, body @concepts$Block) {
	@controlflow$branch(condition, body);
	return condition;
}

Unit to(this Int, end Int, body @concepts$Block) mut {
	@controlflow$repeat(end + ~this + Int(1), {
		@controlflow$branch(true, body);
		this = this + Int(1);
	});
	return Unit();
}

Unit say(text String) {
	@program$console!print(text);
	return Unit();
}

/// Prints the label and `yes` when the condition holds, `no` when not.
Unit check(label String, ok Bool) {
	say(label);
	@controlflow$branch(ok, { say(String(" yes\n")); });
	@controlflow$branch(~ok, { say(String(" NO\n")); });
	return Unit();
}
alias Block = @concepts$Block
Unit inner(body Block) {
	@controlflow$branch(true, body);
	return Unit();
}

type Bag = #struct { items List<Int>; }
Bag() => init{ items = @primitives$List(Int); }

^Bag filled(n Int) {
	bag ^Bag = Bag();
	i Int(1);
	i!to(n) {
		bag.items!push(i);
	}
	return bag;
}

String doubled(times Int) {
	s String("0123456789abcdef");
	i Int(1);
	i!to(times) {
		s = s + s;
	}
	return s;
}

Unit main() {
	// 400,000 Ints is 3.2 MB of elements: an oversized span.
	bag Bag = filled(Int(400000));
	check(String("big list returned"), bag.items:size() == Int(400000));
	check(String("its first and last"), (bag.items[Int(1)] == Int(1)) * (bag.items[Int(400000)] == Int(400000)));

	// 16 bytes doubled 17 times is 2 MiB.
	big String("");
	inner({
		local String = doubled(Int(17));
		big = local;
	});
	copy String = big;
	check(String("big string copied out of an inner block"), copy == big);
	big = big + String("!");
	check(String("copy independent of the source"), ~(copy == big));

	// A list of strings growing: each element's block stays its own.
	words List<String> = @primitives$List(String);
	j Int(1);
	j!to(Int(100000)) {
		words!push(String("w") + String("ord"));
	}
	check(String("list of 100000 strings"), (words:size() == Int(100000)) * (words[Int(77777)] == String("word")));

	// A big list overwritten in place many times.
	k Int(1);
	k!to(Int(20)) {
		bag = filled(Int(200000));
	}
	check(String("big list overwritten 20 times"), bag.items[Int(200000)] == Int(200000));
	return Unit();
}
