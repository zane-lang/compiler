/// Moves at run time (lifetimes.md §1.2-§1.9, memory.md §2.8.1, §3.5): a
/// roaming owner moved through locals, taken and relayed by verbs, a field
/// moved out of a roaming root and refilled, ignored `^T` results, and owners
/// pushed into and overwritten in a list.
package moves;

alias Int = @primitives$Int
alias Bool = @primitives$Bool
alias Unit = @primitives$Unit
alias String = @primitives$String
alias List<T Type> = @primitives$List<T>

Bool if(condition Bool, body @concepts$Block) {
	@controlflow$branch(condition, body);
	return condition;
}

Unit to(this Int, end Int, body @concepts$Block) mut {
	@controlflow$repeat(end + ~this + Int(1), {
		@controlflow$branch(true, body);
		this = this + Int(1);
	});
	return Unit();
}

Unit say(text String) {
	@program$console!print(text);
	return Unit();
}

/// Prints the label and `yes` when the condition holds, `no` when not.
Unit check(label String, ok Bool) {
	say(label);
	@controlflow$branch(ok, { say(String(" yes\n")); });
	@controlflow$branch(~ok, { say(String(" NO\n")); });
	return Unit();
}

type Engine = #struct { power Int; label String; }
Engine(power Int, label String) => init{ power; label; }

type Car = #struct { engine Engine; }
Car(engine ^Engine) => init{ engine; }

^Engine make(power Int) {
	e ^Engine = Engine(power, String("made"));
	return e;
}

^Engine relay(e ^Engine) {
	kept ^Engine = e;
	return kept;
}

^Engine boost(e ^Engine) {
	kept ^Engine = e;
	kept.power = kept.power + Int(100);
	return kept;
}

Unit consume(e ^Engine) => Unit()

Int powerOf(e Engine) => e.power

type Garage = #struct { cars List<Car>; }
Garage() => init{ cars = @primitives$List(Car); }

Unit park(this Garage, car ^Car) mut {
	this.cars!push(car);
	return Unit();
}

Unit main() {
	a ^Engine = Engine(Int(1), String("a"));
	b ^Engine = a;
	c ^Engine = b;
	check(String("moved twice"), c.power == Int(1));
	a = Engine(Int(2), String("a2"));
	check(String("refilled after move"), a.power == Int(2));

	d ^Engine = relay(c);
	check(String("relayed back"), d.power == Int(1));
	c = boost(d);
	check(String("relayed and written"), c.power == Int(101));
	check(String("label travelled"), c.label == String("a"));

	// A field moved out of a roaming root, and refilled.
	car ^Car = Car(make(Int(7)));
	out Engine = car.engine;
	check(String("field moved out"), out.power == Int(7));
	car.engine = Engine(Int(8), String("refill"));
	whole Car = car;
	check(String("refilled root moves whole"), whole.engine.power == Int(8));

	// Ignored `^T` results are destroyed at the statement (§1.9).
	i Int(1);
	i!to(Int(100000)) {
		make(i);
		relay(make(i));
	}
	consume(make(Int(3)));
	check(String("ignored results"), true);

	// Owners into a list, overwritten there, and the list growing.
	garage Garage();
	j Int(1);
	j!to(Int(1000)) {
		incoming ^Car = Car(make(j));
		garage!park(incoming);
	}
	check(String("list holds 1000"), garage.cars:size() == Int(1000));
	check(String("element 500"), garage.cars[Int(500)].engine.power == Int(500));
	garage.cars[Int(500)] = Car(make(Int(0)));
	check(String("element overwritten"), garage.cars[Int(500)].engine.power == Int(0));
	check(String("neighbour intact"), powerOf(garage.cars[Int(501)].engine) == Int(501));
	r &Garage = garage;
	check(String("ref to the list's owner sees size"), r.cars:size() == Int(1000));
	return Unit();
}
