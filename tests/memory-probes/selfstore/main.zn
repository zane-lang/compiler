/// Stores whose source overlaps their destination, for reference types:
/// a roaming owner moved into itself, a field of a roaming root moved into
/// itself, a settled owner overwritten with a value built from its own
/// contents (memory.md §2.2, §2.3, §3.5), and an object wired to its own
/// parts after it settles (§2.8.1).
package selfstore;
alias Int = @primitives$I64
alias Bool = @primitives$Bool
alias Unit = @primitives$Unit
alias String = @primitives$String
alias List<T Type> = @primitives$List<T>

Bool if(condition Bool, body @concepts$Block) {
	@controlflow$branch(condition, body);
	return condition;
}

Unit to(this Int, end Int, body @concepts$Block) mut {
	@controlflow$repeat(@operators$add(@operators$add(end, @operators$negate(this)), Int(1)), {
		@controlflow$branch(true, body);
		this = @operators$add(this, Int(1));
	});
	return Unit();
}

Unit say(text String) {
	@program$console!print(text);
	return Unit();
}

/// Prints the label and `yes` when the condition holds, `no` when not.
Unit check(label String, ok Bool) {
	say(label);
	@controlflow$branch(ok, { say(String(" yes\n")); });
	@controlflow$branch(@operators$not(ok), { say(String(" NO\n")); });
	return Unit();
}

type Engine = #struct { power Int; label String; }
Engine(power Int, label String) => init{ power; label; }

type Car = #struct { engine Engine; name String; }
Car(engine ^Engine, name String) => init{ engine; name; }

type Mount = #struct { at &Engine; }
Mount(at &Engine) => init{ at; }

Unit attach(this Mount, at &Engine) mut {
	this.at = at;
	return Unit();
}

type Kit = #struct { engine Engine; spare Engine; mount Mount; }
Kit(engine ^Engine, spare ^Engine, mount ^Mount) => init{ engine; spare; mount; }

/// Builds a fresh car from what a borrowed one holds.
^Car rebuilt(car Car) => Car(Engine(@operators$add(car.engine.power, Int(1)), @operators$concat(car.engine.label, String("+"))), @operators$concat(car.name, String("+")))

^Car relay(car ^Car) {
	kept ^Car = car;
	return kept;
}

Unit main() {
	r ^Car = Car(Engine(Int(1), String("e")), String("r"));
	r = r;
	check(String("r = r keeps the car"), @operators$equal(r.engine.power, Int(1)));
	check(String("r = r keeps its string"), @operators$equal(r.name, String("r")));
	r = relay(r);
	check(String("r = relay(r)"), @operators$equal(r.engine.label, String("e")));
	r.engine = r.engine;
	check(String("r.engine = r.engine"), @operators$equal(r.engine.label, String("e")));

	settled Car(Engine(Int(5), String("s")), String("c"));
	view &Engine = settled.engine;
	settled = rebuilt(settled);
	check(String("settled = rebuilt(settled)"), @operators$equal(view.power, Int(6)));
	check(String("its strings"), @operators$and(@operators$equal(view.label, String("s+")), @operators$equal(settled.name, String("c+"))));
	settled.engine = Engine(@operators$multiply(settled.engine.power, Int(10)), @operators$concat(settled.engine.label, settled.name));
	check(String("field rebuilt from itself"), @operators$equal(view.power, Int(60)));
	check(String("its string"), @operators$equal(view.label, String("s+c+")));

	far Engine(Int(0), String("far"));
	kit Kit(Engine(Int(1), String("one")), Engine(Int(2), String("two")), Mount(far));
	kit.mount!attach(kit.engine);
	check(String("wired to its own part"), @operators$equal(kit.mount.at.power, Int(1)));
	kit.engine = Engine(Int(10), String("ten"));
	check(String("its part overwritten"), @operators$equal(kit.mount.at.label, String("ten")));
	kit.mount!attach(kit.spare);
	kit = Kit(Engine(Int(20), String("a")), Engine(Int(30), String("b")), Mount(kit.engine));
	check(String("whole kit overwritten; new mount names the slot"), @operators$equal(kit.mount.at.power, Int(20)));
	return Unit();
}
