; The ambiguity engine: the OCaml half of tools/ambiguity/, which the Python
; front end beside it runs as a subprocess.
;
; [Automaton] prepares what is being searched, [Stack_pool] and [Recognizer]
; own the exact GLR side, [Search] the bounded concrete witness hunt, and
; [Output]/[Config] the caller-facing edges. [Run] is one invocation,
; dispatching to [Classes], the recognizer and [Concretize]; the executable is
; only its entry point.
(library
 (name ambiguity_engine)
 (modules :standard \ ambiguity_search)
 (libraries unix str))

(executable
 (name ambiguity_search)
 (modules ambiguity_search)
 (libraries ambiguity_engine))
