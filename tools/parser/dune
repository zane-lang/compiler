; Parser developer tools. Small executables for looking at what the grammar
; did with a file -- not part of the compiler library, and not ambiguity-engine
; internals.
(executable
 (name parser_shape)
 (modules parser_shape)
 (libraries cst diagnostic))

(executable
 (name parser_accept)
 (modules parser_accept)
 (libraries cst diagnostic))

; Reads a source file and prints every node with the source text its span
; covers. The walk over each stage's nodes lives with that stage --
; `Cst.To_span_text`, `Sst.To_span_text` and `Tst.To_span_text` -- so this is
; a frontend that picks one with `--cst`, `--sst` or `--tst`. test/parser/dune
; diffs its output against checked-in expectations for the first two, and
; test/semantics/dune for the third.
(executable
 (name span_dump)
 (modules span_dump)
 (libraries cst diagnostic sst tst))
