; Codegen: the CGT to an LLVM module, built through LLVM's OCaml bindings
; (docs/design/lowering.md L2), and the module to a binary, linked with the C
; runtime that [Runtime_source] embeds (runtime/dune). [Abi] is written from
; runtime/zane_abi.h, so the offsets and sizes emitted code relies on are the
; runtime's own, and [O2_pipeline] by lib/llvm/config/discover.ml from the
; LLVM it links. LLD is linked in as a library (lld_stubs.cpp), its flags
; found by the same program. A package's C objects are renamed by [Rewrite] and its
; archives written back by LLVM's archive writer (archive_stubs.cpp); a
; dependency's C is made a retained copy by retain_stubs.cpp. The
; target machine puts constructors in `.init_array` (init_array_stubs.cpp).
(library
 (name codegen)
 (foreign_stubs
  (language c)
  (names llvm_stubs))
 (foreign_stubs
  (language cxx)
  (names lld_stubs tier_stubs body_stubs c_stubs retain_stubs prefix_stubs archive_stubs init_array_stubs)
  (flags
   (:standard
    (:include lld_cxx.sexp))))
 (c_library_flags
  (:include lld_libs.sexp))
 (libraries cache cgt diagnostic rewrite runtime_source unix llvm llvm_analysis llvm_irreader llvm_bitreader llvm_linker llvm_target llvm_passbuilder llvm_all_backends))

(rule
 (target abi.ml)
 (deps ../../runtime/zane_abi.h)
 (action
  (with-stdout-to
   %{target}
   (run gen/abi_ml.exe %{deps}))))

(rule
 (target o2_pipeline.ml)
 (deps (env_var LLVM_CONFIG) (env_var PATH))
 (action
  (with-stdout-to
   %{target}
   (run %{exe:../llvm/config/discover.exe} o2-pipeline))))

(rule
 (target lld_cxx.sexp)
 (deps (env_var LLVM_CONFIG) (env_var PATH))
 (action
  (with-stdout-to
   %{target}
   (run %{exe:../llvm/config/discover.exe} cxx %{ocaml-config:ccomp_type}))))

(rule
 (target lld_libs.sexp)
 (deps (env_var LLVM_CONFIG) (env_var PATH))
 (action
  (with-stdout-to
   %{target}
   (run %{exe:../llvm/config/discover.exe} lld-libs %{ocaml-config:ccomp_type}))))
