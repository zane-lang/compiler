; Codegen: the CGT to an LLVM module, built through LLVM's OCaml bindings
; (docs/design/lowering.md L2), and the module to a binary, linked with the C
; runtime that [Runtime_source] embeds (runtime/dune). [Abi] is written from
; runtime/zane_abi.h, so the offsets and sizes emitted code relies on are the
; runtime's own, and [O2_pipeline] by gen/o2_pipeline.sh from the LLVM it
; links. LLD is linked in as a library (lld_stubs.cpp), its flags found by
; gen/lld_flags.sh.
(library
 (name codegen)
 (foreign_stubs
  (language c)
  (names llvm_stubs))
 (foreign_stubs
  (language cxx)
  (names lld_stubs tier_stubs body_stubs)
  (flags
   (:standard
    (:include lld_cxx.sexp))))
 (c_library_flags
  (:include lld_libs.sexp))
 (libraries cgt diagnostic runtime_source unix llvm llvm.analysis llvm.irreader llvm.bitreader llvm.linker llvm.target llvm.passbuilder llvm.all_backends))

(rule
 (target abi.ml)
 (deps ../../runtime/zane_abi.h)
 (action
  (with-stdout-to
   %{target}
   (run gen/abi_ml.exe %{deps}))))

(rule
 (target o2_pipeline.ml)
 (deps gen/o2_pipeline.sh (env_var LLVM_CONFIG) (env_var PATH))
 (action (with-stdout-to %{target} (run sh gen/o2_pipeline.sh))))

(rule
 (target lld_cxx.sexp)
 (deps gen/lld_flags.sh (env_var LLVM_CONFIG) (env_var PATH))
 (action (with-stdout-to %{target} (run sh gen/lld_flags.sh cxx))))

(rule
 (target lld_libs.sexp)
 (deps gen/lld_flags.sh (env_var LLVM_CONFIG) (env_var PATH))
 (action (with-stdout-to %{target} (run sh gen/lld_flags.sh libs))))
