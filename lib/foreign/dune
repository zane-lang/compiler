; The C interface's front half (docs/design/ffi.md §1): a package's
; `c.coda`, the include directories its target's C compiler searches, and
; its C compiled to LLVM bitcode by clang's front end, linked in
; (clang_stubs.cpp), with the modules kept in the cache, and its archives
; and the sources holding assembly read and made as objects
; (object_stubs.cpp). Codegen and
; semantics read what it makes; it reads neither.
(library
 (name foreign)
 (foreign_stubs
  (language cxx)
  (names clang_stubs object_stubs)
  (flags
   (:include clang_cxx.sexp)))
 (c_library_flags
  (:include clang_libs.sexp))
 (libraries c_interface cache coda diagnostic source unix))

(rule
 (target clang_cxx.sexp)
 (deps (env_var LLVM_CONFIG) (env_var PATH))
 (action
  (with-stdout-to
   %{target}
   (run %{exe:../llvm/config/discover.exe} cxx-no-rtti %{ocaml-config:ccomp_type} %{ocaml-config:ocamlc_cflags}))))

(rule
 (targets clang_libs.sexp clang_libs.rsp)
 (deps (env_var LLVM_CONFIG) (env_var PATH))
 (action
  (with-stdout-to
   clang_libs.sexp
   (run %{exe:../llvm/config/discover.exe} clang-libs %{ocaml-config:ccomp_type} %{targets}))))

(rule
 (target builtin_headers.ml)
 (deps (env_var LLVM_CONFIG) (env_var PATH))
 (action
  (with-stdout-to
   %{target}
   (run %{exe:../llvm/config/discover.exe} builtin-headers))))

(rule
 (target zane_ffi_header.ml)
 (deps zane_ffi.h)
 (action
  (with-stdout-to
   %{target}
   (progn
    (echo "let text = {zane_header|")
    (cat zane_ffi.h)
    (echo "|zane_header}\n")))))
