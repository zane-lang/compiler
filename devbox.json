{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.17.2/.schema/devbox.schema.json",
  "packages": [
    "just@latest",
    "meson@latest",
    "clang@latest",
    "cmake@latest",
    "llvm_21@latest",
    "upx@latest",
    "ninja@latest",
    "zig@latest",
    "clang-tools@latest",
    "opam@latest",
    "ocaml@latest",
    "gnumake@latest",
    "pkg-config@latest",
    "m4@latest",
    "zstd@latest"
  ],
  "shell": {
    "init_hook": [
      "echo 'Welcome to devbox!'",
      "eval $(opam env)",
      "export LLVM_CONFIG=$(realpath $DEVBOX_PROJECT_ROOT/.devbox/nix/profile/default/bin/llvm-config)",
      "export LD_LIBRARY_PATH=/nix/store/s7vmxmhkq439cjb7ag9w198p6dk7kl0w-zstd-1.5.7/lib:$LD_LIBRARY_PATH"
    ],
    "scripts": {
      "test": [
        "echo \"Error: no test specified\" && exit 1"
      ]
    }
  }
}
