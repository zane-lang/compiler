main (this Int, a Bool)! Void?String {
	x [this Int]! -> Void = "hello"
	y String = "world"
	content String = read("wordlist.txt") ?? ""
	
	if random() {
		results List = crawl(content) error ? {
			Std$print(error)
			abort error
		}
	}
	else {
		rifle Weapon("rifle", 20)
		value Bool = ~true + 3
	}
}

square (x Int, y Int) Int => x * y
