_build/
__pycache__/
.devbox/
_opam/
.claude/settings.local.json
dev/machine-config.txt

# Ambiguity search and prove runs write their logs here, locally and in the
# workflows (which upload them as artifacts). Run output is not committed; a
# result worth keeping goes into docs/ambiguity/experiments.md.
/reports/

# menhir --explain and --dump write these beside the grammar when it is run
# by hand, which is how conflicts and automaton states are read outside dune.
*.conflicts
*.automaton

# ocamlopt writes these beside the source when a module is compiled
# outside dune, which is how the prover gets built without the full switch.
*.cmi
*.cmx
*.cmo
*.o
*.a
