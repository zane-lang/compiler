/// The model's `chains`: walks of many short linked lists, each of 1 to 15
/// links at random places in one list, linked by 32-bit ids, the heads
/// visited in turn. Arguments: log2 of the data's bytes, how many passes to
/// make (0 builds the data and stops) and log2 of the operations in a pass.
/// It prints `ready` once the data is built and a checksum when the passes
/// end, which time.py beside it times between.
package chains;


alias Int = @primitives$I64;
alias Bool = @primitives$Bool;
alias Unit = @primitives$Unit;
alias String = @primitives$String;
alias ListRef<T Type> = @primitives$ListRef<T>;

/// Advances the counter through the inclusive range, running the block once
/// per step.
Unit to(this Int, end Int, body @concepts$Block) mut {
	@controlflow$repeat(@operators$add(@operators$add(end, @operators$negate(this)), Int(1)), {
		@controlflow$branch(true, body);
		this = @operators$add(this, Int(1));
	});
	return Unit();
}

/// The program's `at`th argument, or `fallback` when it has none or the
/// argument spells no integer.
Int arg(at Int, fallback Int) {
	args @primitives$List<String> = @program$runtime:arguments();
	@controlflow$branch(@operators$lessThan(args:size(), at), {
		return fallback;
	});
	return args[at]:parseI64() ?? fallback;
}

Unit say(text String) {
	@program$console!print(@operators$concat(text, String.escaped("\n")));
	return Unit();
}

Int plus(a Int, b Int) => @operators$add(a, b);
Int minus(a Int, b Int) => @operators$add(a, @operators$negate(b));
Int times(a Int, b Int) => @operators$multiply(a, b);
Int xor(a Int, b Int) => @math$bitXor(a, b);
Int down(a Int, by Int) => @math$shiftRightLogical(a, by);
Bool same(a Int, b Int) => @operators$equal(a, b);

/// xorshift64, as the model's `rnd`.
type Rng = #struct {
	state Int;
}

Rng(seed Int) => init{ state = seed; }

Int next(this Rng) mut {
	s Int = this.state;
	s = xor(s, @math$shiftLeft(s, Int(13)));
	s = xor(s, down(s, Int(7)));
	s = xor(s, @math$shiftLeft(s, Int(17)));
	this.state = s;
	return s;
}


alias I32 = @primitives$I32;

Int over(a Int, b Int) => @operators$divide(a, b);
Bool below(a Int, b Int) => @operators$lessThan(a, b);

/// `r % k` with `r` read as unsigned, as C's `%` on a `uint64_t`, for `k`
/// below 2^62.
Int umod(r Int, k Int) {
	half Int = down(r, Int(1));
	a Int = minus(half, times(over(half, k), k));
	b Int = plus(times(a, Int(2)), @math$bitAnd(r, Int(1)));
	return minus(b, times(over(b, k), k));
}

type Link = struct {
	val Int;
	next I32;
}

Link(val Int, next I32) => init{ val; next; }

/// The sum of the values along the chain from `head`. A loop that calls it
/// writes it out where it calls it (a walk, docs/design/lowering.md L11), so
/// its `return` leaves only the walk, as a loop's `break` would.
Int walk(links ListRef<Link>, head Int) {
	s Int(0);
	c Int = head;
	d Int(1);
	d!to(Int(16)) {
		@controlflow$branch(same(c, Int(0)), {
			return s;
		});
		s = plus(s, links[c].val);
		c = Int(links[c].next);
	}
	return s;
}

Unit main() {
	logBytes Int = arg(Int(1), Int(25));
	passes Int = arg(Int(2), Int(1));
	logOps Int = arg(Int(3), Int(21));
	n Int = minus(@math$shiftLeft(Int(1), minus(logBytes, Int(4))), Int(1));
	m Int = @math$shiftLeft(Int(1), logOps);
	rng Rng = Rng(@operators$negate(Int(7046029254386353131)));
	// The ids 1 to n in an order picked at random, as the model's `churn`
	// at 100% leaves them.
	ids ListRef<Int> = @primitives$ListRef(Int);
	f Int(1);
	f!to(n) {
		ids!push(f);
		rng!next();
	}
	k Int = n;
	g Int(1);
	g!to(minus(n, Int(1))) {
		o Int = plus(umod(rng!next(), k), Int(1));
		t Int = ids[k];
		ids[k] = ids[o];
		ids[o] = t;
		k = minus(k, Int(1));
	}
	links ListRef<Link> = @primitives$ListRef(Link);
	z Int(1);
	z!to(n) {
		links!push(Link(Int(0), I32(0)));
	}
	starts ListRef<Int> = @primitives$ListRef(Int);
	built Int(0);
	w Int(1);
	w!to(n) {
		@controlflow$branch(below(built, n), {
			len Int = plus(umod(rng!next(), Int(15)), Int(1));
			@controlflow$branch(below(n, plus(built, len)), {
				len = minus(n, built);
			});
			starts!push(ids[plus(built, Int(1))]);
			e Int(1);
			e!to(len) {
				id Int = ids[plus(built, e)];
				nextId Int(0);
				@controlflow$branch(below(e, len), {
					nextId = ids[plus(built, plus(e, Int(1)))];
				});
				links[id] = Link(rng!next(), I32.wrap(nextId));
			}
			built = plus(built, len);
		});
	}
	heads ListRef<Int> = @primitives$ListRef(Int);
	count Int = starts:size();
	q Int(1);
	q!to(m) {
		heads!push(starts[plus(umod(minus(q, Int(1)), count), Int(1))]);
	}
	sum Int(0);
	say(String("ready"));
	p Int(1);
	p!to(passes) {
		h Int(1);
		h!to(m) {
			sum = plus(sum, walk(links, heads[h]));
		}
	}
	say(String(sum));
	return Unit();
}
