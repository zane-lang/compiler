/// The model's `tree`: lookups of random keys in a balanced binary search
/// tree whose nodes lie at random places in one list, linked by 32-bit ids.
/// Half the keys are present. Arguments: log2 of the data's bytes, how many
/// passes to make (0 builds the data and stops) and log2 of the operations
/// in a pass. It prints `ready` once the data is built and a checksum when
/// the passes end, which time.py beside it times between.
package tree;


alias Int = @primitives$I64;
alias Bool = @primitives$Bool;
alias Unit = @primitives$Unit;
alias String = @primitives$String;
alias ListRef<T Type> = @primitives$ListRef<T>;

/// Advances the counter through the inclusive range, running the block once
/// per step.
Unit to(this Int, end Int, body @concepts$Block) mut {
	@controlflow$repeat(@operators$add(@operators$add(end, @operators$negate(this)), Int(1)), {
		@controlflow$branch(true, body);
		this = @operators$add(this, Int(1));
	});
	return Unit();
}

/// The program's `at`th argument, or `fallback` when it has none or the
/// argument spells no integer.
Int arg(at Int, fallback Int) {
	args @primitives$List<String> = @program$runtime:arguments();
	@controlflow$branch(@operators$lessThan(args:size(), at), {
		return fallback;
	});
	return args[at]:parseI64() ?? fallback;
}

Unit say(text String) {
	@program$console!print(@operators$concat(text, String.escaped("\n")));
	return Unit();
}

Int plus(a Int, b Int) => @operators$add(a, b);
Int minus(a Int, b Int) => @operators$add(a, @operators$negate(b));
Int times(a Int, b Int) => @operators$multiply(a, b);
Int xor(a Int, b Int) => @math$bitXor(a, b);
Int down(a Int, by Int) => @math$shiftRightLogical(a, by);
Bool same(a Int, b Int) => @operators$equal(a, b);

/// xorshift64, as the model's `rnd`.
type Rng = #struct {
	state Int;
}

Rng(seed Int) => init{ state = seed; }

Int next(this Rng) mut {
	s Int = this.state;
	s = xor(s, @math$shiftLeft(s, Int(13)));
	s = xor(s, down(s, Int(7)));
	s = xor(s, @math$shiftLeft(s, Int(17)));
	this.state = s;
	return s;
}


alias I32 = @primitives$I32;

Int over(a Int, b Int) => @operators$divide(a, b);
Bool below(a Int, b Int) => @operators$lessThan(a, b);

/// `r % k` with `r` read as unsigned, as C's `%` on a `uint64_t`, for `k`
/// below 2^62.
Int umod(r Int, k Int) {
	half Int = down(r, Int(1));
	a Int = minus(half, times(over(half, k), k));
	b Int = plus(times(a, Int(2)), @math$bitAnd(r, Int(1)));
	return minus(b, times(over(b, k), k));
}

type Node = struct {
	key Int;
	left I32;
	right I32;
}

Node(key Int, left I32, right I32) => init{ key; left; right; }

/// Places the keys `lo` to `hi` - 1 as a subtree, its root at the id
/// `ids` gives the middle one, and returns that id, 0 for none.
Int build(this ListRef<Node>, ids ListRef<Int>, lo Int, hi Int) mut {
	@controlflow$branch(@operators$not(below(lo, hi)), {
		return Int(0);
	});
	mid Int = down(plus(lo, hi), Int(1));
	id Int = ids[plus(mid, Int(1))];
	left Int = this!build(ids, lo, mid);
	right Int = this!build(ids, plus(mid, Int(1)), hi);
	this[id] = Node(plus(times(mid, Int(2)), Int(1)), I32.wrap(left), I32.wrap(right));
	return id;
}

/// The id of the node holding `key`, or 0. A loop that calls it writes it
/// out where it calls it (a walk, docs/design/lowering.md L11), so its
/// `return` leaves only the search, as a loop's `break` would.
Int find(nodes ListRef<Node>, root Int, key Int) {
	c Int = root;
	d Int(1);
	d!to(Int(64)) {
		@controlflow$branch(same(c, Int(0)), {
			return Int(0);
		});
		@controlflow$branch(same(nodes[c].key, key), {
			return c;
		});
		next Int = Int(nodes[c].right);
		@controlflow$branch(below(key, nodes[c].key), {
			next = Int(nodes[c].left);
		});
		c = next;
	}
	return Int(0);
}

Unit main() {
	logBytes Int = arg(Int(1), Int(25));
	passes Int = arg(Int(2), Int(1));
	logOps Int = arg(Int(3), Int(21));
	n Int = minus(@math$shiftLeft(Int(1), minus(logBytes, Int(4))), Int(1));
	m Int = @math$shiftLeft(Int(1), logOps);
	rng Rng = Rng(@operators$negate(Int(7046029254386353131)));
	// The ids 1 to n in an order picked at random, as the model's `churn`
	// at 100% leaves them.
	ids ListRef<Int> = @primitives$ListRef(Int);
	f Int(1);
	f!to(n) {
		ids!push(f);
		rng!next();
	}
	k Int = n;
	g Int(1);
	g!to(minus(n, Int(1))) {
		o Int = plus(umod(rng!next(), k), Int(1));
		t Int = ids[k];
		ids[k] = ids[o];
		ids[o] = t;
		k = minus(k, Int(1));
	}
	nodes ListRef<Node> = @primitives$ListRef(Node);
	z Int(1);
	z!to(n) {
		nodes!push(Node(Int(0), I32(0), I32(0)));
	}
	root Int = nodes!build(ids, Int(0), n);
	keys ListRef<Int> = @primitives$ListRef(Int);
	q Int(1);
	q!to(m) {
		keys!push(umod(rng!next(), times(n, Int(2))));
	}
	sum Int(0);
	say(String("ready"));
	p Int(1);
	p!to(passes) {
		i Int(1);
		i!to(m) {
			sum = plus(sum, find(nodes, root, keys[i]));
		}
	}
	say(String(sum));
	return Unit();
}
