/// The model's `hash`: lookups in an open-addressing table with linear
/// probing, half of them hits, the table half full. Arguments: log2 of the
/// data's bytes, how many passes to make (0 builds the data and stops) and
/// log2 of the operations in a pass. It prints `ready` once the data is
/// built and a checksum when the passes end, which tools/time.py times
/// between.
package hash;


alias Int = @primitives$I64;
alias Bool = @primitives$Bool;
alias Unit = @primitives$Unit;
alias String = @primitives$String;
alias ListRef<T Type> = @primitives$ListRef<T>;

/// Advances the counter through the inclusive range, running the block once
/// per step.
Unit to(this Int, end Int, body @concepts$Block) mut {
	@controlflow$repeat(@operators$add(@operators$add(end, @operators$negate(this)), Int(1)), {
		@controlflow$branch(true, body);
		this = @operators$add(this, Int(1));
	});
	return Unit();
}

/// The program's `at`th argument, or `fallback` when it has none or the
/// argument spells no integer.
Int arg(at Int, fallback Int) {
	args @primitives$List<String> = @program$runtime:arguments();
	@controlflow$branch(@operators$lessThan(args:size(), at), {
		return fallback;
	});
	return args[at]:parseI64() ?? fallback;
}

Unit say(text String) {
	@program$console!print(@operators$concat(text, String.escaped("\n")));
	return Unit();
}

Int plus(a Int, b Int) => @operators$add(a, b);
Int minus(a Int, b Int) => @operators$add(a, @operators$negate(b));
Int times(a Int, b Int) => @operators$multiply(a, b);
Int xor(a Int, b Int) => @math$bitXor(a, b);
Int down(a Int, by Int) => @math$shiftRightLogical(a, by);
Bool same(a Int, b Int) => @operators$equal(a, b);

/// xorshift64, as the model's `rnd`.
type Rng = #struct {
	state Int;
}

Rng(seed Int) => init{ state = seed; }

Int next(this Rng) mut {
	s Int = this.state;
	s = xor(s, @math$shiftLeft(s, Int(13)));
	s = xor(s, down(s, Int(7)));
	s = xor(s, @math$shiftLeft(s, Int(17)));
	this.state = s;
	return s;
}


/// The splitmix64 finalizer, as the model's `mix`.
Int mix(v Int) {
	x Int = v;
	x = xor(x, down(x, Int(30)));
	x = times(x, @operators$negate(Int(4658895280553007687)));
	x = xor(x, down(x, Int(27)));
	x = times(x, @operators$negate(Int(7723592293110705685)));
	x = xor(x, down(x, Int(31)));
	return x;
}

type Slot = struct {
	key Int;
	val Int;
}

Slot(key Int, val Int) => init{ key; val; }

/// The key's home slot, counted from 1: the high bits of its product with
/// the golden ratio.
Int home(key Int, shift Int) => plus(down(times(key, @operators$negate(Int(7046029254386353131))), shift), Int(1));

/// The value stored for `key`, or 0. A loop that calls it writes it out
/// where it calls it (a walk, docs/design/lowering.md L11), so its `return`
/// leaves only the probe, as a loop's `break` would.
Int probe(table ListRef<Slot>, key Int, shift Int, mask Int) {
	h Int = home(key, shift);
	d Int(1);
	d!to(table:size()) {
		@controlflow$branch(same(table[h].key, key), {
			return table[h].val;
		});
		@controlflow$branch(same(table[h].key, Int(0)), {
			return Int(0);
		});
		h = plus(@math$bitAnd(h, mask), Int(1));
	}
	return Int(0);
}

/// Stores `key` in the first empty slot from its home. A `mut` method is no
/// walk, so this stays a call; its `return` leaves it all the same.
Unit insert(this ListRef<Slot>, key Int, shift Int, mask Int) mut {
	h Int = home(key, shift);
	d Int(1);
	d!to(this:size()) {
		@controlflow$branch(same(this[h].key, Int(0)), {
			this[h] = Slot(key, xor(key, Int(85)));
			return Unit();
		});
		h = plus(@math$bitAnd(h, mask), Int(1));
	}
	return Unit();
}

Unit main() {
	logBytes Int = arg(Int(1), Int(25));
	passes Int = arg(Int(2), Int(1));
	logOps Int = arg(Int(3), Int(23));
	cap Int = @math$shiftLeft(Int(1), minus(logBytes, Int(4)));
	keys Int = down(cap, Int(1));
	shift Int = minus(Int(68), logBytes);
	mask Int = minus(cap, Int(1));
	m Int = @math$shiftLeft(Int(1), logOps);
	rng Rng = Rng(@operators$negate(Int(7046029254386353131)));
	table ListRef<Slot> = @primitives$ListRef(Slot);
	c Int(1);
	c!to(cap) {
		table!push(Slot(Int(0), Int(0)));
	}
	k Int(1);
	k!to(keys) {
		key Int = @math$bitOr(mix(k), Int(1));
		table!insert(key, shift, mask);
	}
	queries ListRef<Int> = @primitives$ListRef(Int);
	q Int(1);
	q!to(m) {
		r Int = rng!next();
		hit Bool = same(@math$bitAnd(r, Int(1)), Int(1));
		@controlflow$branch(hit, {
			queries!push(@math$bitOr(mix(plus(@math$bitAnd(r, minus(keys, Int(1))), Int(1))), Int(1)));
		});
		@controlflow$branch(@operators$not(hit), {
			queries!push(@math$bitOr(@math$bitAnd(mix(r), @operators$negate(Int(2))), Int(2)));
		});
	}
	sum Int(0);
	say(String("ready"));
	p Int(1);
	p!to(passes) {
		i Int(1);
		i!to(m) {
			sum = plus(sum, probe(table, queries[i], shift, mask));
		}
	}
	say(String(sum));
	return Unit();
}
