/// A call reading a local while a later spawned call mutates it: does the
/// checker accept it (concurrency.md §4.3, §4.4)?
package reader;

alias Int = @primitives$I64;
alias Bool = @primitives$Bool;
alias Unit = @primitives$Unit;
alias String = @primitives$String;

Unit to(this Int, end Int, body @concepts$Block) mut {
	@controlflow$repeat(@operators$add(@operators$add(end, @operators$negate(this)), Int(1)), {
		@controlflow$branch(true, body);
		this = @operators$add(this, Int(1));
	});
	return Unit();
}

type Countdown = variant {
	done Unit;
	more Countdown;
}

Int depth(c Countdown) => match (c) {
	d done => Int(0);
	m more => @operators$add(Int(1), depth(m));
}

Unit deepen(this Countdown, n Int) mut {
	i Int(1);
	i!to(n) {
		this = Countdown.more(this);
	}
	return Unit();
}

/// The size the program was started with: its first argument, or
/// `fallback` when it has none or the first spells no integer.
Int size(fallback Int) {
	args @primitives$List<String> = @program$runtime:arguments();
	@controlflow$branch(@operators$lessThan(args:size(), Int(1)), {
		return fallback;
	});
	return args[Int(1)]:parseI64() ?? fallback;
}

Unit check(ok Bool) {
	yes String.escaped("yes\n");
	no String.escaped("no\n");
	@controlflow$branch(ok, { @program$console!print(yes); });
	@controlflow$branch(@operators$not(ok), { @program$console!print(no); });
	return Unit();
}

Unit main() {
	n Int = size(Int(3000));
	a Countdown = Countdown.done(Unit());
	a!deepen(n);
	@controlflow$branch(true, {
		seen Int = spawn depth(a);
		spawn a!deepen(n);
		check(@operators$equal(seen, n));
	});
	check(@operators$equal(depth(a), @operators$multiply(n, Int(2))));
	return Unit();
}
