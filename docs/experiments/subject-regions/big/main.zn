/// A subject that owns many blocks, spawned on many times, each call doing
/// little: what a spawn costs when its subject is large. The depth is the
/// first argument, the rounds the second.
package big;

alias Int = @primitives$I64;
alias Bool = @primitives$Bool;
alias Unit = @primitives$Unit;
alias String = @primitives$String;

Unit to(this Int, end Int, body @concepts$Block) mut {
	@controlflow$repeat(@operators$add(@operators$add(end, @operators$negate(this)), Int(1)), {
		@controlflow$branch(true, body);
		this = @operators$add(this, Int(1));
	});
	return Unit();
}

type Countdown = variant {
	done Unit;
	more Countdown;
}

Int depth(c Countdown) => match (c) {
	d done => Int(0);
	m more => @operators$add(Int(1), depth(m));
}

Unit deepen(this Countdown, n Int) mut {
	i Int(1);
	i!to(n) {
		this = Countdown.more(this);
	}
	return Unit();
}

/// The size the program was started with: its first argument, or
/// `fallback` when it has none or the first spells no integer.
Int argument(at Int, fallback Int) {
	args @primitives$List<String> = @program$runtime:arguments();
	@controlflow$branch(@operators$lessThan(args:size(), at), {
		return fallback;
	});
	return args[at]:parseI64() ?? fallback;
}

Unit check(ok Bool) {
	yes String.escaped("yes\n");
	no String.escaped("no\n");
	@controlflow$branch(ok, { @program$console!print(yes); });
	@controlflow$branch(@operators$not(ok), { @program$console!print(no); });
	return Unit();
}

/// One spawned call on the subject, waited for before this returns.
Unit tick(this Countdown) mut {
	@controlflow$branch(true, {
		spawn this!deepen(Int(1));
	});
	return Unit();
}

Unit main() {
	deep Int = argument(Int(1), Int(10000));
	rounds Int = argument(Int(2), Int(200));
	a Countdown = Countdown.done(Unit());
	a!deepen(deep);
	round Int(1);
	round!to(rounds) {
		a!tick();
	}
	check(@operators$equal(depth(a), @operators$add(deep, rounds)));
	return Unit();
}
