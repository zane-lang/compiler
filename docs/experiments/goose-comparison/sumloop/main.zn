/// A loop whose body is one load and one add: a list of N `Int`s summed
/// 200000 times, the total written into its first element after each round
/// so that no round's sum is the one before it. N is the program's first
/// argument.
package sumloop;

import core$;
import bench$;

Unit main() {
	console Console(@program$console);
	runtime Runtime(@program$runtime);
	n Int = size(runtime, Int(2000));
	rounds Int = Int(200000);
	list List<Int> = List(Int);
	i Int = Int(1);
	i!to(n) {
		list!push(i);
	}
	total Int = Int(0);
	r Int = Int(1);
	r!to(rounds) {
		k Int = Int(1);
		k!to(list:size()) {
			total = total + list[k];
		}
		list[Int(1)] = total;
	}
	console!print(String(n) + " " + String(total));
	return Unit();
}
