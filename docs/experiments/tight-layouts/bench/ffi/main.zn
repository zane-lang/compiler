/// Structs crossing into C by value in a loop: one with no padding, which
/// every layout passes as it is; two with padding whose fields Zane
/// reorders, so every layout converts them at each crossing; and one in
/// C's order with tail padding, which only a packed layout converts.
package ffi;

alias Int = @primitives$I64;
alias I32 = @primitives$I32;
alias F32 = @primitives$F32;
alias F64 = @primitives$F64;
alias Unit = @primitives$Unit;
alias String = @primitives$String;

Int size(fallback Int) {
	args @primitives$List<String> = @program$runtime:arguments();
	@controlflow$branch(@operators$lessThan(args:size(), Int(2)), {
		return fallback;
	});
	return args[Int(2)]:parseI64() ?? fallback;
}

Int which() {
	args @primitives$List<String> = @program$runtime:arguments();
	@controlflow$branch(@operators$lessThan(args:size(), Int(1)), {
		return Int(0);
	});
	return args[Int(1)]:parseI64() ?? Int(0);
}

Unit say(text String) {
	@program$console!print(@operators$concat(text, String.escaped("\n")));
	return Unit();
}

type Vec3 = struct {
	x F64;
	y F64;
	z F64;
}

Vec3(x F64, y F64, z F64) => init{ x; y; z; }

type Tagged = struct {
	tag I32;
	n Int;
}

Tagged(tag I32, n Int) => init{ tag; n; }

type Nested = struct {
	first I32;
	inner Tagged;
	last F32;
}

Nested(first I32, inner Tagged, last F32) => init{ first; inner; last; }

type Ordered = struct {
	n Int;
	tag I32;
}

Ordered(n Int, tag I32) => init{ n; tag; }

Ordered ordStep(o Ordered) foreign "ord_step";
Vec3 vecStep(v Vec3) foreign "vec_step";
Tagged tagStep(t Tagged) foreign "tag_step";
Nested nestStep(n Nested) foreign "nest_step";

Unit main() {
	rounds Int = size(Int(1000000));
	shape Int = which();
	@controlflow$branch(@operators$equal(shape, Int(1)), {
		v Vec3(F64(0.0), F64(0.0), F64(0.0));
		@controlflow$repeat(rounds, {
			v = vecStep(v);
		});
		say(String(@operators$add(@operators$add(v.x, v.y), v.z)));
	});
	@controlflow$branch(@operators$equal(shape, Int(2)), {
		t Tagged(I32(0), Int(0));
		@controlflow$repeat(rounds, {
			t = tagStep(t);
		});
		say(String(t.n));
	});
	@controlflow$branch(@operators$equal(shape, Int(3)), {
		n Nested(I32(0), Tagged(I32(0), Int(0)), F32(1.0));
		@controlflow$repeat(rounds, {
			n = nestStep(n);
		});
		say(String(n.inner.n));
	});
	@controlflow$branch(@operators$equal(shape, Int(4)), {
		o Ordered(Int(0), I32(0));
		@controlflow$repeat(rounds, {
			o = ordStep(o);
		});
		say(String(o.n));
	});
	return Unit();
}
